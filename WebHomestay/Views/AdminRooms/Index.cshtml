@model IEnumerable<WebHomestay.Models.Room>

@{
    ViewData["Title"] = "Quản lý Phòng";
}

<link rel="stylesheet" href="~/css/admin-premium.css" asp-append-version="true" />

<div class="premium-admin-body">
    <div class="admin-shell">
        <header class="admin-hero">
            <div class="admin-hero-title">
                <span class="admin-kicker">Cơ sở lưu trú</span>
                <h1>Quản lý Danh sách Phòng</h1>
            </div>
            <div class="admin-hero-actions">
                @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "rooms.create"))
                {
                    <a asp-action="Create" class="btn-premium">
                        <i class="fas fa-plus"></i>
                        <span>Thêm phòng mới</span>
                    </a>
                }
            </div>
        </header>

        <!-- Filter Bar -->
        <div class="staff-filter-bar mb-3">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="filter-group">
                    <label class="filter-label">Chi nhánh</label>
                    <select class="form-select form-select-sm room-filter" id="filterBranch">
                        <option value="">Tất cả</option>
                        @foreach (var branch in ViewBag.Branches as List<WebHomestay.Models.Branch> ?? new())
                        {
                            <option value="@branch.Id">@branch.Name</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="admin-card">
            <div class="admin-table-responsive">
                <table class="admin-table staff-table" id="roomsTable">
                    <thead>
                        <tr>
                            <th>Ảnh</th>
                            <th class="sortable" data-sort="name">Thông tin phòng <i class="fas fa-sort"></i></th>
                            <th class="sortable" data-sort="branch">Chi nhánh <i class="fas fa-sort"></i></th>
                            <th class="sortable" data-sort="price_day">Đơn giá (Ngày/Giờ) <i class="fas fa-sort"></i></th>
                            <th class="sortable" data-sort="capacity">Sức chứa <i class="fas fa-sort"></i></th>
                            <th class="sortable" data-sort="status">Trạng thái <i class="fas fa-sort"></i></th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr data-name="@item.Name" data-branch="@item.BranchId" data-status="@item.Status" data-price-day="@item.PricePerDay" data-price-hour="@item.PricePerHour" data-capacity="@item.Capacity">
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name" class="admin-img-thumb" />
                                    }
                                    else
                                    {
                                        <div class="admin-img-thumb d-flex align-items-center justify-content-center text-muted">
                                            <i class="fas fa-image"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-primary">@item.Name</div>
                                    <div class="small text-muted">@item.Capacity - @item.MaxGuests khách</div>
                                </td>
                                <td>
                                    <span class="badge-premium badge-primary-soft">@item.Branch?.Name</span>
                                </td>
                                <td>
                                    <div class="small">Ngày: <strong class="text-primary">@item.PricePerDay.ToString("N0")đ</strong></div>
                                    <div class="small text-muted">Giờ: @item.PricePerHour.ToString("N0")đ</div>
                                </td>
                                <td>
                                    <div class="small">@item.Capacity người</div>
                                </td>
                                 <td>
                                     <div class="d-flex flex-column gap-2">
                                         @if (item.Status == "Available")
                                         {
                                             <span class="badge-premium badge-success-soft" style="width: fit-content;">Sẵn sàng</span>
                                         }
                                         else if (item.Status == "Occupied")
                                         {
                                             <span class="badge-premium badge-info-soft" style="width: fit-content;">Đang có khách</span>
                                         }
                                         else
                                         {
                                             <span class="badge-premium badge-warning-soft" style="width: fit-content;">Đang bảo trì</span>
                                         }

                                         @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "rooms.edit"))
                                         {
                                             <div class="form-check form-switch admin-switch-premium">
                                                 <input class="form-check-input" type="checkbox" role="switch" id="switch-@item.Id" 
                                                        @(item.Status != "Maintenance" ? "checked" : "")
                                                        onchange="toggleRoomActivity(@item.Id, this)">
                                                 <label class="form-check-label small fw-bold activity-label" for="switch-@item.Id" style="cursor: pointer; font-size: 0.7rem; color: #64748b;">
                                                     @(item.Status != "Maintenance" ? "ĐANG HOẠT ĐỘNG" : "TẠM NGƯNG")
                                                 </label>
                                             </div>
                                         }
                                     </div>
                                 </td>
                                <td class="text-end">
                                     <div class="admin-actions">
                                        <a asp-controller="AdminSlots" asp-action="RoomSchedules" asp-route-roomId="@item.Id" class="admin-btn-icon" title="Quản lý lịch trình">
                                            <i class="fas fa-clock"></i>
                                        </a>
                                        @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "rooms.edit"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="admin-btn-icon" title="Chỉnh sửa">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        }
                                        @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "rooms.delete"))
                                        {
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa phòng này?');">
                                                <button type="submit" class="admin-btn-icon is-danger border-0 bg-transparent" title="Xóa">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        }
                                     </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fas fa-bed fa-3x mb-3 opacity-20"></i>
                                        <p>Chưa có phòng nào được tạo.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterRoomTable() {
            var branch = document.getElementById('filterBranch').value;
            var rows = document.querySelectorAll('#roomsTable tbody tr');
            rows.forEach(function(r) {
                if (r.querySelectorAll('td').length < 7) return;
                r.style.display = (branch && r.dataset.branch !== branch) ? 'none' : '';
            });
        }

        document.getElementById('filterBranch').addEventListener('change', filterRoomTable);

        // Sort
        var roomsSortAsc = null, roomsSortField = null;
        document.querySelectorAll('#roomsTable .sortable').forEach(function(th) {
            th.addEventListener('click', function() {
                var field = this.dataset.sort;
                if (roomsSortField === field) { roomsSortAsc = !roomsSortAsc; }
                else { roomsSortField = field; roomsSortAsc = true; }
                document.querySelectorAll('#roomsTable .sortable i').forEach(function(i) { i.className = 'fas fa-sort'; });
                this.querySelector('i').className = roomsSortAsc ? 'fas fa-sort-up' : 'fas fa-sort-down';
                var tbody = document.querySelector('#roomsTable tbody');
                var rows = Array.from(tbody.querySelectorAll('tr')).filter(function(r) { return r.dataset.name !== undefined; });
                rows.sort(function(a, b) {
                    var order = roomsSortAsc ? 1 : -1, va, vb;
                    if (field === 'name') { va = (a.dataset.name || '').toLowerCase(); vb = (b.dataset.name || '').toLowerCase(); return va.localeCompare(vb) * order; }
                    if (field === 'branch') { va = parseInt(a.dataset.branch) || 0; vb = parseInt(b.dataset.branch) || 0; return (va - vb) * order; }
                    if (field === 'status') { va = a.dataset.status || ''; vb = b.dataset.status || ''; return va.localeCompare(vb) * order; }
                    if (field === 'price_day') { va = parseFloat(a.dataset.priceDay) || 0; vb = parseFloat(b.dataset.priceDay) || 0; return (va - vb) * order; }
                    if (field === 'price_hour') { va = parseFloat(a.dataset.priceHour) || 0; vb = parseFloat(b.dataset.priceHour) || 0; return (va - vb) * order; }
                    if (field === 'capacity') { va = parseInt(a.dataset.capacity) || 0; vb = parseInt(b.dataset.capacity) || 0; return (va - vb) * order; }
                    return 0;
                });
                rows.forEach(function(r) { tbody.appendChild(r); });
            });
        });
    </script>
    <script>
        function showLuxToast(message, type = 'success') {
            let container = document.querySelector('.lux-toast-container');
            if (!container) {
                container = document.createElement('div');
                container.className = 'lux-toast-container';
                document.body.appendChild(container);
            }
            
            const toast = document.createElement('div');
            toast.className = `lux-toast ${type === 'error' ? 'is-danger' : 'is-success'}`;
            toast.innerHTML = `
                <div class="lux-toast-accent"></div>
                <div class="lux-toast-content">${message}</div>
            `;
            
            container.appendChild(toast);
            
            setTimeout(() => {
                toast.classList.add('fade-out');
                setTimeout(() => toast.remove(), 500);
            }, 4000);
        }

        async function toggleRoomActivity(id, checkbox) {
            const label = checkbox.nextElementSibling;
            const originalChecked = !checkbox.checked;
            const originalText = label.innerText;
            
            // Tạm thời đổi text để tạo cảm giác mượt
            label.innerText = checkbox.checked ? "ĐANG HOẠT ĐỘNG" : "TẠM NGƯNG";

            try {
                const response = await fetch(`/admin/rooms/toggle-status/${id}`, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/x-www-form-urlencoded'
                    }
                });

                const result = await response.json();

                if (result.success) {
                    showLuxToast(result.message, 'success');
                    // Cập nhật Badge trạng thái (nếu có)
                    const badgeContainer = checkbox.closest('.d-flex').querySelector('.badge-premium');
                    if (badgeContainer) {
                        if (result.newStatus === 'Available') {
                            badgeContainer.className = 'badge-premium badge-success-soft';
                            badgeContainer.innerText = 'Sẵn sàng';
                        } else if (result.newStatus === 'Occupied') {
                            badgeContainer.className = 'badge-premium badge-info-soft';
                            badgeContainer.innerText = 'Đang có khách';
                        } else {
                            badgeContainer.className = 'badge-premium badge-warning-soft';
                            badgeContainer.innerText = 'Đang bảo trì';
                        }
                    }
                } else {
                    // Thất bại -> Revert lại checkbox và text
                    checkbox.checked = originalChecked;
                    label.innerText = originalText;
                    showLuxToast(result.message, 'error');
                }
            } catch (error) {
                checkbox.checked = originalChecked;
                label.innerText = originalText;
                showLuxToast('Lỗi kết nối máy chủ!', 'error');
            }
        }
    </script>
}
