<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Homestay Self Check-in</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/user-premium.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/premium-notify.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm premium-nav fixed-top">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index" style="font-family: var(--luxury-font-heading); letter-spacing: 0.1em; color: var(--luxury-primary);">
                    <i class="fas fa-thin fa-hotel me-2" style="color: var(--luxury-accent);"></i>CHI<span style="color: var(--luxury-accent);">NHAN</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (Context.Session.GetString("AdminUser") != null)
                        {
                            @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "matrix.view"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link-premium" asp-controller="AdminMatrix" asp-action="Index">
                                        <i class="fas fa-th me-1"></i>Ma trận vận hành
                                    </a>
                                </li>
                            }
                            @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "bookings.view"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link-premium" asp-controller="AdminBookings" asp-action="Index">
                                        <i class="fas fa-calendar-check me-1"></i>Đơn đặt phòng
                                    </a>
                                </li>
                            }
                            <li class="nav-item dropdown">
                                <a class="nav-link-premium dropdown-toggle-custom" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-cog me-1"></i>Hệ thống Quản trị <i class="fas fa-chevron-down nav-dropdown-arrow"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-0 p-3">
                                    @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "branches.view"))
                                    {
                                        <li><a class="dropdown-item py-2" asp-controller="AdminBranches" asp-action="Index"><i class="fas fa-store me-2 text-muted"></i>Quản lý Chi nhánh</a></li>
                                    }
                                    @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "rooms.view"))
                                    {
                                        <li><a class="dropdown-item py-2" asp-controller="AdminRooms" asp-action="Index"><i class="fas fa-door-open me-2 text-muted"></i>Quản lý Phòng</a></li>
                                    }
                                    @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "images.view"))
                                    {
                                        <li><a class="dropdown-item py-2" asp-controller="AdminImages" asp-action="Index"><i class="fas fa-images me-2 text-muted"></i>Kho ảnh Đơn hàng</a></li>
                                    }
                                    @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "statistics.view"))
                                    {
                                        <li><a class="dropdown-item py-2" asp-controller="AdminStatistics" asp-action="Index"><i class="fas fa-chart-bar me-2 text-muted"></i>Thống kê doanh thu</a></li>
                                    }
                                    @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "staff.view"))
                                    {
                                        <li><a class="dropdown-item py-2" asp-controller="AdminStaff" asp-action="Index"><i class="fas fa-user-shield me-2 text-muted"></i>Nhân sự & Bảo mật</a></li>
                                    }
                                    @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "ai.view"))
                                    {
                                        <li><a class="dropdown-item py-2" asp-controller="AdminAI" asp-action="Index"><i class="fas fa-brain me-2 text-muted"></i>Trung tâm Bộ não AI</a></li>
                                    }
                                    @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "chats.view"))
                                    {
                                        <li><a class="dropdown-item py-2" asp-controller="AdminChatMonitor" asp-action="Index"><i class="fas fa-comment-dots me-2 text-muted"></i>Giám sát Chat</a></li>
                                    }
                                    @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "settings.view"))
                                    {
                                        <li><a class="dropdown-item py-2" asp-controller="AdminSettings" asp-action="Index"><i class="fas fa-sliders-h me-2 text-muted"></i>Cấu hình hệ thống</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2 text-danger" asp-controller="AdminAccount" asp-action="Logout"><i class="fas fa-sign-out-alt me-2"></i>Thoát quản trị</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        @* Auth buttons removed as per request *@
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" style="margin-top: 70px;">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted mt-5 py-4">
        <div class="container text-center">
            &copy; 2026 - WebHomestay - Tự động hóa trải nghiệm lưu trú
        </div>
    </footer>

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
        var isHomePage = currentController.Equals("Home", StringComparison.OrdinalIgnoreCase)
            && currentAction.Equals("Index", StringComparison.OrdinalIgnoreCase);
        var showPublicChatbot = !currentController.StartsWith("Admin", StringComparison.OrdinalIgnoreCase);
    }
    @if (showPublicChatbot)
    {
        <div class="ai-widget" id="public-ai-chatbot">
            <div class="ai-zalo-popover" id="ai-zalo-popover" hidden>
                <div class="ai-zalo-popover-header">
                    <span>Liên hệ Zalo chi nhánh</span>
                    <button class="ai-zalo-close" type="button" aria-label="Đóng danh sách Zalo">
                        <i class="fas fa-xmark"></i>
                    </button>
                </div>
                <div class="ai-zalo-list" aria-live="polite">Đang tải danh sách chi nhánh...</div>
            </div>
            <button class="ai-zalo-toggle" type="button" aria-label="Mở danh sách Zalo chi nhánh" aria-expanded="false" aria-controls="ai-zalo-popover">
                <img src="~/img/zalo-logo.svg" alt="" aria-hidden="true" />
                <span>Zalo</span>
            </button>
            <button class="ai-chat-toggle" type="button" aria-label="Mở nhân viên tư vấn" aria-expanded="false">
                <span class="ai-chat-pulse"></span>
                <i class="fas fa-comments"></i>
            </button>
            <section class="ai-chat-panel" aria-label="Nhân viên tư vấn">
                <div class="ai-chat-header">
                    <div class="ai-chat-profile">
                        <div class="ai-avatar-container">
                            <img class="ai-avatar-img" src="/img/ai-avatar.png" alt="AI Avatar" />
                            <span class="online-pulse"></span>
                        </div>
                        <div>
                            <span class="ai-chat-kicker">CHINHAN</span>
                            <h3>Nhân viên tư vấn</h3>
                        </div>
                    </div>
                    <div style="display: flex; gap: 8px;">
                        <button id="ai-chat-clear" class="ai-chat-clear-btn" type="button" title="Làm mới cuộc trò chuyện" aria-label="Làm mới cuộc trò chuyện">
                            <i class="fas fa-arrows-rotate"></i>
                        </button>
                        <button class="ai-chat-close" type="button" aria-label="Đóng nhân viên tư vấn">
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>
                </div>
                <button class="ai-context-toggle" type="button" aria-expanded="false" aria-controls="ai-chat-context-form">
                    <span class="ai-context-toggle-copy">
                        <strong><i class="fas fa-hand-point-right finger-point-anim text-accent me-2"></i>Thông tin tư vấn</strong>
                        <small class="ai-context-toggle-hint">Tên, chi nhánh, ngày đặt, số khách</small>
                    </span>
                    <i class="fas fa-chevron-down ai-context-toggle-icon" aria-hidden="true"></i>
                </button>
                <div class="ai-chat-context is-collapsed" id="ai-chat-context-form" aria-label="Thông tin tư vấn ban đầu" hidden>
                    <label>
                        <span>Tên khách</span>
                        <input class="ai-context-name" type="text" maxlength="120" autocomplete="name" placeholder="Tên của bạn" />
                    </label>
                    <label>
                        <span>Chi nhánh</span>
                        <select class="ai-context-branch">
                            <option value="">Đang tải chi nhánh...</option>
                        </select>
                    </label>
                    <label>
                        <span>Hình thức</span>
                        <select class="ai-context-mode">
                            <option value="hourly">Theo giờ</option>
                            <option value="daily">Theo ngày</option>
                        </select>
                    </label>
                    <label>
                        <span>Số khách</span>
                        <input class="ai-context-guests" type="number" min="1" max="20" value="1" inputmode="numeric" />
                    </label>
                    <label>
                        <span>Ngày nhận</span>
                        <input class="ai-context-checkin" type="date" />
                    </label>
                    <label>
                        <span>Ngày trả</span>
                        <input class="ai-context-checkout" type="date" />
                    </label>
                </div>
                <div class="ai-chat-messages" role="log" aria-live="polite">
                    <div class="ai-message ai-message-bot">Chào bạn! Mình là trợ lý CHINHAN. Hãy click chọn nút <strong style="color: var(--luxury-accent);">"Thông tin tư vấn" <i class="fas fa-hand-point-up finger-point-up-anim"></i></strong> bên trên để nhập nhanh nhu cầu, hoặc chat trực tiếp với mình ở đây nhé! 👇</div>
                </div>
                <div class="ai-chat-status" aria-live="polite"></div>
                <div class="ai-chat-quick-actions-toggle-bar" id="ai-quick-actions-toggle-bar" style="background: #fff; text-align: right; padding: 6px 14px 4px; border-top: 1px solid var(--luxury-border); font-size: 0.75rem; cursor: pointer; color: var(--luxury-text-muted); display: flex; align-items: center; justify-content: space-between; user-select: none;">
                    <span style="font-weight: 700; font-size: 0.7rem; letter-spacing: 0.05em; text-transform: uppercase;">Phím tắt tư vấn</span>
                    <i class="fas fa-chevron-up" id="ai-quick-actions-toggle-icon" style="transition: transform 0.3s ease;"></i>
                </div>
                <div class="ai-chat-quick-actions" aria-label="Thao tác tư vấn nhanh" id="ai-quick-actions-container">
                    <button type="button" class="ai-action-btn ai-action-primary" id="ai-booking-consult-action">Bắt đầu tìm phòng</button>
                    <button type="button" class="ai-action-btn ai-action-secondary ai-cancel-booking-action" id="ai-cancel-booking-action">Yêu cầu hủy phòng</button>
                </div>
                <form class="ai-chat-form">
                    <input class="ai-chat-input" type="text" maxlength="500" autocomplete="off" aria-label="Nhập nhu cầu tư vấn cho nhân viên" placeholder="Nhập nhu cầu của bạn..." />
                    <button class="ai-chat-send" type="submit" aria-label="Gửi tin nhắn">
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </form>
                <p class="ai-chat-note">Nhân viên kiểm tra phòng trống theo dữ liệu thật và có thể tạo booking chờ thanh toán.</p>
            </section>
        </div>
    }



    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/premium-notify.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
