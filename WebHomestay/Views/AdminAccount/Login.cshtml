@{
    Layout = null; // Clean page without main navbar
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login - STAYEASY</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --lux-bg: #f8fafc;
            --lux-primary: #1e293b;
            --lux-accent: #c29b61;
        }
        body {
            background-color: var(--lux-bg);
            color: var(--lux-primary);
            font-family: 'Lexend', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
        }
        .login-card {
            background: white;
            border-radius: 0px;
            padding: 50px;
            width: 100%;
            max-width: 450px;
            box-shadow: 0 40px 100px rgba(0, 0, 0, 0.05);
            border: 1px solid #e2e8f0;
        }
        .btn-luxury {
            background: var(--lux-primary);
            color: white;
            border: none;
            padding: 14px;
            border-radius: 0px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            font-size: 0.8rem;
            transition: all 0.3s;
        }
        .btn-luxury:hover {
            background: #000;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
        .form-control {
            background: #fdfdfd;
            border: 1px solid #e2e8f0;
            color: var(--lux-primary);
            padding: 14px;
            border-radius: 0;
        }
        .form-control:focus {
            background: white;
            border-color: var(--lux-accent);
            box-shadow: none;
        }
        .luxury-kicker {
            text-transform: uppercase;
            letter-spacing: 0.3em;
            font-size: 0.7rem;
            font-weight: 700;
            color: var(--lux-accent);
            display: block;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center mb-5">
            <span class="luxury-kicker">Quản trị hệ thống</span>
            <h2 class="fw-bold" style="letter-spacing: 0.1em;">STAY<span style="color: var(--lux-accent);">LUXE</span></h2>
            <p class="text-muted small mt-2">Dành cho nhân sự vận hành</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger small py-2">@ViewBag.Error</div>
        }

        <form method="post" action="/admin/login">
            <div class="mb-3">
                <label class="form-label small fw-bold text-uppercase" style="letter-spacing: 0.1em;">Định danh</label>
                <input type="text" name="username" class="form-control" placeholder="Tên đăng nhập..." required />
            </div>
            <div class="mb-5">
                <label class="form-label small fw-bold text-uppercase" style="letter-spacing: 0.1em;">Mật mã</label>
                <input type="password" name="password" class="form-control" placeholder="••••••••" required />
            </div>
            <button type="submit" class="btn-luxury w-100 mb-4">XÁC THỰC TRUY CẬP</button>
            <div class="text-center">
                <a href="/" class="text-muted small text-decoration-none" style="letter-spacing: 0.05em;"><i class="fas fa-chevron-left me-2"></i> Trở về trang chủ</a>
            </div>
        </form>
    </div>
</body>
</html>
