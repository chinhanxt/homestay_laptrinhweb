</style>

@section Scripts {
    <script>
        (() => {
            const roomPayload = @Html.Raw(matrixPayloadJson);
            const rooms = new Map(roomPayload.map(room => [room.roomId, room]));
            const searchInput = document.getElementById('matrix-search');
            const filterSelect = document.getElementById('matrix-filter');
            const page = document.querySelector('.admin-matrix-page');
            const roomRows = Array.from(document.querySelectorAll('[data-room-row]'));
            const branchBlocks = Array.from(document.querySelectorAll('[data-branch-block]'));
            const emptyState = document.getElementById('matrix-empty-state');
            const drawer = document.getElementById('matrix-drawer');
            const scrim = document.getElementById('matrix-scrim');
            const drawerClose = document.getElementById('drawer-close');
            const drawerRoomName = document.getElementById('drawer-room-name');
            const drawerRoomMeta = document.getElementById('drawer-room-meta');
            const drawerStats = document.getElementById('drawer-stats');
            const drawerTimelineTitle = document.getElementById('drawer-timeline-title');
            const drawerTimelineBadge = document.getElementById('drawer-timeline-badge');
            const drawerBookings = document.getElementById('drawer-bookings');
            const bookingDetailsTemplate = '@bookingDetailsTemplate';
            const bookingIndexUrl = '@bookingIndexUrl';
            const escapeHtml = value => String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');

            const statusToneClass = status => {
                switch (status) {
                    case 'Confirmed':
                        return 'tone-confirmed';
                    case 'AwaitingApproval':
                        return 'tone-attention';
                    case 'AwaitingPayment':
                    case 'PendingPayment':
                        return 'tone-pending';
                    case 'CheckedIn':
                        return 'tone-inhouse';
                    default:
                        return 'tone-neutral';
                }
            };

            const formatMoney = value => new Intl.NumberFormat('vi-VN').format(value ?? 0) + 'đ';

            const formatDateTime = value => new Intl.DateTimeFormat('vi-VN', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            }).format(new Date(value));

            const formatDateOnly = value => new Intl.DateTimeFormat('vi-VN', {
                weekday: 'long',
                day: '2-digit',
                month: '2-digit',
                year: 'numeric'
            }).format(new Date(value));

            const roomStatusLabel = status => {
                switch (status) {
                    case 'Maintenance':
                        return 'Bảo trì';
                    case 'Occupied':
                        return 'Đang có khách';
                    default:
                        return 'Sẵn sàng';
                }
            };

            const getBookingsForDate = (room, dateKey) => {
                return room.bookings
                    .filter(booking => {
                        const startDate = booking.startTime.slice(0, 10);
                        const endDate = booking.endTime.slice(0, 10);

                        if (booking.bookingMode === 'Hourly') {
                            return startDate === dateKey;
                        }

                        return dateKey >= startDate && dateKey < endDate;
                    })
                    .sort((left, right) => left.startTime.localeCompare(right.startTime));
            };

            const firstFutureBooking = bookings => {
                const now = new Date();
                return bookings.find(booking => new Date(booking.startTime) >= now) ?? null;
            };

            const bookingCardHtml = booking => {
                const tone = statusToneClass(booking.status);
                const detailsUrl = bookingDetailsTemplate.replace('__id__', booking.id);
                const modeText = booking.bookingMode === 'Hourly'
                    ? (booking.slotLabel || 'Theo giờ')
                    : 'Theo ngày';
                const noteHtml = booking.note
                    ? `<div class="drawer-booking-note">${escapeHtml(booking.note)}</div>`
                    : '';

                return `
                    <article class="drawer-booking-card">
                        <div class="drawer-booking-top">
                            <div>
                                <div class="drawer-booking-name">${escapeHtml(booking.customerName)}</div>
                                <div class="drawer-booking-meta">
                                    <span>${escapeHtml(modeText)}</span>
                                    <span>${booking.guestCount} khách</span>
                                </div>
                            </div>
                            <span class="legend-pill ${tone}">${escapeHtml(booking.status)}</span>
                        </div>
                        <div class="drawer-booking-meta">
                            <span>${formatDateTime(booking.startTime)}</span>
                            <span>${formatDateTime(booking.endTime)}</span>
                        </div>
                        <div class="drawer-booking-meta">
                            <span>${escapeHtml(booking.customerPhone)}</span>
                            <span>${escapeHtml(booking.customerEmail || 'Chưa có email')}</span>
                        </div>
                        ${noteHtml}
                        <div class="drawer-booking-actions">
                            <a class="primary" href="${detailsUrl}">
                                <i class="fas fa-arrow-right"></i>
                                <span>Xem booking</span>
                            </a>
                            <a class="secondary" href="${bookingIndexUrl}">
                                <i class="fas fa-list"></i>
                                <span>Tới danh sách đơn</span>
                            </a>
                        </div>
                        <div class="drawer-booking-meta">
                            <span>Tạm tính</span>
                            <span>${formatMoney(booking.totalPrice)}</span>
                        </div>
                    </article>
                `;
            };

            const setDrawerStats = room => {
                const nextBooking = firstFutureBooking(room.bookings);
                drawerStats.innerHTML = `
                    <article class="drawer-stat-card">
                        <span>Trạng thái phòng</span>
                        <strong>${roomStatusLabel(room.roomStatus)}</strong>
                    </article>
                    <article class="drawer-stat-card">
                        <span>Số booking trong kỳ</span>
                        <strong>${room.bookings.length}</strong>
                    </article>
                    <article class="drawer-stat-card">
                        <span>Sức chứa</span>
                        <strong>${room.capacity}/${room.maxGuests}</strong>
                    </article>
                `;

                if (nextBooking) {
                    drawerRoomMeta.textContent = `${room.branchName} · Lịch tới gần nhất: ${formatDateTime(nextBooking.startTime)}`;
                } else {
                    drawerRoomMeta.textContent = `${room.branchName} · Chưa có lịch tiếp theo trong khoảng đang xem`;
                }
            };

            const openDrawer = (roomId, dateKey = null, dateLabel = null) => {
                const room = rooms.get(roomId);
                if (!room) {
                    return;
                }

                const bookings = dateKey ? getBookingsForDate(room, dateKey) : room.bookings;
                drawerRoomName.textContent = room.roomName;
                setDrawerStats(room);

                drawerTimelineTitle.textContent = dateKey
                    ? `Timeline của ${dateLabel ?? dateKey}`
                    : 'Timeline theo phòng trong khoảng đang xem';
                drawerTimelineBadge.textContent = `${bookings.length} lịch`;

                if (bookings.length === 0) {
                    drawerBookings.innerHTML = `
                        <div class="drawer-empty-state">
                            <i class="fas fa-moon"></i>
                            <strong>Ô này đang trống</strong>
                            <span>${dateKey ? `Không có booking nào phủ ngày ${dateLabel ?? dateKey}.` : 'Phòng này chưa có booking nào trong khoảng ngày hiện tại.'}</span>
                        </div>
                    `;
                } else {
                    drawerBookings.innerHTML = bookings.map(bookingCardHtml).join('');
                }

                drawer.setAttribute('aria-hidden', 'false');
                drawer.classList.add('is-open');
                scrim.classList.add('is-visible');
            };

            const closeDrawer = () => {
                drawer.setAttribute('aria-hidden', 'true');
                drawer.classList.remove('is-open');
                scrim.classList.remove('is-visible');
            };

            const applyFilters = () => {
                const searchValue = (searchInput?.value || '').trim().toLowerCase();
                const filterValue = filterSelect?.value || 'all';
                let visibleRoomCount = 0;

                roomRows.forEach(row => {
                    const search = row.dataset.search || '';
                    const matchesSearch = !searchValue || search.includes(searchValue);

                    let matchesFilter = true;
                    if (filterValue === 'occupied') {
                        matchesFilter = row.dataset.occupied === 'true';
                    } else if (filterValue === 'attention') {
                        matchesFilter = row.dataset.attention === 'true';
                    } else if (filterValue === 'vacant') {
                        matchesFilter = row.dataset.vacant === 'true';
                    }

                    const visible = matchesSearch && matchesFilter;
                    row.classList.toggle('d-none', !visible);
                    if (visible) {
                        visibleRoomCount += 1;
                    }
                });

                branchBlocks.forEach(block => {
                    const visibleRows = block.querySelectorAll('[data-room-row]:not(.d-none)');
                    block.classList.toggle('d-none', visibleRows.length === 0);
                });

                emptyState.classList.toggle('d-none', visibleRoomCount !== 0);
            };

            document.querySelectorAll('[data-room-cell]').forEach(button => {
                button.addEventListener('click', () => {
                    openDrawer(
                        Number(button.dataset.roomId),
                        button.dataset.date,
                        button.dataset.dateLabel
                    );
                });
            });

            document.querySelectorAll('[data-room-trigger]').forEach(button => {
                button.addEventListener('click', () => {
                    openDrawer(Number(button.dataset.roomId));
                });
            });


            searchInput?.addEventListener('input', applyFilters);
            filterSelect?.addEventListener('change', applyFilters);
            drawerClose?.addEventListener('click', closeDrawer);
            scrim?.addEventListener('click', closeDrawer);
            document.addEventListener('keydown', event => {
                if (event.key === 'Escape') {
                    closeDrawer();
                }
            });

            applyFilters();
        })();
    </script>
}
