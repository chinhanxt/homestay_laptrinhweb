@model IEnumerable<WebHomestay.Models.AdminUser>
@{
    ViewData["Title"] = "Quản lý Nhân sự";
}

<link rel="stylesheet" href="~/css/admin-premium.css" asp-append-version="true" />

<div class="premium-admin-body">
    <div class="admin-shell">
        <header class="admin-hero">
            <div class="admin-hero-title">
                <span class="admin-kicker">Đội ngũ vận hành</span>
                <h1>Nhân sự hệ thống</h1>
            </div>
            <div class="admin-hero-actions">
                <a asp-action="Logs" class="btn-premium-outline me-2">
                    <i class="fas fa-history"></i>
                    <span>Lịch sử hoạt động</span>
                </a>
                <a asp-action="Create" class="btn-premium">
                    <i class="fas fa-plus"></i>
                    <span>Thêm nhân sự</span>
                </a>
            </div>
        </header>

        <div class="staff-grid">
            @foreach (var item in Model)
            {
                <div class="staff-card">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 54px; height: 54px; flex-shrink: 0;">
                            <i class="fas fa-user-tie fs-4"></i>
                        </div>
                        <div class="overflow-hidden">
                            <h5 class="fw-bold mb-1 text-truncate">@item.FullName</h5>
                            <span class="badge-premium @(item.Role == WebHomestay.Models.AdminRole.SuperAdmin ? "badge-danger-soft" : "badge-info-soft")" style="font-size: 0.65rem;">
                                @item.Role
                            </span>
                        </div>
                    </div>
                    
                    <div class="admin-details py-2 border-top border-bottom border-light-subtle my-1">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="small text-muted">Username</span>
                            <span class="small fw-bold">@item.Username</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="small text-muted">Chi nhánh</span>
                            <span class="small fw-bold">@(item.Branch?.Name ?? "Toàn hệ thống")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="small text-muted">Ngày tham gia</span>
                            <span class="small fw-bold">@item.CreatedAt.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-auto pt-2">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-premium-outline flex-grow-1 justify-content-center py-2" style="font-size: 0.75rem;">
                            <i class="fas fa-edit"></i> Chỉnh sửa
                        </a>
                        <a asp-action="Permissions" asp-route-id="@item.Id" class="admin-btn-icon bg-light" title="Phân quyền">
                            <i class="fas fa-key"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Xóa nhân viên này?')">
                            <button type="submit" class="admin-btn-icon is-danger border-0 bg-transparent">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="col-12 text-center py-5">
                    <div class="text-muted">
                        <i class="fas fa-users-slash fa-3x mb-3 opacity-20"></i>
                        <p>Chưa có nhân sự nào được đăng ký.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
