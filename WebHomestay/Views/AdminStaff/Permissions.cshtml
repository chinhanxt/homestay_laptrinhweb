@model WebHomestay.Models.AdminUser
@{
    ViewData["Title"] = "Phân quyền chi tiết";
    var currentPerms = Model.Permissions ?? new Dictionary<string, bool>();
    
    var modules = new[] { 
        new { Id = "matrix", Name = "Ma trận vận hành", Icon = "fa-th" },
        new { Id = "branches", Name = "Chi nhánh", Icon = "fa-building" },
        new { Id = "rooms", Name = "Phòng", Icon = "fa-door-open" },
        new { Id = "bookings", Name = "Đơn đặt phòng", Icon = "fa-calendar-check" },
        new { Id = "staff", Name = "Nhân sự", Icon = "fa-users-cog" },
        new { Id = "logs", Name = "Nhật ký hệ thống", Icon = "fa-history" }
    };

    var actions = new[] { 
        new { Id = "view", Name = "Xem", Color = "info" },
        new { Id = "create", Name = "Thêm", Color = "success" },
        new { Id = "edit", Name = "Sửa", Color = "warning" },
        new { Id = "delete", Name = "Xóa", Color = "danger" }
    };
}

<link rel="stylesheet" href="~/css/admin-premium.css" asp-append-version="true" />

<div class="premium-admin-body">
    <div class="admin-shell">
        <header class="admin-hero">
            <div class="admin-hero-title">
                <span class="admin-kicker">Quản trị bảo mật</span>
                <h1>Phân quyền chi tiết</h1>
                <p class="text-muted small mt-1">Cấu hình quyền truy cập cho: <strong>@Model.FullName (@@@Model.Username)</strong></p>
            </div>
            <div class="admin-hero-actions">
                <a asp-action="Index" class="btn-premium-outline">
                    <i class="fas fa-arrow-left"></i>
                    <span>Quay lại</span>
                </a>
            </div>
        </header>

        <form asp-action="Permissions" method="post">
            <!-- Chi nhánh công tác Selection -->
            <div class="admin-card mb-4 p-4">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <h5 class="fw-bold text-primary mb-2"><i class="fas fa-map-marker-alt me-2"></i>Chi nhánh công tác</h5>
                        <p class="text-muted small mb-md-0">Nhân viên sẽ chỉ nhìn thấy dữ liệu (Ma trận, Đơn hàng, Phòng) thuộc chi nhánh này.</p>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <select name="branchId" class="form-select border-0 bg-light rounded-pill px-4 py-3 fw-bold">
                                <option value="">-- Tất cả chi nhánh (Chỉ dành cho SuperAdmin) --</option>
                                @foreach (var branch in (List<WebHomestay.Models.Branch>)ViewBag.Branches)
                                {
                                    <option value="@branch.Id" selected="@(Model.BranchId == branch.Id)">@branch.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="admin-card">
                <div class="admin-table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th class="ps-4" style="width: 300px;">Tính năng / Module</th>
                                @foreach (var action in actions)
                                {
                                    <th class="text-center">@action.Name</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var module in modules)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary-soft text-primary rounded d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px;">
                                                <i class="fas @module.Icon"></i>
                                            </div>
                                            <span class="fw-bold">@module.Name</span>
                                        </div>
                                    </td>
                                    @foreach (var action in actions)
                                    {
                                        var permKey = $"{module.Id}.{action.Id}";
                                        var isChecked = Model.Role == WebHomestay.Models.AdminRole.SuperAdmin || (currentPerms.ContainsKey(permKey) && currentPerms[permKey]);
                                        
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center">
                                                <div class="custom-control custom-checkbox">
                                                    <input type="checkbox" 
                                                           name="selectedPermissions" value="@permKey" 
                                                           @(isChecked ? "checked" : "")
                                                           @(Model.Role == WebHomestay.Models.AdminRole.SuperAdmin ? "disabled" : "")
                                                           class="permission-check form-check-input"
                                                           style="width: 20px; height: 20px; cursor: pointer;">
                                                </div>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (Model.Role == WebHomestay.Models.AdminRole.SuperAdmin)
            {
                <div class="mt-4 p-4 rounded-4 bg-light border text-center">
                    <i class="fas fa-shield-virus fs-3 text-primary mb-2 d-block"></i>
                    <p class="mb-0 text-muted">
                        Tài khoản <strong class="text-primary">SuperAdmin</strong> mặc định có toàn quyền và không cần cấu hình thủ công.
                    </p>
                </div>
            }
            else
            {
                <div class="mt-5 d-flex gap-3 justify-content-center align-items-center">
                    <button type="submit" class="btn-premium px-5 py-2 fw-bold shadow-sm">
                        <i class="fas fa-save"></i>
                        <span>LƯU THIẾT LẬP QUYỀN</span>
                    </button>
                    <div class="btn-group border rounded-pill overflow-hidden bg-white shadow-sm">
                        <button type="button" class="btn btn-sm btn-light px-3 py-2 fw-bold" onclick="toggleAll(true)" style="font-size: 0.75rem;">BẬT TẤT CẢ</button>
                        <button type="button" class="btn btn-sm btn-light px-3 py-2 fw-bold border-start" onclick="toggleAll(false)" style="font-size: 0.75rem;">TẮT TẤT CẢ</button>
                    </div>
                </div>
            }
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        function toggleAll(checked) {
            $('.permission-check').prop('checked', checked);
        }
    </script>
}
