<!-- Modal: THÊM MẪU KHUNG GIỜ -->
<div class="modal fade" id="createTemplateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content premium-modal">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <div>
                    <h5 class="modal-title fw-bold mb-1">Tạo Mẫu khung giờ</h5>
                    <p class="small text-muted mb-0">Định nghĩa khung thời gian cho phiên đặt phòng</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/AdminSlots/CreateTemplate" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body px-4 py-4">

                    <!-- Row: Name + Code -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <div class="form-field-card">
                                <label class="admin-form-label"><i class="fas fa-tag me-1" style="opacity:0.5"></i> Tên hiển thị</label>
                                <div style="display:flex;align-items:center">
                                    <input name="Name" class="admin-form-input" placeholder="VD: Combo 4h Trưa" required />
                                    <span class="input-cursor"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-field-card">
                                <label class="admin-form-label"><i class="fas fa-hashtag me-1" style="opacity:0.5"></i> Mã định danh</label>
                                <div style="display:flex;align-items:center">
                                    <input name="Code" class="admin-form-input" placeholder="VD: 4H_NOON" required />
                                    <span class="input-cursor"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Duration Hub -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <div class="form-field-card">
                                <label class="admin-form-label"><i class="fas fa-clock me-1" style="opacity:0.5"></i> Thời lượng mỗi phiên</label>
                                <div class="duration-hub">
                                    <div class="duration-input-area">
                                        <input name="DurationHours" id="create-duration-hours" type="number" class="admin-form-input" value="2" min="0.5" step="0.5" required />
                                        <span class="duration-unit">giờ</span>
                                    </div>
                                    <span class="duration-equals">→</span>
                                    <div class="minutes-badge">
                                        <i class="far fa-clock"></i>
                                        <span class="minutes-value" id="durationPreview">120</span>
                                        <span>phút</span>
                                    </div>
                                </div>
                                <input name="DurationMinutes" type="hidden" id="durationMinutesHidden" value="120" />
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-field-card">
                                <label class="admin-form-label"><i class="fas fa-broom me-1" style="opacity:0.5"></i> Dọn dẹp</label>
                                <div class="duration-hub">
                                    <div class="duration-input-area" style="flex:0 1 auto;">
                                        <input name="CleanupMinutes" type="number" class="admin-form-input" value="30" min="0" step="5" required style="font-size:1.2rem !important;width:60px" />
                                        <span class="duration-unit" style="font-size:0.85rem">phút</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Seed Start Time -->
                    <div class="row g-3 mb-3">
                        <div class="col-12">
                            <div class="form-field-card">
                                <label class="admin-form-label"><i class="fas fa-play-circle me-1" style="opacity:0.5"></i> Thời điểm bắt đầu nhảy slot</label>
                                <div class="time-pick-group">
                                    <input name="SeedStartTime" type="time" class="admin-form-input" value="09:00" style="width:160px" />
                                    <span class="time-hint"><i class="far fa-lightbulb me-1"></i> Slot đầu tiên trong ngày sẽ bắt đầu từ mốc này</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Active Toggle -->
                    <div class="template-toggle-card">
                        <div class="toggle-label">
                            <i class="fas fa-power-off"></i>
                            <span>Kích hoạt mẫu ngay sau khi tạo</span>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input name="IsActive" class="form-check-input" type="checkbox" role="switch" value="true" checked id="create-is-active" />
                        </div>
                    </div>

                </div>
                <div class="modal-footer border-0 px-4 pb-4 pt-2">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal" style="padding:10px 24px;font-weight:600">Hủy</button>
                    <button type="submit" class="btn-premium rounded-pill px-4" style="padding:10px 28px;font-size:0.9rem">
                        <i class="fas fa-check-circle me-1"></i> Lưu mẫu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

