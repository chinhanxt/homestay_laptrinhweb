                                                                                 <span class="input-group-text bg-light border-end-0 rounded-start-3"><i class="fas fa-heading text-muted"></i></span>
                                                                                 <input type="text" id="approval-email-subject" name="approvalEmailSubject" value="@cancellationApprovalEmailSubject" class="form-control-premium border-start-0 ps-2" placeholder="Nhập tiêu đề email..." required />
                                                                             </div>
                                                                         </div>
                                                                         
                                                                         <div class="mb-2">
