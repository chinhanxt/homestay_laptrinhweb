                        <div class="col-md-5">
                            <div class="form-field-card">
                                <label class="admin-form-label"><i class="fas fa-broom me-1" style="opacity:0.5"></i> Dọn dẹp</label>
                                <div class="duration-input-wrapper">
                                    <input name="CleanupMinutes" id="edit-cleanup" type="number" class="duration-large-input" min="0" step="5" required style="width:70px !important" />
                                    <span class="duration-unit">phút</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Seed Start Time -->
                    <div class="row g-3 mb-3">
                        <div class="col-12">
                            <div class="form-field-card">
                                <label class="admin-form-label"><i class="fas fa-play-circle me-1" style="opacity:0.5"></i> Thời điểm bắt đầu nhảy slot</label>
