                                                                             <div class="email-preview-meta-row mt-1">
                                                                                 <span class="email-preview-meta-label">Tiêu đề:</span>
                                                                                 <span id="preview-rejection-subject" class="email-preview-meta-val fw-bold text-dark"></span>
                                                                             </div>
                                                                         </div>
                                                                         <div id="preview-rejection-body" class="email-preview-body-container">
                                                                             <!-- Render dynamic content via JS -->
                                                                         </div>
                                                                     </div>
                                                                 </div>
                                                             </div>
                                                         </div>
                                                     </div>
                                                 </div>
                                             </div>
                                         </div>
                                     </div>
                                </div>

                                <button type="submit" class="btn-config-lux mt-4">Lưu chính sách hủy</button>
                            </form>
                        </div>
                    </div>

                    <div class="bento-item full-width">
                        <div class="bento-inner">
                            <h5 class="bento-title"><i class="fas fa-trash-restore me-2 text-warning"></i>Dọn dẹp Thùng rác Đơn hàng</h5>
                            <p class="text-muted small mb-4">Cấu hình số ngày tối đa đơn hàng bị xóa mềm được lưu trong thùng rác trước khi hệ thống tự động xóa vĩnh viễn.</p>
                            <form asp-action="Update" method="post">
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-muted">Số ngày giữ lại</label>
                                        <div class="input-group-premium">
                                            <i class="fas fa-calendar-alt text-muted"></i>
                                            <input type="number" name="value" value="@trashRetentionDays" min="1" max="365" class="form-control-premium" />
                                            <span class="suffix">ngày</span>
                                        </div>
                                    </div>
                                    <div class="col-md-8 d-flex align-items-end">
                                        <input type="hidden" name="key" value="BookingTrashRetentionDays" />
                                        <button type="submit" class="btn-config-lux">
                                            <i class="fas fa-check me-2"></i> Lưu cấu hình
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PANEL: THỜI GIAN & KHUNG GIỜ -->
            <div class="tab-pane fade" id="panel-time" role="tabpanel">
                <div class="panel-header d-flex justify-content-between align-items-end">
                    <div>
                        <h2>Thời gian & Khung giờ</h2>
                        <p>Thiết lập các mẫu khung giờ cố định và quy tắc thời gian đặt phòng.</p>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "rooms.create"))
                        {
                            <button type="button" class="btn-premium btn-sm rounded-pill px-4 mb-2" data-bs-toggle="modal" data-bs-target="#createTemplateModal">
                                <i class="fas fa-plus me-2"></i> Thêm mẫu mới
                            </button>
                            <button type="button" class="btn-premium-outline btn-sm rounded-pill px-3 mb-2" data-bs-toggle="modal" data-bs-target="#importSlotsModal">
                                <i class="fas fa-file-import me-2"></i> Import Excel
                            </button>
                        }
                        @if (trashedTemplates.Any())
                        {
                            <button type="button" class="btn-premium-outline btn-sm rounded-pill px-3 mb-2 trash-toggle-btn" data-panel="time" onclick="toggleTrashPanel('time')">
                                <i class="fas fa-trash-alt me-1"></i> <span>Thùng rác</span> <span class="badge bg-danger ms-1">@trashedTemplates.Count</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="trash-retention-info settings-trash-info d-none" id="trash-info-time">
                    <i class="fas fa-info-circle me-1"></i>
                    Các mẫu khung giờ trong này sẽ tự động bị xóa vĩnh viễn sau @trashRetentionDays ngày.
                </div>

                <div class="settings-bento-grid">
                    <!-- Active templates -->
                    <div class="bento-item full-width" id="active-templates-section">
                        <div class="bento-inner p-0">
                            <div class="admin-table-responsive">
                                <table class="admin-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Mẫu khung giờ</th>
                                            <th>Mã</th>
                                            <th>Thời lượng</th>
                                            <th>Dọn dẹp</th>
                                            <th>Trạng thái</th>
                                            <th class="text-end">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var t in templates)
                                        {
                                            <tr>
                                                <td><span class="fw-bold text-primary">@t.Name</span></td>
                                                <td><code>@t.Code</code></td>
                                                <td>@t.DurationMinutes phút</td>
                                                <td>@t.CleanupMinutes phút</td>
                                                <td>
                                                    <span class="badge-premium @(t.IsActive ? "badge-success-soft" : "badge-secondary-soft")">
                                                        @(t.IsActive ? "Kích hoạt" : "Tạm ngưng")
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <div class="admin-actions">
                                                        <button type="button" class="admin-btn-icon" 
                                                                onclick="openEditTemplateModal(@t.Id, '@t.Name', '@t.Code', @t.DurationMinutes, @t.CleanupMinutes, '@t.SeedStartTime', @(t.IsActive.ToString().ToLower()))">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <form asp-controller="AdminSlots" asp-action="DeleteTemplate" method="post" class="d-inline" data-premium-confirm="Bạn có chắc chắn muốn xóa mẫu khung giờ '@t.Name' này không?" data-premium-title="Xóa mẫu khung giờ" data-premium-ok="Xóa" data-premium-danger="true">
                                                            <input type="hidden" name="id" value="@t.Id" />
                                                            <button type="submit" class="admin-btn-icon is-danger border-0 bg-transparent"><i class="fas fa-trash"></i></button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Trashed templates -->
                    <div class="bento-item full-width d-none" id="trash-templates-section">
                        <div class="bento-inner p-0">
                            <div class="admin-table-responsive">
                                <table class="admin-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Mẫu khung giờ</th>
                                            <th>Mã</th>
                                            <th>Thời lượng</th>
                                            <th>Trạng thái</th>
                                            <th>Thời điểm xóa</th>
                                            <th>Hết hạn trong</th>
                                            <th class="text-end">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var t in trashedTemplates)
                                        {
                                            var daysInTrash = t.DeletedAt.HasValue ? (DateTime.UtcNow - t.DeletedAt.Value).Days : 0;
                                            var daysLeft = int.Parse(trashRetentionDays) - daysInTrash;
                                            <tr>
                                                <td><span class="fw-bold text-muted">@t.Name</span></td>
                                                <td><code>@t.Code</code></td>
                                                <td>@t.DurationMinutes phút</td>
                                                <td>
                                                    <span class="badge-premium badge-secondary-soft">Đã xóa</span>
                                                </td>
                                                <td><span class="small text-muted">@(t.DeletedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</span></td>
                                                <td>
                                                    @if (daysLeft > 0)
                                                    {
                                                        <span class="small text-danger fw-semibold">@daysLeft ngày</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="small text-muted">@Math.Abs(daysLeft) ngày trước</span>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <div class="admin-actions">
                                                        <form asp-controller="AdminSlots" asp-action="RestoreTemplate" method="post" class="d-inline" data-premium-confirm="Khôi phục mẫu khung giờ '@t.Name'?" data-premium-title="Khôi phục" data-premium-ok="Khôi phục">
                                                            <input type="hidden" name="id" value="@t.Id" />
                                                            <button type="submit" class="admin-btn-icon border-0 bg-transparent text-success"><i class="fas fa-rotate-left"></i></button>
                                                        </form>
                                                        <form asp-controller="AdminSlots" asp-action="PermanentDeleteTemplate" method="post" class="d-inline" data-premium-confirm="Xóa vĩnh viễn mẫu khung giờ '@t.Name'? Hành động này không thể hoàn tác." data-premium-title="Xóa vĩnh viễn" data-premium-ok="Xóa" data-premium-danger="true">
                                                            <input type="hidden" name="id" value="@t.Id" />
                                                            <button type="submit" class="admin-btn-icon is-danger border-0 bg-transparent"><i class="fas fa-trash-can"></i></button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PANEL: MA TRẬN NGÀY LỄ -->
            <div class="tab-pane fade" id="panel-holiday" role="tabpanel">
                <div class="panel-header d-flex justify-content-between">
                    <div>
                        <h2>Ma trận Ngày Lễ</h2>
                        <p>Cấu hình các dịp đặc biệt để hệ thống tự động điều chỉnh biểu giá.</p>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <button type="button" class="btn-premium btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#importHolidaysModal">
                            <i class="fas fa-file-import me-2"></i> Import Excel
                        </button>
                        @if (trashedHolidays.Any())
                        {
                            <button type="button" class="btn-premium-outline btn-sm rounded-pill px-3 trash-toggle-btn" data-panel="holiday" onclick="toggleTrashPanel('holiday')">
                                <i class="fas fa-trash-alt me-1"></i> <span>Thùng rác</span> <span class="badge bg-danger ms-1">@trashedHolidays.Count</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="trash-retention-info settings-trash-info d-none" id="trash-info-holiday">
                    <i class="fas fa-info-circle me-1"></i>
                    Các ngày lễ trong này sẽ tự động bị xóa vĩnh viễn sau @trashRetentionDays ngày.
                </div>

                <div id="active-holidays-section">
                <div class="row g-4">
                    <!-- Cột trái: Quản lý cụm ngày lễ -->
                    <div class="col-lg-4">
                        <div class="bento-item h-100">
                            <div class="bento-inner h-100">
                                @{
                                    var groupedHolidays = holidays.GroupBy(h => h.Description).OrderByDescending(g => g.Max(x => x.Date));
                                }
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="fw-bold mb-0 text-primary"><i class="fas fa-layer-group me-2"></i>Ngày lễ đã cấu hình</h6>
                                    <span class="badge bg-soft-primary text-primary rounded-pill">@groupedHolidays.Count() dịp</span>
                                </div>

                                <div class="holiday-list-scroll pe-2">
                                    @if (!groupedHolidays.Any())
                                    {
                                        <div class="empty-holiday-state">
                                            <div class="empty-icon-wrapper">
                                                <i class="fas fa-calendar-plus"></i>
                                            </div>
                                            <h5>Chưa có ngày lễ</h5>
                                            <p>Chọn ngày trên lịch để thiết lập dịp lễ mới cho hệ thống.</p>
                                        </div>
                                    }
                                    @foreach (var group in groupedHolidays)
                                    {
                                        <div class="holiday-group-card mb-3">
                                            <div class="card-header-lux" onclick="toggleGroup(this)">
                                                <div class="d-flex align-items-center">
                                                    <div class="group-icon me-3">
                                                        <i class="fas fa-umbrella-beach"></i>
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold text-dark">@group.Key</div>
                                                        <div class="text-muted extra-small">@group.Count() ngày • @group.Min(x => x.Date).ToString("dd/MM") - @group.Max(x => x.Date).ToString("dd/MM")</div>
                                                    </div>
                                                </div>
                                                <i class="fas fa-chevron-right group-arrow transition-all opacity-50"></i>
                                            </div>
                                            <div class="group-details-lux" style="display: none;">
                                                @foreach (var h in group.OrderBy(x => x.Date))
                                                {
                                                    <div class="detail-row">
                                                        <div class="d-flex align-items-center">
                                                            <div class="dot me-2"></div>
                                                            <span class="small fw-semibold">@h.Date.ToString("dd/MM/yyyy")</span>
                                                        </div>
                                                        <form action="/chinhan/hethong/holidays/delete/@h.Id" method="post" data-premium-confirm="Bạn có chắc chắn muốn xóa ngày lễ '@h.Date.ToString("dd/MM/yyyy")' này không?" data-premium-title="Xóa ngày lễ" data-premium-ok="Xóa" data-premium-danger="true">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn-delete-item"><i class="fas fa-trash-alt"></i></button>
                                                        </form>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Quick Select VN Holidays -->
                                <div class="mt-4 pt-4 border-top">
                                    <h6 class="fw-bold mb-3 small text-muted text-uppercase tracking-wider">Gợi ý ngày lễ VN <span id="suggestionYearLabel">2026</span></h6>
                                    <div id="vnSuggestionContainer" class="vn-holiday-suggestions d-flex flex-wrap gap-2">
                                        <!-- Will be populated by JS -->
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- Cột phải: Lịch thông minh -->
                    <div class="col-lg-8">
                        <div class="bento-item">
                            <div class="bento-inner">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h6 class="fw-bold mb-0 d-flex align-items-center">
                                        <i class="fas fa-chevron-left me-3 cursor-pointer text-muted hover-primary" onclick="changeMonth(-1)"></i>
                                        <div class="position-relative">
                                            <span id="currentMonthYear" class="cursor-pointer hover-underline">THÁNG -- / ----</span>
                                            <input type="month" id="monthPicker" class="month-picker-overlay" onchange="jumpToMonth(this.value)">
                                        </div>
                                        <i class="fas fa-chevron-right ms-3 cursor-pointer text-muted hover-primary" onclick="changeMonth(1)"></i>
                                    </h6>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-light btn-sm rounded-pill px-3 fw-bold" onclick="today()">Hôm nay</button>
                                        <button class="btn btn-soft-danger btn-sm rounded-pill px-3 fw-bold" onclick="clearSelection()">Bỏ chọn</button>
                                    </div>

                                </div>

                                <!-- Selection Status Bar -->
                                <div id="selectionBar" class="selection-status-lux mb-4" style="display: none;">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="status-icon"><i class="fas fa-calendar-check"></i></div>
                                        <div class="status-info">
                                            <div id="selectionLabel" class="status-label">Đang chọn</div>
                                            <div id="selectionText" class="status-value">...</div>
                                        </div>
                                    </div>
                                    <button class="btn-config-lux" data-bs-toggle="modal" data-bs-target="#saveHolidayModal">Cấu hình Lễ</button>
                                </div>

                                <div class="calendar-grid-premium">
                                    <div class="cal-header">T2</div><div class="cal-header">T3</div><div class="cal-header">T4</div>
                                    <div class="cal-header">T5</div><div class="cal-header">T6</div><div class="cal-header text-warning">T7</div>
                                    <div class="cal-header text-warning">CN</div>
                                    <div id="calendarDays" style="display: contents;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                </div> <!-- /active-holidays-section -->

                <!-- Trashed holidays -->
                <div class="d-none" id="trash-holidays-section">
                    <div class="row g-4">
                        <div class="col-12">
                            <div class="bento-item full-width">
                                <div class="bento-inner p-0">
                                    <div class="admin-table-responsive">
                                        <table class="admin-table mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Ngày</th>
                                                    <th>Dịp lễ</th>
                                                    <th>Thời điểm xóa</th>
                                                    <th>Hết hạn trong</th>
                                                    <th class="text-end">Thao tác</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var h in trashedHolidays)
                                                {
                                                    var daysInTrash = h.DeletedAt.HasValue ? (DateTime.UtcNow - h.DeletedAt.Value).Days : 0;
                                                    var daysLeft = int.Parse(trashRetentionDays) - daysInTrash;
                                                    <tr>
                                                        <td><span class="fw-semibold">@h.Date.ToString("dd/MM/yyyy")</span></td>
                                                        <td><span class="text-muted">@h.Description</span></td>
                                                        <td><span class="small text-muted">@(h.DeletedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</span></td>
                                                        <td>
                                                            @if (daysLeft > 0)
                                                            {
                                                                <span class="small text-danger fw-semibold">@daysLeft ngày</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="small text-muted">@Math.Abs(daysLeft) ngày trước</span>
                                                            }
                                                        </td>
                                                        <td class="text-end">
                                                            <div class="admin-actions">
                                                                <form action="/chinhan/hethong/holidays/restore/@h.Id" method="post" class="d-inline" data-premium-confirm="Khôi phục ngày lễ '@h.Date.ToString("dd/MM/yyyy")'?" data-premium-title="Khôi phục" data-premium-ok="Khôi phục">
                                                                    @Html.AntiForgeryToken()
                                                                    <button type="submit" class="admin-btn-icon border-0 bg-transparent text-success"><i class="fas fa-rotate-left"></i></button>
                                                                </form>
                                                                <form action="/chinhan/hethong/holidays/permanent-delete/@h.Id" method="post" class="d-inline" data-premium-confirm="Xóa vĩnh viễn ngày lễ '@h.Date.ToString("dd/MM/yyyy")'? Hành động này không thể hoàn tác." data-premium-title="Xóa vĩnh viễn" data-premium-ok="Xóa" data-premium-danger="true">
                                                                    @Html.AntiForgeryToken()
                                                                    <button type="submit" class="admin-btn-icon is-danger border-0 bg-transparent"><i class="fas fa-trash-can"></i></button>
                                                                </form>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PANEL: CHI NHÁNH -->
            <div class="tab-pane fade" id="panel-branch" role="tabpanel">
                <div class="panel-header">
                    <h2>Cấu hình Chi nhánh</h2>
                    <p>Thiết lập thông số vận hành riêng biệt cho từng địa điểm.</p>
                </div>

                <div class="settings-bento-grid">
                    @foreach (var b in branches)
                    {
                        <div class="bento-item">
                            <div class="bento-inner">
                                <div class="d-flex align-items-center mb-4">
                                    <div class="branch-icon-square me-3">
                                        <i class="fas fa-building"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0">@b.Name</h6>
                                        <span class="text-muted small">ID chi nhánh: #@b.Id</span>
                                    </div>
                                </div>
                                
                                <form asp-action="UpdateBranch" method="post">
                                    <input type="hidden" name="branchId" value="@b.Id" />
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-muted">Số giờ đặt trước (Lead Time)</label>
                                        <div class="input-group-premium">
                                            <i class="fas fa-clock text-muted"></i>
                                            <input type="number" name="leadTime" value="@b.BookingLeadTimeHours" class="form-control-premium" placeholder="Vd: 2">
                                            <span class="suffix">giờ</span>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn-save-branch">
                                        <i class="fas fa-check me-2"></i> Lưu chi nhánh
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- PANEL: CẤU HÌNH MÃ QR -->
            <div class="tab-pane fade" id="panel-payment-qr" role="tabpanel">
                <div class="panel-header">
                    <h2>Cấu hình mã QR</h2>
                    <p>Thiết lập mã QR thanh toán, nội dung chuyển khoản và thông báo bill riêng cho từng chi nhánh.</p>
                </div>

                <div class="qr-branch-list">
                    @foreach (var branch in branches)
                    {
                        var qr = paymentQrSettings.ContainsKey(branch.Id)
                            ? paymentQrSettings[branch.Id]
                            : new WebHomestay.Models.ViewModels.PaymentQrSettingsViewModel { BranchId = branch.Id, BranchName = branch.Name };
                        var previewSrc = !string.IsNullOrWhiteSpace(qr.QrImagePath) ? qr.QrImagePath : qr.QrImageUrl;
                        var hasBankInfo = !string.IsNullOrWhiteSpace(qr.BankCode) && !string.IsNullOrWhiteSpace(qr.BankAccountNumber);

                        <div class="qr-branch-card">
                            <div class="qr-branch-header" onclick="toggleQrBranch(this)">
                                <div class="qr-branch-info">
                                    <div class="qr-branch-name">
                                        <i class="fas fa-qrcode"></i>
                                        @branch.Name
                                    </div>
                                    <div class="qr-branch-meta">
                                        @if (hasBankInfo)
                                        {
                                            <span><i class="fas fa-university"></i> @qr.BankCode - @qr.BankAccountNumber</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Chưa cấu hình ngân hàng</span>
                                        }
                                        <span class="qr-countdown-badge"><i class="far fa-clock"></i> @qr.CountdownMinutes phút</span>
                                    </div>
                                </div>
                                <div class="qr-branch-preview">
                                    @if (!string.IsNullOrWhiteSpace(previewSrc))
                                    {
                                        <img src="@previewSrc" alt="QR @branch.Name" />
                                    }
                                    else
                                    {
                                        <div class="qr-preview-empty">
                                            <i class="fas fa-qrcode"></i>
                                        </div>
                                    }
                                </div>
                                <div class="qr-branch-toggle">
                                    <i class="fas fa-chevron-down qr-toggle-icon"></i>
                                </div>
                            </div>

                            <div class="qr-branch-body">
                                <form asp-action="UpdatePaymentQr" method="post" enctype="multipart/form-data" class="row g-4">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="BranchId" value="@branch.Id" />
                                    <input type="hidden" name="BranchName" value="@branch.Name" />

                                    <!-- Cột trái: Live Preview & QR Upload -->
                                    <div class="col-lg-5 col-xl-4">
                                        <!-- Live Preview Card -->
                                        <div class="premium-card mb-4 overflow-hidden border-0 shadow-sm" style="border-radius: var(--admin-radius);">
                                            <div class="card-header bg-gradient-premium text-white py-3 px-4">
                                                <h6 class="fw-bold mb-0 d-flex align-items-center"><i class="fas fa-eye me-2"></i>Xem trước thẻ thanh toán</h6>
                                            </div>
                                            <div class="card-body p-4 bg-light-subtle d-flex flex-column align-items-center gap-3">
                                                <!-- The styled Bank Card -->
                                                <div class="bank-transfer-card bg-slate-900 text-white p-4 w-100 position-relative shadow-lg border border-slate-800" style="border-radius: 20px; overflow: hidden; background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
                                                    <!-- Abstract glowing shapes inside card -->
                                                    <div class="position-absolute" style="top: -20px; right: -20px; width: 120px; height: 120px; border-radius: 50%; background: rgba(194, 155, 97, 0.15); filter: blur(30px); pointer-events: none;"></div>
                                                    <div class="position-absolute" style="bottom: -30px; left: -10px; width: 150px; height: 150px; border-radius: 50%; background: rgba(79, 140, 255, 0.12); filter: blur(40px); pointer-events: none;"></div>
                                                    
                                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                                        <div class="preview-card-chip text-warning fs-3">
                                                            <i class="fas fa-microchip"></i>
                                                        </div>
                                                        <div class="preview-card-logo">
                                                            <i class="fas fa-credit-card text-slate-500 fs-4"></i>
                                                        </div>
                                                    </div>
                                                    
                                                    <div class="mb-3">
                                                        <span class="text-slate-400 extra-small d-block mb-1 tracking-widest text-uppercase">NGÂN HÀNG THỤ HƯỞNG</span>
                                                        <strong class="preview-bank-code fs-6 fw-bold text-white tracking-wide">@(string.IsNullOrWhiteSpace(qr.BankCode) ? "CHƯA CẤU HÌNH" : qr.BankCode.ToUpper())</strong>
                                                    </div>
                                                    
                                                    <div class="mb-3">
                                                        <span class="text-slate-400 extra-small d-block mb-1 tracking-widest text-uppercase">SỐ TÀI KHOẢN</span>
                                                        <strong class="preview-bank-acc fs-5 fw-bold text-white tracking-widest">@(string.IsNullOrWhiteSpace(qr.BankAccountNumber) ? "•••• •••• ••••" : qr.BankAccountNumber)</strong>
                                                    </div>
                                                    
                                                    <div class="row g-2 align-items-end">
                                                        <div class="col-7">
                                                            <span class="text-slate-400 extra-small d-block mb-1 tracking-widest text-uppercase">CHỦ TÀI KHOẢN</span>
                                                            <strong class="preview-bank-name small fw-bold text-white text-uppercase tracking-wide">@(string.IsNullOrWhiteSpace(qr.BankAccountName) ? "CHƯA CẤU HÌNH" : qr.BankAccountName)</strong>
                                                        </div>
                                                        <div class="col-5 text-end">
                                                            <span class="badge-premium badge-warning-soft px-2 py-1 rounded small fs-9 d-inline-flex align-items-center"><i class="fas fa-qrcode me-1"></i> VietQR.vn</span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- QR Code Preview Area -->
                                                <div class="qr-preview-box w-100 text-center py-4 px-3 border border-dashed rounded-4 bg-white position-relative overflow-hidden" style="min-height: 250px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 12px;">
                                                    @if (!string.IsNullOrWhiteSpace(previewSrc))
                                                    {
                                                        <div class="qr-preview-wrapper position-relative p-2 bg-white border rounded-3 shadow-sm d-inline-block">
                                                            <img src="@previewSrc" alt="QR @branch.Name" class="img-fluid" style="max-height: 180px; object-fit: contain;" />
                                                        </div>
                                                        <div class="text-success small fw-semibold"><i class="fas fa-check-circle me-1"></i> Đã cấu hình ảnh QR của chi nhánh</div>
                                                    }
                                                    else if (hasBankInfo)
                                                    {
                                                        <!-- Dynamic VietQR Placeholder representation -->
                                                        <div class="vietqr-placeholder-graphic position-relative p-3 bg-slate-50 border border-slate-200 rounded-3 shadow-sm text-center d-flex flex-column align-items-center justify-content-center" style="width: 170px; height: 170px;">
                                                            <i class="fas fa-qrcode text-slate-300 fs-1 mb-2"></i>
                                                            <span class="text-slate-400 fs-8 fw-semibold text-uppercase">MÃ VIETQR ĐỘNG</span>
                                                            <span class="text-slate-500 extra-small">Tự động tạo khi xuất hóa đơn</span>
                                                            <!-- VietQR corner scanner borders -->
                                                            <div class="position-absolute" style="top: 8px; left: 8px; width: 16px; height: 16px; border-top: 3px solid var(--admin-primary); border-left: 3px solid var(--admin-primary);"></div>
                                                            <div class="position-absolute" style="top: 8px; right: 8px; width: 16px; height: 16px; border-top: 3px solid var(--admin-primary); border-right: 3px solid var(--admin-primary);"></div>
                                                            <div class="position-absolute" style="bottom: 8px; left: 8px; width: 16px; height: 16px; border-bottom: 3px solid var(--admin-primary); border-left: 3px solid var(--admin-primary);"></div>
                                                            <div class="position-absolute" style="bottom: 8px; right: 8px; width: 16px; height: 16px; border-bottom: 3px solid var(--admin-primary); border-right: 3px solid var(--admin-primary);"></div>
                                                        </div>
                                                        <div class="text-primary small fw-semibold"><i class="fas fa-magic me-1"></i> Tự động tạo VietQR theo tài khoản ngân hàng</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="text-muted small py-4 px-3 text-center d-flex flex-column align-items-center justify-content-center">
                                                            <i class="fas fa-exclamation-triangle text-warning fs-3 mb-2"></i>
                                                            <span>Chưa có ảnh QR hoặc thông tin ngân hàng thụ hưởng.</span>
                                                        </div>
                                                    }
                                                </div>

                                                <!-- Upload field -->
                                                <div class="w-100 bg-white border border-slate-100 rounded-4 p-3 shadow-2xs mt-1">
                                                    <label class="form-label small fw-bold text-muted d-block mb-2 text-uppercase tracking-wider"><i class="fas fa-cloud-upload-alt me-1"></i> Tải lên ảnh QR mới</label>
                                                    <input type="file" name="qrImage" class="form-control form-control-sm premium-input" accept="image/*" onchange="previewUploadImage(this)" />
                                                    @if (!string.IsNullOrWhiteSpace(qr.QrImagePath))
                                                    {
                                                        <div class="extra-small text-muted mt-2 text-truncate" title="@qr.QrImagePath">Đường dẫn: @qr.QrImagePath</div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Cột phải: Form Cấu hình chi tiết -->
                                    <div class="col-lg-7 col-xl-8">
                                        <div class="row g-4">
                                            <!-- Section 1: Tài khoản ngân hàng -->
                                            <div class="col-12">
                                                <div class="border rounded-4 p-4 bg-white shadow-2xs">
                                                    <h6 class="fw-bold mb-3 text-primary d-flex align-items-center border-bottom pb-2">
                                                        <i class="fas fa-university me-2"></i> Thông tin thụ hưởng ngân hàng
                                                    </h6>
                                                    <div class="row g-3">
                                                        <div class="col-12">
                                                            <label class="form-label small fw-bold text-muted">URL ảnh QR thủ công (nếu không upload)</label>
                                                            <div class="input-group-premium">
                                                                <i class="fas fa-link"></i>
                                                                <input type="url" name="QrImageUrl" value="@qr.QrImageUrl" class="form-control-premium" placeholder="https://..." oninput="updateQRPreview(this)" />
                                                            </div>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label class="form-label small fw-bold text-muted">Mã ngân hàng (ví dụ: MB, VCB, ICB)</label>
                                                            <div class="input-group-premium">
                                                                <i class="fas fa-building"></i>
                                                                <input type="text" name="BankCode" value="@qr.BankCode" class="form-control-premium text-uppercase" placeholder="MB, VCB..." oninput="updateCardText(this, '.preview-bank-code')" />
                                                            </div>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label class="form-label small fw-bold text-muted">Số tài khoản thụ hưởng</label>
                                                            <div class="input-group-premium">
                                                                <i class="fas fa-hashtag"></i>
                                                                <input type="text" name="BankAccountNumber" value="@qr.BankAccountNumber" class="form-control-premium" placeholder="Số tài khoản..." oninput="updateCardText(this, '.preview-bank-acc')" />
                                                            </div>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label class="form-label small fw-bold text-muted">Họ tên chủ tài khoản</label>
                                                            <div class="input-group-premium">
                                                                <i class="fas fa-user-tie"></i>
                                                                <input type="text" name="BankAccountName" value="@qr.BankAccountName" class="form-control-premium text-uppercase" placeholder="Tên chủ tài khoản..." oninput="updateCardText(this, '.preview-bank-name')" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Section 2: Nội dung & Thời gian -->
                                            <div class="col-12">
                                                <div class="border rounded-4 p-4 bg-white shadow-2xs">
                                                    <h6 class="fw-bold mb-3 text-primary d-flex align-items-center border-bottom pb-2">
                                                        <i class="fas fa-receipt me-2"></i> Nội dung & Đếm ngược
                                                    </h6>
                                                    <div class="row g-3">
                                                        <div class="col-md-8">
                                                            <label class="form-label small fw-bold text-muted">Mẫu nội dung chuyển khoản</label>
                                                            <div class="input-group-premium">
                                                                <i class="fas fa-edit"></i>
                                                                <input type="text" name="TransferContentTemplate" value="@qr.TransferContentTemplate" class="form-control-premium" placeholder="Ví dụ: chinhan {BookingId}" />
                                                            </div>
                                                            <div class="form-text text-muted small mt-2">
                                                                <span>Hỗ trợ các thẻ: </span>
                                                                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-1 font-monospace" onclick="insertQrPlaceholder(this, '{BookingId}')">{BookingId}</button>
                                                                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-1 font-monospace" onclick="insertQrPlaceholder(this, '{BranchName}')">{BranchName}</button>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label class="form-label small fw-bold text-muted">Thời gian đếm ngược thanh toán</label>
                                                            <div class="input-group-premium">
                                                                <i class="fas fa-hourglass-half"></i>
                                                                <input type="number" name="CountdownMinutes" value="@qr.CountdownMinutes" min="1" class="form-control-premium" placeholder="Số phút..." />
                                                                <span class="suffix">phút</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Section 3: Tin nhắn hiển thị cho khách hàng -->
                                            <div class="col-12">
                                                <div class="border rounded-4 p-4 bg-white shadow-2xs">
                                                    <h6 class="fw-bold mb-3 text-primary d-flex align-items-center border-bottom pb-2">
                                                        <i class="fas fa-comment-alt me-2"></i> Thông điệp hiển thị cho khách hàng
                                                    </h6>
                                                    <div class="row g-3">
                                                        <div class="col-12">
                                                            <label class="form-label small fw-bold text-muted">Thông báo trước khi khách gửi bill chuyển khoản</label>
                                                            <textarea name="BeforeBillMessage" rows="2" class="form-control form-control-premium" placeholder="Nhập lời nhắc trước khi gửi bill...">@qr.BeforeBillMessage</textarea>
                                                        </div>
                                                        <div class="col-12">
                                                            <label class="form-label small fw-bold text-muted">Thông báo sau khi khách gửi bill thành công (chờ xác nhận)</label>
                                                            <textarea name="AfterBillMessage" rows="2" class="form-control form-control-premium" placeholder="Nhập lời nhắc sau khi nhận bill...">@qr.AfterBillMessage</textarea>
                                                        </div>
                                                        <div class="col-12">
                                                            <label class="form-label small fw-bold text-muted">Thông báo khi mã hóa đơn thanh toán hết thời gian đếm ngược</label>
                                                            <textarea name="ExpiredMessage" rows="2" class="form-control form-control-premium" placeholder="Nhập thông báo khi hết giờ thanh toán...">@qr.ExpiredMessage</textarea>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Nút Lưu -->
                                            <div class="col-12 text-end">
                                                <button type="submit" class="btn-premium rounded-pill px-5 py-2.5 shadow-sm">
                                                    <i class="fas fa-save me-2"></i>Lưu cấu hình QR
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- PANEL: MẪU DỮ LIỆU & IMPORT -->
            <div class="tab-pane fade" id="panel-import" role="tabpanel">
                <div class="panel-header">
                    <h2>Mẫu Dữ Liệu & Cấu Hình Import</h2>
                    <p>Tải về các file Excel mẫu để điền thông tin và import hàng loạt dữ liệu vào hệ thống.</p>
                </div>

                <div class="settings-bento-grid">
                    <!-- Zip size limit slider -->
                    <div class="bento-item full-width">
                        <div class="bento-inner">
                            <h5 class="bento-title"><i class="fas fa-file-archive me-2 text-warning"></i>Cấu hình Giới hạn Kích thước ZIP/Excel Upload</h5>
                            <p class="text-muted small mb-4">Thiết lập dung lượng file tối đa cho phép tải lên khi thực hiện Import dữ liệu hàng loạt (từ 5MB đến 100MB).</p>
                            
                            <form asp-action="Update" method="post">
                                <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <div class="d-flex align-items-center gap-3">
                                            <input type="range" class="form-range" min="5" max="100" step="5" id="zipSizeRange" name="value" value="@(Model.FirstOrDefault(s => s.SettingKey == "MaxZipUploadSizeMB")?.SettingValue ?? "30")" oninput="document.getElementById('zipSizeValue').innerText = this.value" />
                                            <span class="fw-bold text-primary fs-5" style="white-space: nowrap;"><span id="zipSizeValue">@(Model.FirstOrDefault(s => s.SettingKey == "MaxZipUploadSizeMB")?.SettingValue ?? "30")</span> MB</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4 text-end">
                                        <input type="hidden" name="key" value="MaxZipUploadSizeMB" />
                                        <button type="submit" class="btn btn-primary rounded-pill px-4" style="background: linear-gradient(135deg, #4F81BD 0%, #295B96 100%); border: none;">
                                            <i class="fas fa-save me-2"></i> Lưu giới hạn
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Templates Download cards -->
                    <div class="bento-item full-width">
                        <div class="bento-inner">
                            <h5 class="bento-title"><i class="fas fa-download me-2 text-primary"></i>Danh sách Form mẫu Excel</h5>
                            <p class="text-muted small mb-4">Vui lòng tải đúng file mẫu dưới đây, điền thông tin theo định dạng và ví dụ có sẵn trước khi import.</p>
                            
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="border rounded-4 p-3 text-center bg-light-subtle h-100 d-flex flex-column justify-content-between">
                                        <div>
                                            <i class="fas fa-map-marked-alt text-primary fs-3 mb-2"></i>
                                            <h6 class="fw-bold mb-1">Mẫu Chi nhánh</h6>
                                            <p class="small text-muted mb-3">Chứa thông tin cơ bản của các chi nhánh homestay.</p>
                                        </div>
                                        <a asp-action="DownloadTemplate" asp-route-type="branch" class="btn btn-sm btn-outline-primary rounded-pill w-100">
                                            <i class="fas fa-download me-1"></i> Tải file mẫu
                                        </a>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="border rounded-4 p-3 text-center bg-light-subtle h-100 d-flex flex-column justify-content-between">
                                        <div>
                                            <i class="fas fa-bed text-success fs-3 mb-2"></i>
                                            <h6 class="fw-bold mb-1">Mẫu Phòng ngủ</h6>
                                            <p class="small text-muted mb-3">Bao gồm thông tin phòng, giá giờ/ngày, sức chứa, ảnh đại diện.</p>
                                        </div>
                                        <a asp-action="DownloadTemplate" asp-route-type="room" class="btn btn-sm btn-outline-success rounded-pill w-100">
                                            <i class="fas fa-download me-1"></i> Tải file mẫu
                                        </a>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="border rounded-4 p-3 text-center bg-light-subtle h-100 d-flex flex-column justify-content-between">
                                        <div>
                                            <i class="fas fa-users-cog text-info fs-3 mb-2"></i>
                                            <h6 class="fw-bold mb-1">Mẫu Nhân viên</h6>
                                            <p class="small text-muted mb-3">Tạo tài khoản quản lý/nhân viên và phân quyền chi tiết.</p>
                                        </div>
                                        <a asp-action="DownloadTemplate" asp-route-type="staff" class="btn btn-sm btn-outline-info rounded-pill w-100">
                                            <i class="fas fa-download me-1"></i> Tải file mẫu
                                        </a>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="border rounded-4 p-3 text-center bg-light-subtle h-100 d-flex flex-column justify-content-between">
                                        <div>
                                            <i class="fas fa-brain fs-3 mb-2" style="color: #6f42c1;"></i>
                                            <h6 class="fw-bold mb-1">Ngân hàng tri thức AI</h6>
                                            <p class="small text-muted mb-3">Bài học đào tạo kiến thức homestay cho chatbot AI.</p>
                                        </div>
                                        <a asp-action="DownloadTemplate" asp-route-type="ai" class="btn btn-sm btn-outline-secondary rounded-pill w-100" style="color: #6f42c1; border-color: #6f42c1;">
                                            <i class="fas fa-download me-1"></i> Tải file mẫu
                                        </a>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="border rounded-4 p-3 text-center bg-light-subtle h-100 d-flex flex-column justify-content-between">
                                        <div>
                                            <i class="fas fa-clock text-warning fs-3 mb-2"></i>
                                            <h6 class="fw-bold mb-1">Mẫu Khung giờ</h6>
                                            <p class="small text-muted mb-3">Danh sách khung giờ hoạt động (theo giờ/ngày).</p>
                                        </div>
                                        <a asp-action="DownloadTemplate" asp-route-type="slottemplate" class="btn btn-sm btn-outline-warning rounded-pill w-100">
                                            <i class="fas fa-download me-1"></i> Tải file mẫu
                                        </a>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="border rounded-4 p-3 text-center bg-light-subtle h-100 d-flex flex-column justify-content-between">
                                        <div>
                                            <i class="fas fa-calendar-day text-danger fs-3 mb-2"></i>
                                            <h6 class="fw-bold mb-1">Mẫu Ngày lễ</h6>
                                            <p class="small text-muted mb-3">Cài đặt ma trận các ngày lễ phụ thu trong năm.</p>
                                        </div>
                                        <a asp-action="DownloadTemplate" asp-route-type="holiday" class="btn btn-sm btn-outline-danger rounded-pill w-100">
                                            <i class="fas fa-download me-1"></i> Tải file mẫu
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Modal: THÊM MẪU KHUNG GIỜ -->
<div class="modal fade" id="createTemplateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content premium-modal">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <div>
                    <h5 class="modal-title fw-bold mb-1">Tạo Mẫu khung giờ</h5>
                    <p class="small text-muted mb-0">Định nghĩa khung thời gian cho phiên đặt phòng</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="AdminSlots" asp-action="CreateTemplate" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body px-4 py-4">

                    <!-- Row: Name + Code -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <div class="form-field-card">
                                <label class="admin-form-label"><i class="fas fa-tag me-1" style="opacity:0.5"></i> Tên hiển thị</label>
                                <input name="Name" class="admin-form-input" placeholder="VD: Combo 4h Trưa" required />
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-field-card">
                                <label class="admin-form-label"><i class="fas fa-hashtag me-1" style="opacity:0.5"></i> Mã định danh</label>
                                <input name="Code" class="admin-form-input" placeholder="VD: 4H_NOON" required />
                            </div>
                        </div>
                    </div>

                    <!-- Duration Hub -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <div class="form-field-card">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="admin-form-label mb-0"><i class="fas fa-clock me-1" style="opacity:0.5"></i> Thời lượng mỗi phiên</label>
                                    <div class="minutes-badge">
