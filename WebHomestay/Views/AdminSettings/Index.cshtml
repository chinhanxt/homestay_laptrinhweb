@model IEnumerable<WebHomestay.Models.SystemSetting>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Trung tâm Điều hành Hệ thống";
    var branches = ViewBag.Branches as List<WebHomestay.Models.Branch> ?? new List<WebHomestay.Models.Branch>();
    var holidays = ViewBag.Holidays as List<WebHomestay.Models.Holiday> ?? new List<WebHomestay.Models.Holiday>();
    var templates = ViewBag.Templates as List<WebHomestay.Models.RoomSlotTemplate> ?? new List<WebHomestay.Models.RoomSlotTemplate>();
    var paymentQrSettings = ViewBag.PaymentQrSettings as Dictionary<int, WebHomestay.Models.ViewModels.PaymentQrSettingsViewModel> ?? new Dictionary<int, WebHomestay.Models.ViewModels.PaymentQrSettingsViewModel>();

    var checkoutMode = Model.FirstOrDefault(s => s.SettingKey == "CheckoutMode")?.SettingValue ?? "Auto";
}

<link rel="stylesheet" href="~/css/admin-premium.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin-ai-hub.css" asp-append-version="true" />

<div class="premium-settings-wrapper">
    <div class="settings-sidebar">
        <div class="main-sidebar-toggle" onclick="toggleMainSettingsSidebar()">
            <i class="fas fa-chevron-left"></i>
        </div>
        <div class="sidebar-brand">
            <i class="fas fa-sliders-h me-2"></i>
            <span>Cấu hình Hệ thống</span>
        </div>
        
        <div class="nav flex-column nav-pills" id="settings-tabs" role="tablist" aria-orientation="vertical">
            <button class="nav-link active" id="tab-ops" data-bs-toggle="pill" data-bs-target="#panel-ops" type="button" role="tab">
                <i class="fas fa-magic me-3"></i> <span>Vận hành & Tự động</span>
            </button>
            <button class="nav-link" id="tab-time" data-bs-toggle="pill" data-bs-target="#panel-time" type="button" role="tab">
                <i class="fas fa-clock me-3"></i> <span>Thời gian & Khung giờ</span>
            </button>
            <button class="nav-link" id="tab-holiday" data-bs-toggle="pill" data-bs-target="#panel-holiday" type="button" role="tab">
                <i class="fas fa-star me-3"></i> <span>Ma trận Ngày Lễ</span>
            </button>
            <button class="nav-link" id="tab-branch" data-bs-toggle="pill" data-bs-target="#panel-branch" type="button" role="tab">
                <i class="fas fa-map-marked-alt me-3"></i> <span>Cấu hình Chi nhánh</span>
            </button>
            <button class="nav-link" id="tab-payment-qr" data-bs-toggle="pill" data-bs-target="#panel-payment-qr" type="button" role="tab">
                <i class="fas fa-qrcode me-3"></i> <span>Cấu hình mã QR</span>
            </button>
        </div>
        
        <div class="sidebar-footer">
            <div class="small text-muted mb-1 text-uppercase fw-bold" style="font-size: 0.65rem;">Hệ thống lõi</div>
            <div class="fw-bold text-dark" style="font-size: 0.8rem;">StayLuxe v4.2.0</div>
        </div>
    </div>

    <div class="settings-content">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="lux-toast-container show" id="temp-toast">
                <div class="lux-toast is-success">
                    <div class="lux-toast-accent"></div>
                    <div class="lux-toast-content">@TempData["SuccessMessage"]</div>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="lux-toast-container show" id="temp-toast-error">
                <div class="lux-toast" style="border-left: 4px solid #ef4444;">
                    <div class="lux-toast-content">@TempData["ErrorMessage"]</div>
                </div>
            </div>
        }

        <div class="tab-content" id="settings-tabContent">
            <!-- PANEL: VẬN HÀNH -->
            <div class="tab-pane fade show active" id="panel-ops" role="tabpanel">
                <div class="panel-header">
                    <h2>Vận hành & Tự động hóa</h2>
                    <p>Quản lý các kịch bản tự động và quy trình xử lý đơn hàng.</p>
                </div>
                
                <div class="settings-bento-grid">
                    <div class="bento-item full-width">
                        <div class="bento-inner">
                            <h5 class="bento-title"><i class="fas fa-door-open me-2 text-primary"></i>Quy trình Xác nhận Trả phòng (Checkout)</h5>
                            <p class="text-muted small mb-4">Lựa chọn cách thức hệ thống xác nhận khách đã hoàn thành thời gian lưu trú.</p>
                            
                            <form asp-action="Update" method="post" id="checkout-mode-form">
                                <div class="mode-selector-grid">
                                    <div class="mode-card">
                                        <input type="radio" name="value" id="mode-auto" value="Auto" @(checkoutMode == "Auto" ? "checked" : "") onchange="this.form.submit()">
                                        <label for="mode-auto">
                                            <div class="mode-icon"><i class="fas fa-bolt"></i></div>
                                            <div class="mode-info">
                                                <span class="mode-name">Tự động (Automatic)</span>
                                                <span class="mode-desc">Hệ thống tự động chuyển trạng thái đơn sang "Hoàn thành" ngay khi hết giờ checkout.</span>
                                            </div>
                                            <div class="mode-check"><i class="fas fa-check-circle"></i></div>
                                        </label>
                                    </div>
                                    <div class="mode-card">
                                        <input type="radio" name="value" id="mode-manual" value="Manual" @(checkoutMode == "Manual" ? "checked" : "") onchange="this.form.submit()">
                                        <label for="mode-manual">
                                            <div class="mode-icon"><i class="fas fa-user-check"></i></div>
                                            <div class="mode-info">
                                                <span class="mode-name">Thủ công (Manual)</span>
                                                <span class="mode-desc">Nhân viên cần kiểm tra thực tế và bấm xác nhận trả phòng thủ công trên bảng điều khiển.</span>
                                            </div>
                                            <div class="mode-check"><i class="fas fa-check-circle"></i></div>
                                        </label>
                                    </div>
                                </div>
                                <input type="hidden" name="key" value="CheckoutMode" />
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PANEL: THỜI GIAN & KHUNG GIỜ -->
            <div class="tab-pane fade" id="panel-time" role="tabpanel">
                <div class="panel-header d-flex justify-content-between align-items-end">
                    <div>
                        <h2>Thời gian & Khung giờ</h2>
                        <p>Thiết lập các mẫu khung giờ cố định và quy tắc thời gian đặt phòng.</p>
                    </div>
                    @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "rooms.create"))
                    {
                        <button type="button" class="btn-premium btn-sm rounded-pill px-4 mb-2" data-bs-toggle="modal" data-bs-target="#createTemplateModal">
                            <i class="fas fa-plus me-2"></i> Thêm mẫu mới
                        </button>
                    }
                </div>

                <div class="settings-bento-grid">
                    <div class="bento-item full-width">
                        <div class="bento-inner p-0">
                            <div class="admin-table-responsive">
                                <table class="admin-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Mẫu khung giờ</th>
                                            <th>Mã</th>
                                            <th>Thời lượng</th>
                                            <th>Dọn dẹp</th>
                                            <th>Trạng thái</th>
                                            <th class="text-end">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var t in templates)
                                        {
                                            <tr>
                                                <td><span class="fw-bold text-primary">@t.Name</span></td>
                                                <td><code>@t.Code</code></td>
                                                <td>@t.DurationMinutes phút</td>
                                                <td>@t.CleanupMinutes phút</td>
                                                <td>
                                                    <span class="badge-premium @(t.IsActive ? "badge-success-soft" : "badge-secondary-soft")">
                                                        @(t.IsActive ? "Kích hoạt" : "Tạm ngưng")
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <div class="admin-actions">
                                                        <button type="button" class="admin-btn-icon" 
                                                                onclick="openEditTemplateModal(@t.Id, '@t.Name', '@t.Code', @t.DurationMinutes, @t.CleanupMinutes, '@t.SeedStartTime', @(t.IsActive.ToString().ToLower()))">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <form action="/AdminSlots/DeleteTemplate" method="post" class="d-inline" onsubmit="return confirm('Xóa mẫu này?')">
    <input type="hidden" name="id" value="@t.Id" />
                                                            <button type="submit" class="admin-btn-icon is-danger border-0 bg-transparent"><i class="fas fa-trash"></i></button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PANEL: MA TRẬN NGÀY LỄ -->
            <div class="tab-pane fade" id="panel-holiday" role="tabpanel">
                <div class="panel-header">
                    <h2>Ma trận Ngày Lễ</h2>
                    <p>Cấu hình các dịp đặc biệt để hệ thống tự động điều chỉnh biểu giá.</p>
                </div>


                <div class="row g-4">
                    <!-- Cột trái: Quản lý cụm ngày lễ -->
                    <div class="col-lg-4">
                        <div class="bento-item h-100">
                            <div class="bento-inner h-100">
                                @{
                                    var groupedHolidays = holidays.GroupBy(h => h.Description).OrderByDescending(g => g.Max(x => x.Date));
                                }
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="fw-bold mb-0 text-primary"><i class="fas fa-layer-group me-2"></i>Ngày lễ đã cấu hình</h6>
                                    <span class="badge bg-soft-primary text-primary rounded-pill">@groupedHolidays.Count() dịp</span>
                                </div>

                                <div class="holiday-list-scroll pe-2">
                                    @if (!groupedHolidays.Any())
                                    {
                                        <div class="empty-holiday-state">
                                            <div class="empty-icon-wrapper">
                                                <i class="fas fa-calendar-plus"></i>
                                            </div>
                                            <h5>Chưa có ngày lễ</h5>
                                            <p>Chọn ngày trên lịch để thiết lập dịp lễ mới cho hệ thống.</p>
                                        </div>
                                    }
                                    @foreach (var group in groupedHolidays)
                                    {
                                        <div class="holiday-group-card mb-3">
                                            <div class="card-header-lux" onclick="toggleGroup(this)">
                                                <div class="d-flex align-items-center">
                                                    <div class="group-icon me-3">
                                                        <i class="fas fa-umbrella-beach"></i>
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold text-dark">@group.Key</div>
                                                        <div class="text-muted extra-small">@group.Count() ngày • @group.Min(x => x.Date).ToString("dd/MM") - @group.Max(x => x.Date).ToString("dd/MM")</div>
                                                    </div>
                                                </div>
                                                <i class="fas fa-chevron-right group-arrow transition-all opacity-50"></i>
                                            </div>
                                            <div class="group-details-lux" style="display: none;">
                                                @foreach (var h in group.OrderBy(x => x.Date))
                                                {
                                                    <div class="detail-row">
                                                        <div class="d-flex align-items-center">
                                                            <div class="dot me-2"></div>
                                                            <span class="small fw-semibold">@h.Date.ToString("dd/MM/yyyy")</span>
                                                        </div>
                                                        <form action="/admin/holidays/delete/@h.Id" method="post" onsubmit="return confirm('Xóa ngày lễ này?')">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn-delete-item"><i class="fas fa-trash-alt"></i></button>
                                                        </form>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Quick Select VN Holidays -->
                                <div class="mt-4 pt-4 border-top">
                                    <h6 class="fw-bold mb-3 small text-muted text-uppercase tracking-wider">Gợi ý ngày lễ VN <span id="suggestionYearLabel">2026</span></h6>
                                    <div id="vnSuggestionContainer" class="vn-holiday-suggestions d-flex flex-wrap gap-2">
                                        <!-- Will be populated by JS -->
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- Cột phải: Lịch thông minh -->
                    <div class="col-lg-8">
                        <div class="bento-item">
                            <div class="bento-inner">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h6 class="fw-bold mb-0 d-flex align-items-center">
                                        <i class="fas fa-chevron-left me-3 cursor-pointer text-muted hover-primary" onclick="changeMonth(-1)"></i>
                                        <div class="position-relative">
                                            <span id="currentMonthYear" class="cursor-pointer hover-underline">THÁNG -- / ----</span>
                                            <input type="month" id="monthPicker" class="month-picker-overlay" onchange="jumpToMonth(this.value)">
                                        </div>
                                        <i class="fas fa-chevron-right ms-3 cursor-pointer text-muted hover-primary" onclick="changeMonth(1)"></i>
                                    </h6>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-light btn-sm rounded-pill px-3 fw-bold" onclick="today()">Hôm nay</button>
                                        <button class="btn btn-soft-danger btn-sm rounded-pill px-3 fw-bold" onclick="clearSelection()">Bỏ chọn</button>
                                    </div>

                                </div>

                                <!-- Selection Status Bar -->
                                <div id="selectionBar" class="selection-status-lux mb-4" style="display: none;">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="status-icon"><i class="fas fa-calendar-check"></i></div>
                                        <div class="status-info">
                                            <div id="selectionLabel" class="status-label">Đang chọn</div>
                                            <div id="selectionText" class="status-value">...</div>
                                        </div>
                                    </div>
                                    <button class="btn-config-lux" data-bs-toggle="modal" data-bs-target="#saveHolidayModal">Cấu hình Lễ</button>
                                </div>

                                <div class="calendar-grid-premium">
                                    <div class="cal-header">T2</div><div class="cal-header">T3</div><div class="cal-header">T4</div>
                                    <div class="cal-header">T5</div><div class="cal-header">T6</div><div class="cal-header text-warning">T7</div>
                                    <div class="cal-header text-warning">CN</div>
                                    <div id="calendarDays" style="display: contents;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PANEL: CHI NHÁNH -->
            <div class="tab-pane fade" id="panel-branch" role="tabpanel">
                <div class="panel-header">
                    <h2>Cấu hình Chi nhánh</h2>
                    <p>Thiết lập thông số vận hành riêng biệt cho từng địa điểm.</p>
                </div>

                <div class="settings-bento-grid">
                    @foreach (var b in branches)
                    {
                        <div class="bento-item">
                            <div class="bento-inner">
                                <div class="d-flex align-items-center mb-4">
                                    <div class="branch-icon-square me-3">
                                        <i class="fas fa-building"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0">@b.Name</h6>
                                        <span class="text-muted small">ID chi nhánh: #@b.Id</span>
                                    </div>
                                </div>
                                
                                <form asp-action="UpdateBranch" method="post">
                                    <input type="hidden" name="branchId" value="@b.Id" />
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-muted">Số giờ đặt trước (Lead Time)</label>
                                        <div class="input-group-premium">
                                            <i class="fas fa-clock text-muted"></i>
                                            <input type="number" name="leadTime" value="@b.BookingLeadTimeHours" class="form-control-premium" placeholder="Vd: 2">
                                            <span class="suffix">giờ</span>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn-save-branch">
                                        <i class="fas fa-check me-2"></i> Lưu chi nhánh
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- PANEL: CẤU HÌNH MÃ QR -->
            <div class="tab-pane fade" id="panel-payment-qr" role="tabpanel">
                <div class="panel-header">
                    <h2>Cấu hình mã QR</h2>
                    <p>Thiết lập mã QR thanh toán, nội dung chuyển khoản và thông báo bill riêng cho từng chi nhánh.</p>
                </div>

                <div class="qr-branch-list">
                    @foreach (var branch in branches)
                    {
                        var qr = paymentQrSettings.ContainsKey(branch.Id)
                            ? paymentQrSettings[branch.Id]
                            : new WebHomestay.Models.ViewModels.PaymentQrSettingsViewModel { BranchId = branch.Id, BranchName = branch.Name };
                        var previewSrc = !string.IsNullOrWhiteSpace(qr.QrImagePath) ? qr.QrImagePath : qr.QrImageUrl;
                        var hasBankInfo = !string.IsNullOrWhiteSpace(qr.BankCode) && !string.IsNullOrWhiteSpace(qr.BankAccountNumber);

                        <div class="qr-branch-card">
                            <div class="qr-branch-header" onclick="toggleQrBranch(this)">
                                <div class="qr-branch-info">
                                    <div class="qr-branch-name">
                                        <i class="fas fa-qrcode"></i>
                                        @branch.Name
                                    </div>
                                    <div class="qr-branch-meta">
                                        @if (hasBankInfo)
                                        {
                                            <span><i class="fas fa-university"></i> @qr.BankCode - @qr.BankAccountNumber</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Chưa cấu hình ngân hàng</span>
                                        }
                                        <span class="qr-countdown-badge"><i class="far fa-clock"></i> @qr.CountdownMinutes phút</span>
                                    </div>
                                </div>
                                <div class="qr-branch-preview">
                                    @if (!string.IsNullOrWhiteSpace(previewSrc))
                                    {
                                        <img src="@previewSrc" alt="QR @branch.Name" />
                                    }
                                    else
                                    {
                                        <div class="qr-preview-empty">
                                            <i class="fas fa-qrcode"></i>
                                        </div>
                                    }
                                </div>
                                <div class="qr-branch-toggle">
                                    <i class="fas fa-chevron-down qr-toggle-icon"></i>
                                </div>
                            </div>

                            <div class="qr-branch-body">
                                <form asp-action="UpdatePaymentQr" method="post" enctype="multipart/form-data" class="row g-4">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="BranchId" value="@branch.Id" />
                                    <input type="hidden" name="BranchName" value="@branch.Name" />

                                    <div class="col-lg-4">
                                        <div class="bg-white border rounded-4 p-3 text-center h-100">
                                            @if (!string.IsNullOrWhiteSpace(previewSrc))
                                            {
                                                <img src="@previewSrc" alt="QR @branch.Name" class="img-fluid mb-3" style="max-height: 220px;" />
                                            }
                                            else
                                            {
                                                <div class="text-muted small py-5 border rounded-4 bg-light">Chưa có ảnh QR. Nếu nhập ngân hàng và số tài khoản, trang thanh toán sẽ tự tạo VietQR.</div>
                                            }
                                            <label class="form-label small fw-bold text-muted mt-3">Upload ảnh QR</label>
                                            <input type="file" name="qrImage" class="form-control premium-input" accept="image/*" />
                                            @if (!string.IsNullOrWhiteSpace(qr.QrImagePath))
                                            {
                                                <div class="small text-muted mt-2">Ảnh hiện tại: @qr.QrImagePath</div>
                                            }
                                        </div>
                                    </div>

                                    <div class="col-lg-8">
                                        <div class="row g-3">
                                            <div class="col-12">
                                                <label class="form-label small fw-bold text-muted">URL ảnh QR thủ công</label>
                                                <input type="url" name="QrImageUrl" value="@qr.QrImageUrl" class="form-control premium-input" placeholder="https://..." />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-bold text-muted">Mã ngân hàng</label>
                                                <input type="text" name="BankCode" value="@qr.BankCode" class="form-control premium-input" placeholder="MB, VCB..." />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-bold text-muted">Số tài khoản</label>
                                                <input type="text" name="BankAccountNumber" value="@qr.BankAccountNumber" class="form-control premium-input" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-bold text-muted">Chủ tài khoản</label>
                                                <input type="text" name="BankAccountName" value="@qr.BankAccountName" class="form-control premium-input" />
                                            </div>
                                            <div class="col-md-8">
                                                <label class="form-label small fw-bold text-muted">Mẫu nội dung chuyển khoản</label>
                                                <input type="text" name="TransferContentTemplate" value="@qr.TransferContentTemplate" class="form-control premium-input" />
                                                <div class="form-text">Hỗ trợ: {BookingId}, {BranchName}</div>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-bold text-muted">Thời gian đếm ngược (phút)</label>
                                                <input type="number" name="CountdownMinutes" value="@qr.CountdownMinutes" min="1" class="form-control premium-input" />
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label small fw-bold text-muted">Thông báo trước khi gửi bill</label>
                                                <textarea name="BeforeBillMessage" rows="2" class="form-control premium-input">@qr.BeforeBillMessage</textarea>
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label small fw-bold text-muted">Thông báo sau khi gửi bill</label>
                                                <textarea name="AfterBillMessage" rows="2" class="form-control premium-input">@qr.AfterBillMessage</textarea>
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label small fw-bold text-muted">Thông báo khi hết thời gian</label>
                                                <textarea name="ExpiredMessage" rows="2" class="form-control premium-input">@qr.ExpiredMessage</textarea>
                                            </div>
                                            <div class="col-12 text-end">
                                                <button type="submit" class="btn-premium rounded-pill px-4">
                                                    <i class="fas fa-save me-2"></i>Lưu cấu hình QR
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: QUẢN LÝ DANH MỤC -->
<div class="modal fade" id="collectionManagerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content premium-modal">
            <div class="modal-header border-0">
