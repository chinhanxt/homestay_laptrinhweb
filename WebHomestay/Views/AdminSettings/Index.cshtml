    .minutes-badge i {
        font-size: 0.75rem;
        opacity: 0.6;
    }

    .minutes-badge .minutes-value {
        min-width: 2.2em;
        display: inline-block;
        text-align: center;
        transition: all 0.2s ease;
    }

    /* Time Picker Styles */
    .time-pick-group {
        display: flex;
        flex-direction: column;
        gap: 12px;
        width: 100%;
    }

    .time-input-wrapper {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #f1f5f9;
        border-radius: 12px;
        padding: 8px 16px;
        width: fit-content;
        border: 1px solid #e2e8f0;
    }

    .time-input-wrapper:focus-within {
        background: white;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }

    .time-icon {
        color: #64748b;
        font-size: 1.1rem;
    }

    .time-picker-input {
        border: none !important;
        background: transparent !important;
        font-weight: 700 !important;
        font-family: monospace;
        font-size: 1.2rem !important;
        color: #1e293b !important;
        padding: 0 !important;
        outline: none !important;
        width: 110px !important;
    }

    .time-hint-alert {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 12px;
        color: #1e40af;
        font-size: 0.8rem;
        font-weight: 600;
        width: 100%;
        box-shadow: 0 2px 4px rgba(59, 130, 246, 0.04);
    }

    .time-hint-alert i {
        font-size: 1rem;
        color: #3b82f6;
    }

    /* Active Toggle Card */
    .template-toggle-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 24px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        transition: all 0.25s ease;
    }

    .template-toggle-card:hover {
        background: white;
        border-color: #10b981;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.08);
    }

    .template-toggle-card .toggle-label {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 0.95rem;
        font-weight: 700;
        color: #334155;
    }

    .template-toggle-card .toggle-label i {
        font-size: 1.25rem;
        color: #10b981;
    }

    .template-toggle-card .form-check-input {
        width: 3.2em;
        height: 1.6em;
        cursor: pointer;
    }

