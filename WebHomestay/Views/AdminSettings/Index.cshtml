        display: flex;
        flex-direction: column;
        justify-content: center;
        overflow: hidden;
    }

    .form-field-card:focus-within {
        background: white;
        border-color: #3b82f6;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12);
        transform: translateY(-1px);
    }

    .form-field-card .admin-form-label {
        margin-bottom: 4px;
        font-size: 0.7rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .form-field-card .admin-form-input {
        padding: 4px 0;
        border: none;
        background: transparent;
        font-size: 1.05rem;
        font-weight: 600;
        color: #1e293b;
        width: 100%;
        outline: none;
        box-shadow: none !important;
    }

    .form-field-card .admin-form-input::placeholder {
        color: #94a3b8;
        font-weight: 500;
    }

    /* Duration Large Input Styles */
    .duration-input-wrapper {
        display: flex;
        align-items: baseline;
        gap: 8px;
    }

    .duration-large-input {
        font-size: 1.6rem !important;
        font-weight: 800 !important;
        color: #2563eb !important;
        width: 80px !important;
        padding: 0 !important;
        outline: none;
        border: none;
        background: transparent;
    }

    .duration-large-input::-webkit-outer-spin-button,
    .duration-large-input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    .duration-large-input {
        -moz-appearance: textfield;
    }

    .duration-unit {
        font-size: 1.05rem;
        font-weight: 700;
        color: #475569;
    }

    .minutes-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #dbeafe;
        color: #1e40af;
        font-weight: 700;
        font-size: 0.75rem;
        padding: 4px 12px;
        border-radius: 9999px;
        white-space: nowrap;
        border: 1px solid rgba(30, 64, 175, 0.08);
        box-shadow: 0 2px 4px rgba(37, 99, 235, 0.06);
