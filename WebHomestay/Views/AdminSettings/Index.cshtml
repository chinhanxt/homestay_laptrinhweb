                                                                             <div class="email-badges-grid">
                                                                                 <button type="button" class="email-placeholder-badge" onclick="insertPlaceholder('editor-approval-body', '{CustomerName}')" title="Tên khách đặt phòng"><i class="fas fa-user"></i> Tên khách</button>
                                                                                 <button type="button" class="email-placeholder-badge" onclick="insertPlaceholder('editor-approval-body', '{BookingId}')" title="Mã đơn hàng/Booking"><i class="fas fa-hashtag"></i> Mã đơn</button>
                                                                                 <button type="button" class="email-placeholder-badge" onclick="insertPlaceholder('editor-approval-body', '{RoomName}')" title="Tên phòng đặt"><i class="fas fa-bed"></i> Tên phòng</button>
                                                                                 <button type="button" class="email-placeholder-badge" onclick="insertPlaceholder('editor-approval-body', '{StartTime}')" title="Ngày nhận phòng"><i class="fas fa-calendar-alt"></i> Ngày nhận</button>
                                                                                 <button type="button" class="email-placeholder-badge" onclick="insertPlaceholder('editor-approval-body', '{EndTime}')" title="Ngày trả phòng"><i class="fas fa-calendar-check"></i> Ngày trả</button>
                                                                                 <button type="button" class="email-placeholder-badge" onclick="insertPlaceholder('editor-approval-body', '{RefundPercent}')" title="Phần trăm tiền hoàn lại"><i class="fas fa-percentage"></i> % Hoàn trả</button>
                                                                                 <button type="button" class="email-placeholder-badge" onclick="insertPlaceholder('editor-approval-body', '{StaffReason}')" title="Lý do từ nhân viên"><i class="fas fa-comment-dots"></i> Lý do duyệt</button>
