</style>



@section Scripts {
    <script>
        function toggleMainSettingsSidebar() {
            $('.premium-settings-wrapper').toggleClass('main-sidebar-collapsed');
        }

        // Tab switching logic (optional, Bootstrap handles mostly)
        document.querySelectorAll('.nav-link').forEach(tab => {
            tab.addEventListener('shown.bs.tab', function (event) {
                // Resize or refresh elements if needed
                if(event.target.id === 'tab-holiday') {
                    renderCalendar();
                }
            });
        });

        // Holiday Calendar Logic
        const holidays = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(holidays.Select(h => new { date = h.Date.ToString("yyyy-MM-dd"), desc = h.Description })));
        let currentMonth = new Date().getMonth();
        let currentYear = new Date().getFullYear();
        let selectedDates = [];

        // Pre-calculated Lunar Holidays for VN (approximate ranges)
        const lunarData = {
            2025: { tet: { s: "2025-01-26", e: "2025-02-03" }, hung: { s: "2025-04-07", e: "2025-04-07" } },
            2026: { tet: { s: "2026-02-14", e: "2026-02-22" }, hung: { s: "2026-04-26", e: "2026-04-26" } },
            2027: { tet: { s: "2027-02-03", e: "2027-02-11" }, hung: { s: "2027-04-16", e: "2027-04-16" } },
            2028: { tet: { s: "2028-01-23", e: "2028-01-31" }, hung: { s: "2028-04-04", e: "2028-04-04" } }
        };

        function getVnHolidays(year) {
            const fixed = [
                { id: 'tet-dl', name: "Tết Dương Lịch", start: `${year}-01-01`, end: `${year}-01-01` },
                { id: 'le-304', name: "Giải phóng & Lao động", start: `${year}-04-30`, end: `${year}-05-01` },
                { id: 'quoc-khanh', name: "Quốc Khánh 02/09", start: `${year}-09-01`, end: `${year}-09-03` }
            ];
            
            const lunar = lunarData[year];
            if (lunar) {
                fixed.push({ id: 'tet-ta', name: "Tết Nguyên Đán", start: lunar.tet.s, end: lunar.tet.e });
                fixed.push({ id: 'hung-vuong', name: "Giỗ tổ Hùng Vương", start: lunar.hung.s, end: lunar.hung.e });
            }
            return fixed;
        }

        function renderCalendar() {
            const daysContainer = document.getElementById('calendarDays');
            if(!daysContainer) return;
            daysContainer.innerHTML = '';
            
            const firstDay = new Date(currentYear, currentMonth, 1);
            const lastDay = new Date(currentYear, currentMonth + 1, 0);
            
            const monthNames = ["THÁNG 01", "THÁNG 02", "THÁNG 03", "THÁNG 04", "THÁNG 05", "THÁNG 06", "THÁNG 07", "THÁNG 08", "THÁNG 09", "THÁNG 10", "THÁNG 11", "THÁNG 12"];
            document.getElementById('currentMonthYear').innerText = `${monthNames[currentMonth]} / ${currentYear}`;
            
            // Update Suggestion UI
            const yearLabel = document.getElementById('suggestionYearLabel');
            if(yearLabel) yearLabel.innerText = currentYear;
            renderSuggestions();

            let startDay = firstDay.getDay();
            startDay = startDay === 0 ? 6 : startDay - 1;

            for (let i = 0; i < startDay; i++) {
                const dayEl = document.createElement('div');
                dayEl.className = 'cal-day other-m';
                daysContainer.appendChild(dayEl);
            }

            const todayDate = new Date();
            const yearHolidays = getVnHolidays(currentYear);

            for (let d = 1; d <= lastDay.getDate(); d++) {
                const dateStr = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
                const h = holidays.find(h => h.date === dateStr);
                const isSel = selectedDates.includes(dateStr);
                
                // Check for VN Holiday Hints
                let isHint = false;
                let hintName = "";
                for (const item of yearHolidays) {
                    if (dateStr >= item.start && dateStr <= item.end) {
                        isHint = true;
                        hintName = item.name;
                        break;
                    }
                }
                
                const dayEl = document.createElement('div');
                dayEl.className = `cal-day ${h ? 'is-h' : ''} ${isSel ? 'sel' : ''} ${isHint ? 'is-vn-hint' : ''}`;
                
                // Add hover title
                if (h) dayEl.title = h.desc;
                else if (isHint) dayEl.title = `Gợi ý: ${hintName}`;

                if (isSel) {

                    const sorted = [...selectedDates].sort();
                    if (sorted.length === 1) dayEl.classList.add('sel-single');
                    else {
                        if (dateStr === sorted[0]) dayEl.classList.add('sel-s');
                        if (dateStr === sorted[sorted.length - 1]) dayEl.classList.add('sel-e');
                    }
                }

                if (todayDate.getFullYear() === currentYear && todayDate.getMonth() === currentMonth && todayDate.getDate() === d) {
                    dayEl.classList.add('is-t');
                }

                dayEl.onclick = () => handleDateClick(dateStr);
                dayEl.innerHTML = `
                    <div class="cal-day-n">${d}</div>
                    ${h ? `<div class="holiday-ribbon"></div><div class="cal-day-d text-danger fw-bold">${h.desc}</div>` : ''}
                    ${isHint && !h ? `<div class="vn-hint-badge">Gợi ý</div>` : ''}
                `;
                daysContainer.appendChild(dayEl);
            }
            updateSelectionBar();
        }

        function jumpToMonth(val) {
            if(!val) return;
            const parts = val.split('-');
            currentYear = parseInt(parts[0]);
            currentMonth = parseInt(parts[1]) - 1;
            renderCalendar();
        }


        function renderSuggestions() {
            const container = document.getElementById('vnSuggestionContainer');
            if(!container) return;
            const yearHolidays = getVnHolidays(currentYear);
            container.innerHTML = yearHolidays.map(h => `
                <button class="btn-suggestion" onclick="quickSelectVN('${h.id}')">${h.name}</button>
            `).join('');
        }

        function quickSelectVN(id) {
            const yearHolidays = getVnHolidays(currentYear);
            const item = yearHolidays.find(h => h.id === id);
            if (!item) return;

            // Jump to correct month/year
            const start = new Date(item.start);
            currentYear = start.getFullYear();
            currentMonth = start.getMonth();

            // Select range
            selectedDates = [];
            const end = new Date(item.end);
            for (let d = new Date(item.start); d <= end; d.setDate(d.getDate() + 1)) {
                selectedDates.push(d.toISOString().split('T')[0]);
            }

            renderCalendar();
            
            // Auto-open modal with description
            document.querySelector('input[name="description"]').value = item.name;
        }



        function handleDateClick(dateStr) {
            if (selectedDates.includes(dateStr)) {
                selectedDates = selectedDates.filter(d => d !== dateStr);
            } else {
                selectedDates.push(dateStr);
                if (selectedDates.length >= 2) {
                    const sorted = selectedDates.map(d => new Date(d)).sort((a, b) => a - b);
                    const newSelection = [];
                    for (let d = new Date(sorted[0]); d <= sorted[sorted.length-1]; d.setDate(d.getDate() + 1)) {
                        newSelection.push(d.toISOString().split('T')[0]);
                    }
                    selectedDates = newSelection;
                }
            }
            renderCalendar();
        }

        function updateSelectionBar() {
            const bar = document.getElementById('selectionBar');
            if(!bar) return;
            if (selectedDates.length > 0) {
                bar.style.display = 'flex';
                const sorted = [...selectedDates].sort();
                const start = sorted[0].split('-').reverse().join('/');
                const end = sorted[sorted.length-1].split('-').reverse().join('/');
                document.getElementById('selectionText').innerText = selectedDates.length === 1 ? start : `${start} đến ${end} (${selectedDates.length} ngày)`;
                document.getElementById('modalStartDate').value = sorted[0];
                document.getElementById('modalEndDate').value = sorted[sorted.length-1];
            } else {
                bar.style.display = 'none';
            }
        }

        function clearSelection() {
            selectedDates = [];
            renderCalendar();
        }

        function changeMonth(delta) {
            currentMonth += delta;
            if (currentMonth > 11) { currentMonth = 0; currentYear++; }
            if (currentMonth < 0) { currentMonth = 11; currentYear--; }
            renderCalendar();
        }

        function today() {
            currentMonth = new Date().getMonth();
            currentYear = new Date().getFullYear();
            renderCalendar();
        }

        function toggleGroup(header) {
            const details = header.nextElementSibling;
            const arrow = header.querySelector('.group-arrow');
            const isVisible = details.style.display === 'block';
            
            details.style.display = isVisible ? 'none' : 'block';
            arrow.style.transform = isVisible ? 'rotate(0deg)' : 'rotate(90deg)';
        }

        function toggleQrBranch(header) {
            const body = header.nextElementSibling;
            const icon = header.querySelector('.qr-toggle-icon');
            body.classList.toggle('is-open');
            icon.classList.toggle('is-open');
        }

        // Hours → minutes conversion helpers
        function syncDurationPreview(hoursInput, hiddenMinutes, previewEl) {
            const h = parseFloat(hoursInput.value) || 0;
            const m = Math.round(h * 60);
            hiddenMinutes.value = m;
            previewEl.textContent = m;
        }

        document.getElementById('create-duration-hours').addEventListener('input', function () {
            syncDurationPreview(this, document.getElementById('durationMinutesHidden'), document.getElementById('durationPreview'));
        });
        const createForm = document.querySelector('#createTemplateModal form');
        if (createForm) {
            createForm.addEventListener('submit', function () {
                syncDurationPreview(
                    document.getElementById('create-duration-hours'),
                    document.getElementById('durationMinutesHidden'),
                    document.getElementById('durationPreview')
                );
            });
        }

        // Time Template Helper
        function openEditTemplateModal(id, name, code, duration, cleanup, seed, isActive) {
            document.getElementById('edit-id').value = id;
            document.getElementById('edit-name').value = name;
            document.getElementById('edit-code').value = code;
            const hours = duration / 60;
            document.getElementById('edit-duration-hours').value = hours;
            document.getElementById('edit-duration').value = duration;
            document.getElementById('editDurationPreview').textContent = duration;
            document.getElementById('edit-cleanup').value = cleanup;
            document.getElementById('edit-seed').value = seed;
            document.getElementById('edit-active').checked = isActive;
            
            new bootstrap.Modal(document.getElementById('editTemplateModal')).show();
        }

        document.getElementById('edit-duration-hours').addEventListener('input', function () {
            syncDurationPreview(this, document.getElementById('edit-duration'), document.getElementById('editDurationPreview'));
        });
        const editForm = document.querySelector('#editTemplateModal form');
        if (editForm) {
            editForm.addEventListener('submit', function () {
                syncDurationPreview(
                    document.getElementById('edit-duration-hours'),
                    document.getElementById('edit-duration'),
                    document.getElementById('editDurationPreview')
                );
            });
        }

        // Handle tab selection from URL
        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const tabParam = urlParams.get('tab');
            if (tabParam) {
                const tabMap = {
                    'ops': 'tab-ops',
                    'time': 'tab-time',
                    'holiday': 'tab-holiday',
                    'branch': 'tab-branch',
                    'payment-qr': 'tab-payment-qr'
                };
                const tabId = tabMap[tabParam];
                if (tabId) {
                    const triggerEl = document.querySelector(`#${tabId}`);
                    if (triggerEl) {
                        bootstrap.Tab.getOrCreateInstance(triggerEl).show();
                    }
                }
            }
        });

        // Initialize calendar if holiday tab is active on load
        if(document.getElementById('tab-holiday')?.classList.contains('active')) {
            renderCalendar();
        }

        // Auto-hide toast
        setTimeout(() => {
            const toast = document.getElementById('temp-toast');
            if(toast) toast.classList.remove('show');
        }, 3000);
    </script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="~/js/admin-ai-hub.js" asp-append-version="true"></script>
}

