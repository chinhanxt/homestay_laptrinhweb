                                                                 <i class="fas fa-check-circle me-1"></i> Chấp nhận hủy
                                                             </button>
                                                         </li>
                                                         <li class="nav-item" role="presentation">
                                                             <button class="nav-link fw-bold px-3 py-1-5 border-0 rounded-3 text-danger bg-danger-light" id="email-rejection-tab" data-bs-toggle="tab" data-bs-target="#email-rejection-pane" type="button" role="tab" aria-controls="email-rejection-pane" aria-selected="false">
                                                                 <i class="fas fa-times-circle me-1"></i> Từ chối hủy
                                                             </button>
                                                         </li>
                                                     </ul>
                                                 </div>
                                             </div>
                                             <div class="card-body p-4 bg-white">
                                                 <div class="tab-content" id="email-template-tabs-content">
                                                     <!-- TAB 1: CHẤP NHẬN HỦY -->
                                                     <div class="tab-pane fade show active" id="email-approval-pane" role="tabpanel" aria-labelledby="email-approval-tab">
