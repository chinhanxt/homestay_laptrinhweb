@section Scripts {
    <script>
        function toggleMainSettingsSidebar() {
            $('.premium-settings-wrapper').toggleClass('main-sidebar-collapsed');
        }

        function toggleTrashPanel(panel) {
            if (panel === 'time') {
                $('#active-templates-section').toggleClass('d-none');
                $('#trash-templates-section').toggleClass('d-none');
                $('#trash-info-time').toggleClass('d-none');
                $('[data-panel="time"] span').text(
                    $('#active-templates-section').hasClass('d-none') ? 'Đang xem' : 'Thùng rác'
                );
            } else if (panel === 'holiday') {
                $('#active-holidays-section').toggleClass('d-none');
                $('#trash-holidays-section').toggleClass('d-none');
                $('#trash-info-holiday').toggleClass('d-none');
                $('[data-panel="holiday"] span').text(
                    $('#active-holidays-section').hasClass('d-none') ? 'Đang xem' : 'Thùng rác'
                );
            }
        }

        // Tab switching logic (optional, Bootstrap handles mostly)
        document.querySelectorAll('#settings-tabs .nav-link, #email-template-tabs .nav-link').forEach(tab => {
            tab.addEventListener('shown.bs.tab', function (event) {
                // Resize or refresh elements if needed
                if(event.target.id === 'tab-holiday') {
                    renderCalendar();
                }
            });
        });

        // Holiday Calendar Logic
        const holidays = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(holidays.Select(h => new { date = h.Date.ToString("yyyy-MM-dd"), desc = h.Description })));
        let currentMonth = new Date().getMonth();
        let currentYear = new Date().getFullYear();
        let selectedDates = [];

        // Pre-calculated Lunar Holidays for VN (approximate ranges)
        const lunarData = {
            2025: { tet: { s: "2025-01-26", e: "2025-02-03" }, hung: { s: "2025-04-07", e: "2025-04-07" } },
            2026: { tet: { s: "2026-02-14", e: "2026-02-22" }, hung: { s: "2026-04-26", e: "2026-04-26" } },
            2027: { tet: { s: "2027-02-03", e: "2027-02-11" }, hung: { s: "2027-04-16", e: "2027-04-16" } },
            2028: { tet: { s: "2028-01-23", e: "2028-01-31" }, hung: { s: "2028-04-04", e: "2028-04-04" } }
        };

        function getVnHolidays(year) {
            const fixed = [
                { id: 'tet-dl', name: "Tết Dương Lịch", start: `${year}-01-01`, end: `${year}-01-01` },
                { id: 'le-304', name: "Giải phóng & Lao động", start: `${year}-04-30`, end: `${year}-05-01` },
                { id: 'quoc-khanh', name: "Quốc Khánh 02/09", start: `${year}-09-01`, end: `${year}-09-03` }
            ];
            
            const lunar = lunarData[year];
            if (lunar) {
                fixed.push({ id: 'tet-ta', name: "Tết Nguyên Đán", start: lunar.tet.s, end: lunar.tet.e });
                fixed.push({ id: 'hung-vuong', name: "Giỗ tổ Hùng Vương", start: lunar.hung.s, end: lunar.hung.e });
            }
            return fixed;
        }

        function renderCalendar() {
            const daysContainer = document.getElementById('calendarDays');
            if(!daysContainer) return;
            daysContainer.innerHTML = '';
            
            const firstDay = new Date(currentYear, currentMonth, 1);
            const lastDay = new Date(currentYear, currentMonth + 1, 0);
            
            const monthNames = ["THÁNG 01", "THÁNG 02", "THÁNG 03", "THÁNG 04", "THÁNG 05", "THÁNG 06", "THÁNG 07", "THÁNG 08", "THÁNG 09", "THÁNG 10", "THÁNG 11", "THÁNG 12"];
            document.getElementById('currentMonthYear').innerText = `${monthNames[currentMonth]} / ${currentYear}`;
            
            // Update Suggestion UI
            const yearLabel = document.getElementById('suggestionYearLabel');
            if(yearLabel) yearLabel.innerText = currentYear;
            renderSuggestions();

            let startDay = firstDay.getDay();
            startDay = startDay === 0 ? 6 : startDay - 1;

            for (let i = 0; i < startDay; i++) {
                const dayEl = document.createElement('div');
                dayEl.className = 'cal-day other-m';
                daysContainer.appendChild(dayEl);
            }

            const todayDate = new Date();
            const yearHolidays = getVnHolidays(currentYear);

            for (let d = 1; d <= lastDay.getDate(); d++) {
                const dateStr = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
                const h = holidays.find(h => h.date === dateStr);
                const isSel = selectedDates.includes(dateStr);
                
                // Check for VN Holiday Hints
                let isHint = false;
                let hintName = "";
                for (const item of yearHolidays) {
                    if (dateStr >= item.start && dateStr <= item.end) {
                        isHint = true;
                        hintName = item.name;
                        break;
                    }
                }
                
                const dayEl = document.createElement('div');
                dayEl.className = `cal-day ${h ? 'is-h' : ''} ${isSel ? 'sel' : ''} ${isHint ? 'is-vn-hint' : ''}`;
                
                // Add hover title
                if (h) dayEl.title = h.desc;
                else if (isHint) dayEl.title = `Gợi ý: ${hintName}`;

                if (isSel) {

                    const sorted = [...selectedDates].sort();
                    if (sorted.length === 1) dayEl.classList.add('sel-single');
                    else {
                        if (dateStr === sorted[0]) dayEl.classList.add('sel-s');
                        if (dateStr === sorted[sorted.length - 1]) dayEl.classList.add('sel-e');
                    }
                }

                if (todayDate.getFullYear() === currentYear && todayDate.getMonth() === currentMonth && todayDate.getDate() === d) {
                    dayEl.classList.add('is-t');
                }

                dayEl.onclick = () => handleDateClick(dateStr);
                dayEl.innerHTML = `
                    <div class="cal-day-n">${d}</div>
                    ${h ? `<div class="holiday-ribbon"></div><div class="cal-day-d text-danger fw-bold">${h.desc}</div>` : ''}
                    ${isHint && !h ? `<div class="vn-hint-badge">Gợi ý</div>` : ''}
                `;
                daysContainer.appendChild(dayEl);
            }
            updateSelectionBar();
        }

        function jumpToMonth(val) {
            if(!val) return;
            const parts = val.split('-');
            currentYear = parseInt(parts[0]);
            currentMonth = parseInt(parts[1]) - 1;
            renderCalendar();
        }


        function renderSuggestions() {
            const container = document.getElementById('vnSuggestionContainer');
            if(!container) return;
            const yearHolidays = getVnHolidays(currentYear);
            container.innerHTML = yearHolidays.map(h => `
                <button class="btn-suggestion" onclick="quickSelectVN('${h.id}')">${h.name}</button>
            `).join('');
        }

        function quickSelectVN(id) {
            const yearHolidays = getVnHolidays(currentYear);
            const item = yearHolidays.find(h => h.id === id);
            if (!item) return;

            // Jump to correct month/year
            const start = new Date(item.start);
            currentYear = start.getFullYear();
            currentMonth = start.getMonth();

            // Select range
            selectedDates = [];
            const end = new Date(item.end);
            for (let d = new Date(item.start); d <= end; d.setDate(d.getDate() + 1)) {
                selectedDates.push(d.toISOString().split('T')[0]);
            }

            renderCalendar();
            
            // Auto-open modal with description
            document.querySelector('input[name="description"]').value = item.name;
        }



        function handleDateClick(dateStr) {
            if (selectedDates.includes(dateStr)) {
                selectedDates = selectedDates.filter(d => d !== dateStr);
            } else {
                selectedDates.push(dateStr);
                if (selectedDates.length >= 2) {
                    const sorted = selectedDates.map(d => new Date(d)).sort((a, b) => a - b);
                    const newSelection = [];
                    for (let d = new Date(sorted[0]); d <= sorted[sorted.length-1]; d.setDate(d.getDate() + 1)) {
                        newSelection.push(d.toISOString().split('T')[0]);
                    }
                    selectedDates = newSelection;
                }
            }
            renderCalendar();
        }

        function updateSelectionBar() {
            const bar = document.getElementById('selectionBar');
            if(!bar) return;
            if (selectedDates.length > 0) {
                bar.style.display = 'flex';
                const sorted = [...selectedDates].sort();
                const start = sorted[0].split('-').reverse().join('/');
                const end = sorted[sorted.length-1].split('-').reverse().join('/');
                document.getElementById('selectionText').innerText = selectedDates.length === 1 ? start : `${start} đến ${end} (${selectedDates.length} ngày)`;
                document.getElementById('modalStartDate').value = sorted[0];
                document.getElementById('modalEndDate').value = sorted[sorted.length-1];
            } else {
                bar.style.display = 'none';
            }
        }

        function clearSelection() {
            selectedDates = [];
            renderCalendar();
        }

        function changeMonth(delta) {
            currentMonth += delta;
            if (currentMonth > 11) { currentMonth = 0; currentYear++; }
            if (currentMonth < 0) { currentMonth = 11; currentYear--; }
            renderCalendar();
        }

        function today() {
            currentMonth = new Date().getMonth();
            currentYear = new Date().getFullYear();
            renderCalendar();
        }

        function toggleGroup(header) {
            const details = header.nextElementSibling;
            const arrow = header.querySelector('.group-arrow');
            const isVisible = details.style.display === 'block';
            
            details.style.display = isVisible ? 'none' : 'block';
            arrow.style.transform = isVisible ? 'rotate(0deg)' : 'rotate(90deg)';
        }

        function toggleQrBranch(header) {
            const body = header.nextElementSibling;
            const icon = header.querySelector('.qr-toggle-icon');
            body.classList.toggle('is-open');
            icon.classList.toggle('is-open');
        }

        // Hours → minutes conversion helpers
        function syncDurationPreview(hoursInput, hiddenMinutes, previewEl) {
            const h = parseFloat(hoursInput.value) || 0;
            const m = Math.round(h * 60);
            hiddenMinutes.value = m;
            previewEl.textContent = m;
        }

        const createDurationInput = document.getElementById('create-duration-hours');
        if (createDurationInput) {
            createDurationInput.addEventListener('input', function () {
                syncDurationPreview(this, document.getElementById('durationMinutesHidden'), document.getElementById('durationPreview'));
            });
        }
        const createForm = document.querySelector('#createTemplateModal form');
        if (createForm) {
            createForm.addEventListener('submit', function () {
                const hoursInput = document.getElementById('create-duration-hours');
                const minutesHidden = document.getElementById('durationMinutesHidden');
                const previewEl = document.getElementById('durationPreview');
                if (hoursInput && minutesHidden && previewEl) {
                    syncDurationPreview(hoursInput, minutesHidden, previewEl);
                }
            });
        }

        // Time Template Helper
        function openEditTemplateModal(id, name, code, duration, cleanup, seed, isActive) {
            document.getElementById('edit-id').value = id;
            document.getElementById('edit-name').value = name;
            document.getElementById('edit-code').value = code;
            const hours = duration / 60;
            document.getElementById('edit-duration-hours').value = hours;
            document.getElementById('edit-duration').value = duration;
            document.getElementById('editDurationPreview').textContent = duration;
            document.getElementById('edit-cleanup').value = cleanup;
            document.getElementById('edit-seed').value = seed;
            document.getElementById('edit-active').checked = isActive;
            
            new bootstrap.Modal(document.getElementById('editTemplateModal')).show();
        }

        const editDurationInput = document.getElementById('edit-duration-hours');
        if (editDurationInput) {
            editDurationInput.addEventListener('input', function () {
                syncDurationPreview(this, document.getElementById('edit-duration'), document.getElementById('editDurationPreview'));
            });
        }
        const editForm = document.querySelector('#editTemplateModal form');
        if (editForm) {
            editForm.addEventListener('submit', function () {
                const hoursInput = document.getElementById('edit-duration-hours');
                const minutesHidden = document.getElementById('edit-duration');
                const previewEl = document.getElementById('editDurationPreview');
                if (hoursInput && minutesHidden && previewEl) {
                    syncDurationPreview(hoursInput, minutesHidden, previewEl);
                }
            });
        }

        // Handle tab selection from URL
        window.addEventListener('DOMContentLoaded', () => {
            if (window.location.hash === '#') {
                history.replaceState(null, '', `${window.location.pathname}${window.location.search}`);
            }

            const urlParams = new URLSearchParams(window.location.search);
            const tabParam = urlParams.get('tab');
            if (tabParam) {
                const tabMap = {
                    'ops': 'tab-ops',
                    'time': 'tab-time',
                    'holiday': 'tab-holiday',
                    'branch': 'tab-branch',
                    'payment-qr': 'tab-payment-qr',
                    'import': 'tab-import'
                };
                const tabId = tabMap[tabParam];
                if (tabId) {
                    const triggerEl = document.querySelector(`#${tabId}`);
                    if (triggerEl) {
                        bootstrap.Tab.getOrCreateInstance(triggerEl).show();
                    }
                }
            }
        });

        // Initialize calendar if holiday tab is active on load
        const tabHoliday = document.getElementById('tab-holiday');
        if (tabHoliday && tabHoliday.classList.contains('active')) {
            renderCalendar();
        }

        // Auto-hide toast
        setTimeout(() => {
            const toast = document.getElementById('temp-toast');
            if(toast) toast.classList.remove('show');
        }, 3000);

        // --- Cấu hình Email Hủy phòng Redesign Logic ---
        
        // Chèn biến tại vị trí con trỏ
        window.insertPlaceholder = function(editorId, placeholder) {
            const txtarea = document.getElementById(editorId);
            if (!txtarea) return;
            
            const scrollPos = txtarea.scrollTop;
            let strPos = 0;
            const br = ((txtarea.selectionStart || txtarea.selectionStart == '0') ? "ff" : (document.selection ? "ie" : false));
            
            if (br == "ie") {
                txtarea.focus();
                const range = document.selection.createRange();
                range.moveStart('character', -txtarea.value.length);
                strPos = range.text.length;
            } else if (br == "ff") {
                strPos = txtarea.selectionStart;
            }
            
            const front = (txtarea.value).substring(0, strPos);
            const back = (txtarea.value).substring(strPos, txtarea.value.length);
            txtarea.value = front + placeholder + back;
            strPos = strPos + placeholder.length;
            
            if (br == "ie") {
                txtarea.focus();
                const ieRange = document.selection.createRange();
                ieRange.moveStart('character', -txtarea.value.length);
                ieRange.moveStart('character', strPos);
                ieRange.moveEnd('character', 0);
                ieRange.select();
            } else if (br == "ff") {
                txtarea.selectionStart = strPos;
                txtarea.selectionEnd = strPos;
                txtarea.focus();
            }
            
            txtarea.scrollTop = scrollPos;
            
            // Kích hoạt sự kiện input để đồng bộ và cập nhật preview
            const event = new Event('input', { bubbles: true });
            txtarea.dispatchEvent(event);
        };

        // Xem trước email động và đồng bộ vào hidden input
        window.updateEmailPreview = function(editorId, previewElId, subjectInputId, previewSubjectId, realBodyId) {
            const editor = document.getElementById(editorId);
            const previewEl = document.getElementById(previewElId);
            const subjectInput = document.getElementById(subjectInputId);
            const previewSubject = document.getElementById(previewSubjectId);
            const realBody = document.getElementById(realBodyId);
            
            if (!editor) return;
            
            const cleanValue = editor.value;
            
            // Chuyển đổi \n thành <br> cho trường ẩn (để gửi lên backend lưu DB)
            if (realBody) {
                realBody.value = cleanValue.replace(/\n/g, '<br>');
            }
            
            // Xem trước tiêu đề
            if (subjectInput && previewSubject) {
                previewSubject.textContent = subjectInput.value || "(Chưa nhập tiêu đề email)";
            }
            
            if (!previewEl) return;
            
            // Xử lý ký tự HTML trong preview để tránh lỗi hiển thị
            let escaped = cleanValue
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
                
            // Dữ liệu mẫu thay thế biến trong preview
            const mocks = {
                '{CustomerName}': 'Nguyễn Văn A',
                '{BookingId}': 'BK-10294',
                '{RoomName}': 'Phòng 302 - Premium Ocean Suite',
                '{StartTime}': '14:00 ngày 15/06/2026',
                '{EndTime}': '12:00 ngày 18/06/2026',
                '{RefundPercent}': '50',
                '{StaffReason}': 'Khách có việc gia đình đột xuất',
                '{PolicyMessage}': 'Được hoàn trả 50% tiền cọc theo quy định chính sách hủy trước 24 giờ.'
            };
            
            for (const [key, value] of Object.entries(mocks)) {
                escaped = escaped.split(key).join(`<span class="preview-highlight-badge">${value}</span>`);
            }
            
            // Chuyển xuống dòng \n thành <br> hiển thị trong HTML preview
            const html = escaped.replace(/\n/g, "<br>");
            
            previewEl.innerHTML = html || `<span class="text-muted italic">Chưa nhập nội dung email...</span>`;
        };

        // Khi load trang: Chuyển dữ liệu có sẵn từ database (<br> thành \n) đưa vào editor
        const realAppBody = document.getElementById('real-approval-body');
        const editorAppBody = document.getElementById('editor-approval-body');
        const appSubject = document.getElementById('approval-email-subject');
        
        if (realAppBody && editorAppBody) {
            editorAppBody.value = realAppBody.value.replace(/<br\s*\/?>/gi, '\n');
            
            // Vẽ preview lần đầu
            window.updateEmailPreview('editor-approval-body', 'preview-approval-body', 'approval-email-subject', 'preview-approval-subject', 'real-approval-body');
            
            // Lắng nghe thay đổi
            editorAppBody.addEventListener('input', function() {
                window.updateEmailPreview('editor-approval-body', 'preview-approval-body', 'approval-email-subject', 'preview-approval-subject', 'real-approval-body');
            });
            
            if (appSubject) {
                appSubject.addEventListener('input', function() {
                    window.updateEmailPreview('editor-approval-body', 'preview-approval-body', 'approval-email-subject', 'preview-approval-subject', 'real-approval-body');
                });
            }
        }
        
        const realRejBody = document.getElementById('real-rejection-body');
        const editorRejBody = document.getElementById('editor-rejection-body');
        const rejSubject = document.getElementById('rejection-email-subject');
        
        if (realRejBody && editorRejBody) {
            editorRejBody.value = realRejBody.value.replace(/<br\s*\/?>/gi, '\n');
            
            // Vẽ preview lần đầu
            window.updateEmailPreview('editor-rejection-body', 'preview-rejection-body', 'rejection-email-subject', 'preview-rejection-subject', 'real-rejection-body');
            
            // Lắng nghe thay đổi
            editorRejBody.addEventListener('input', function() {
                window.updateEmailPreview('editor-rejection-body', 'preview-rejection-body', 'rejection-email-subject', 'preview-rejection-subject', 'real-rejection-body');
            });
            
            if (rejSubject) {
                rejSubject.addEventListener('input', function() {
                    window.updateEmailPreview('editor-rejection-body', 'preview-rejection-body', 'rejection-email-subject', 'preview-rejection-subject', 'real-rejection-body');
                });
            }
        }

        // Payment QR Settings Live Preview & Helpers
        window.updateCardText = function(input, previewClass) {
            const parentForm = input.closest('form');
            if (!parentForm) return;
            const target = parentForm.querySelector(previewClass);
            if (!target) return;
            
            let val = input.value.trim();
            if (previewClass === '.preview-bank-code' || previewClass === '.preview-bank-name') {
                val = val.toUpperCase();
            }
            
            if (!val) {
                if (previewClass === '.preview-bank-code') val = "CHƯA CẤU HÌNH";
                else if (previewClass === '.preview-bank-acc') val = "•••• •••• ••••";
                else if (previewClass === '.preview-bank-name') val = "CHƯA CẤU HÌNH";
            }
            target.textContent = val;
            
            // Auto update representation box
            window.updateDynamicQRState(parentForm);
        };

        window.previewUploadImage = function(input) {
            const parentForm = input.closest('form');
            if (!parentForm) return;
            const qrPreviewBox = parentForm.querySelector('.qr-preview-box');
            if (!qrPreviewBox) return;
            
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    qrPreviewBox.innerHTML = 
                        '<div class="qr-preview-wrapper position-relative p-2 bg-white border rounded-3 shadow-sm d-inline-block">' +
                            '<img src="' + e.target.result + '" alt="Preview" class="img-fluid" style="max-height: 180px; object-fit: contain;" />' +
                        '</div>' +
                        '<div class="text-success small fw-semibold"><i class="fas fa-check-circle me-1"></i> Ảnh QR vừa được chọn (nhấn Lưu để cập nhật)</div>';
                };
                reader.readAsDataURL(input.files[0]);
            }
        };

        window.updateQRPreview = function(input) {
            const parentForm = input.closest('form');
            if (!parentForm) return;
            const qrPreviewBox = parentForm.querySelector('.qr-preview-box');
            if (!qrPreviewBox) return;
            
            const val = input.value.trim();
            if (val) {
                qrPreviewBox.innerHTML = 
                    '<div class="qr-preview-wrapper position-relative p-2 bg-white border rounded-3 shadow-sm d-inline-block">' +
                        '<img src="' + val + '" alt="Preview URL" class="img-fluid" style="max-height: 180px; object-fit: contain;" onerror="window.handleQRPreviewError(this)" />' +
                    '</div>' +
                    '<div class="text-success small fw-semibold"><i class="fas fa-check-circle me-1"></i> Đường dẫn ảnh QR thụ hưởng (nhấn Lưu để cập nhật)</div>';
            } else {
                window.updateDynamicQRState(parentForm);
            }
        };

        window.handleQRPreviewError = function(img) {
            const wrapper = img.closest('.qr-preview-box');
            if (wrapper) {
                wrapper.innerHTML = 
                    '<div class="text-danger small py-4 px-3 text-center d-flex flex-column align-items-center justify-content-center">' +
                        '<i class="fas fa-times-circle fs-3 mb-2"></i>' +
                        '<span>Không thể tải ảnh từ URL này.</span>' +
                    '</div>';
            }
        };

        window.updateDynamicQRState = function(parentForm) {
            const fileInput = parentForm.querySelector('input[name="qrImage"]');
            if (fileInput && fileInput.files && fileInput.files[0]) {
                return;
            }
            
            const urlInput = parentForm.querySelector('input[name="QrImageUrl"]');
            if (urlInput && urlInput.value.trim()) {
                return;
            }
            
            const qrPreviewBox = parentForm.querySelector('.qr-preview-box');
            if (!qrPreviewBox) return;
            
            const bankCodeInput = parentForm.querySelector('input[name="BankCode"]');
            const bankAccInput = parentForm.querySelector('input[name="BankAccountNumber"]');
            
            const bankCode = bankCodeInput ? bankCodeInput.value.trim() : "";
            const bankAcc = bankAccInput ? bankAccInput.value.trim() : "";
            
            if (bankCode && bankAcc) {
                qrPreviewBox.innerHTML = 
                    '<div class="vietqr-placeholder-graphic position-relative p-3 bg-slate-50 border border-slate-200 rounded-3 shadow-sm text-center d-flex flex-column align-items-center justify-content-center" style="width: 170px; height: 170px;">' +
                        '<i class="fas fa-qrcode text-slate-300 fs-1 mb-2"></i>' +
                        '<span class="text-slate-400 fs-8 fw-semibold text-uppercase">MÃ VIETQR ĐỘNG</span>' +
                        '<span class="text-slate-500 extra-small">Tự động tạo khi xuất hóa đơn</span>' +
                        '<div class="position-absolute" style="top: 8px; left: 8px; width: 16px; height: 16px; border-top: 3px solid var(--admin-primary); border-left: 3px solid var(--admin-primary);"></div>' +
                        '<div class="position-absolute" style="top: 8px; right: 8px; width: 16px; height: 16px; border-top: 3px solid var(--admin-primary); border-right: 3px solid var(--admin-primary);"></div>' +
                        '<div class="position-absolute" style="bottom: 8px; left: 8px; width: 16px; height: 16px; border-bottom: 3px solid var(--admin-primary); border-left: 3px solid var(--admin-primary);"></div>' +
                        '<div class="position-absolute" style="bottom: 8px; right: 8px; width: 16px; height: 16px; border-bottom: 3px solid var(--admin-primary); border-right: 3px solid var(--admin-primary);"></div>' +
                    '</div>' +
                    '<div class="text-primary small fw-semibold"><i class="fas fa-magic me-1"></i> Tự động tạo VietQR theo tài khoản ngân hàng</div>';
            } else {
                qrPreviewBox.innerHTML = 
                    '<div class="text-muted small py-4 px-3 text-center d-flex flex-column align-items-center justify-content-center">' +
                        '<i class="fas fa-exclamation-triangle text-warning fs-3 mb-2"></i>' +
                        '<span>Chưa có ảnh QR hoặc thông tin ngân hàng thụ hưởng.</span>' +
                    '</div>';
            }
        };

