@{
    Layout = "_Layout";
    ViewData["Title"] = "AI Brain Center";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-ai-brain-center.css" asp-append-version="true" />
}

<div class="brain-page">
    <section class="brain-section">
        <ul class="nav nav-pills brain-tabs" id="brainIdeaTabs" role="tablist">
            <li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tab-overview" type="button">Tổng quan</button></li>
            <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-knowledge-graph" type="button">Tri thức & Graph</button></li>
            <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-response-form" type="button" onclick="loadFinalSynthesizerConfig(); loadBookingFormConfig();">Trả lời & Form</button></li>
            <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-test-trace" type="button" onclick="loadBrainConversationTraces()">Test & Trace</button></li>
        </ul>
        <div class="tab-content brain-tab-content">
            <div class="tab-pane fade show active" id="tab-overview">
                <div class="brain-manager-toolbar"><div><h3>AI Booking Flow</h3><p>Luồng AI bán phòng gồm 6 bước. LLM chỉ tổng hợp câu trả lời; dữ liệu phòng, giá, slot và booking lấy từ hệ thống thật.</p></div></div>
                <div class="compact-agent-grid">
                    <article><strong>1. Input Context</strong><span>Tên, chi nhánh, kiểu thuê, số người, tin nhắn.</span></article><article><strong>2. Intent & Memory</strong><span>Hiểu nhu cầu và giữ state trong session.</span></article><article><strong>3. Live Availability</strong><span>Đọc phòng, giá, slot/ngày trống từ DB.</span></article><article><strong>4. Knowledge RAG</strong><span>Lấy chính sách, nội quy, sales script.</span></article><article><strong>5. Graph Reasoning</strong><span>Suy luận quan hệ phòng, tiện nghi, persona.</span></article><article><strong>6. Final Synthesizer</strong><span>Viết câu trả lời và trả UI blocks.</span></article>
                </div>
            </div>
            <div class="tab-pane fade" id="tab-knowledge-graph"><div class="compact-two-stack"><section class="compact-panel" id="compact-knowledge-panel">
                <div class="brain-manager-toolbar"><div><h3>Ngân hàng kiến thức AI</h3><p>Đây là nơi nạp tri thức mềm cho RAG Agent: sales script, chính sách, nội quy, hướng dẫn và cách tư vấn.</p></div><div class="d-flex gap-2 flex-wrap"><button class="btn btn-outline-primary rounded-pill fw-bold" onclick="loadBrainKnowledge()"><i class="fas fa-rotate me-2"></i>Tải lại</button><button class="btn btn-primary rounded-pill fw-bold" onclick="openKnowledgeEditor()"><i class="fas fa-plus me-2"></i>Thêm Knowledge</button></div></div>
                <div class="brain-bank-layout"><div class="brain-bank-sidebar"><div class="d-flex justify-content-between align-items-center mb-3"><strong>Scopes</strong><button class="btn btn-sm btn-light border" onclick="openScopeEditor()"><i class="fas fa-plus"></i></button></div><div id="brain-scope-list" class="brain-bank-list"></div></div><div class="brain-bank-main"><div id="brain-knowledge-list" class="brain-card-list"><div class="empty-state">Bấm “Tải lại” để xem ngân hàng kiến thức.</div></div></div></div>
            </section><section class="compact-panel" id="compact-graph-panel">
                <div class="brain-manager-toolbar"><div><h3>Graph quan hệ AI</h3><p>Graph mô tả quan hệ giữa chi nhánh, phòng, persona, chính sách và tình huống để AI suy luận có cấu trúc.</p></div><div class="d-flex gap-2 flex-wrap"><div class="btn-group rounded-pill overflow-hidden" role="group"><button class="btn btn-outline-dark fw-bold" onclick="setGraphViewMode('cards')"><i class="fas fa-table-cells-large me-2"></i>Card</button><button class="btn btn-outline-dark fw-bold" onclick="setGraphViewMode('network')"><i class="fas fa-circle-nodes me-2"></i>Node View</button></div><button class="btn btn-outline-primary rounded-pill fw-bold" onclick="loadBrainGraph()"><i class="fas fa-rotate me-2"></i>Tải lại</button><button class="btn btn-primary rounded-pill fw-bold" onclick="openGraphNodeEditor()"><i class="fas fa-circle-plus me-2"></i>Thêm Node</button><button class="btn btn-dark rounded-pill fw-bold" onclick="openGraphEdgeEditor()"><i class="fas fa-link me-2"></i>Thêm Edge</button></div></div>
                <div id="graph-card-mode" class="graph-manager-grid"><div><h4>Nodes</h4><div id="brain-graph-nodes" class="brain-card-list"></div></div><div><h4>Edges</h4><div id="brain-graph-edges" class="brain-card-list"></div></div></div><div id="graph-network-mode" class="graph-network-mode" style="display:none;"><svg id="brain-graph-network" viewBox="0 0 1200 620" preserveAspectRatio="xMidYMid meet"></svg></div>
            </section></div></div>
            <div class="tab-pane fade" id="tab-response-form"><div class="final-synth-grid">
                            <div class="final-config-card">
                                <div class="agent-test-info mb-3">
                                    <div class="agent-test-icon"><i class="fas fa-wand-magic-sparkles"></i></div>
                                    <div>
                                        <h3>Final Response Synthesizer</h3>
                                        <p>Agent này phụ trách phong cách trả lời cuối cùng cho khách và quyết định có hiển thị form thu thập thông tin hay không.</p>
                                        <div class="agent-function-note">
                                            <span>Chức năng: nhận persona, live snapshot, knowledge, graph, guard và viết câu trả lời cuối cùng.</span>
                                            <span>Cấu hình ở đây sẽ được đưa vào system prompt, không cần hard-code lại trong code.</span>
                                        </div>
                                    </div>
                                </div>
                                <label class="form-label fw-bold">Phong cách trả lời tự do</label>
                                <textarea id="final-style-config" class="form-control final-style-text" rows="5" placeholder="VD: Trả lời thân thiện, ngắn gọn, như lễ tân chuyên nghiệp..."></textarea>
                                <div class="accordion mt-4" id="finalSystemPromptAccordion">
                                    <div class="accordion-item border-0 rounded-4 overflow-hidden">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#final-system-prompts">
                                                System Prompts nâng cao
                                            </button>
                                        </h2>
                                        <div id="final-system-prompts" class="accordion-collapse collapse" data-bs-parent="#finalSystemPromptAccordion">
                                            <div class="accordion-body p-3">
                                                <div class="final-prompt-grid">
                                                    <label>Vai trò AI<textarea id="final-base-prompt" class="form-control" rows="4"></textarea></label>
                                                    <label>Ngôn ngữ & giọng nói<textarea id="final-language-rule" class="form-control" rows="3"></textarea></label>
                                                    <label>Chống bịa dữ liệu<textarea id="final-data-truth-rule" class="form-control" rows="3"></textarea></label>
                                                    <label>Hỏi thông tin thiếu<textarea id="final-missing-info-rule" class="form-control" rows="3"></textarea></label>
                                                    <label>Quy tắc chốt phòng<textarea id="final-booking-rule" class="form-control" rows="3"></textarea></label>
                                                    <label>Quy tắc form<textarea id="final-form-rule" class="form-control" rows="4"></textarea></label>
                                                    <label>QR/thanh toán<textarea id="final-payment-rule" class="form-control" rows="3"></textarea></label>
                                                    <label>Ghi nhớ hội thoại<textarea id="final-memory-rule" class="form-control" rows="3"></textarea></label>
                                                    <label>Cách đọc context agent<textarea id="final-context-format-rule" class="form-control" rows="3"></textarea></label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <button class="btn btn-primary rounded-pill fw-bold mt-3" onclick="saveFinalSynthesizerConfig()"><i class="fas fa-save me-2"></i>Lưu cấu hình</button>
                            </div>

                            <div class="final-designer-card">
                                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                    <div>
                                        <h3 class="fw-800 mb-1">Booking Form Designer</h3>
                                        <p class="text-muted mb-0">Form này chỉ hiện sau khi khách đã chọn phòng và timeline.</p>
                                    </div>
                                    <div class="d-flex gap-2 flex-wrap justify-content-end">
                                        <button class="btn btn-outline-primary btn-sm rounded-pill fw-bold" onclick="openAddBookingFormFieldModal()"><i class="fas fa-plus me-1"></i>Thêm trường</button>
                                        <button class="btn btn-outline-success btn-sm rounded-pill fw-bold" onclick="saveBookingFormConfig()"><i class="fas fa-save me-1"></i>Lưu Booking Form</button>
                                        <button class="btn btn-outline-danger btn-sm rounded-pill" onclick="clearBookingFormDesigner()">Xóa form</button>
                                    </div>
                                </div>
                                <div class="designer-layout">
                                    <div class="booking-field-palette">
                                        <button draggable="true" data-booking-field="customerName">Tên khách</button>
                                        <button draggable="true" data-booking-field="customerPhone">Số điện thoại</button>
                                        <button draggable="true" data-booking-field="customerEmail">Email</button>
                                        <button draggable="true" data-booking-field="guestCount">Số khách</button>
                                        <button draggable="true" data-booking-field="idCardFront">CCCD mặt trước</button>
                                        <button draggable="true" data-booking-field="idCardBack">CCCD mặt sau</button>
                                        <button draggable="true" data-booking-field="customerNote">Ghi chú</button>
                                        <button draggable="true" data-booking-field="paymentQr">QR thanh toán</button>
                                    </div>
                                    <div id="booking-form-dropzone" class="form-dropzone">
                                        <div class="empty-state">Kéo trường vào đây để tạo booking form preview.</div>
                                    </div>
                                </div>
                            </div>

                            <div class="final-preview-card">
                                <h3 class="fw-800 mb-3">Chatbot Preview</h3>
                                <div class="chatbot-preview-window">
                                    <div class="preview-bubble ai">Xin chào, mình có thể tư vấn phòng phù hợp cho bạn. Bạn cho mình thêm vài thông tin nhé.</div>
                                    <div id="booking-chat-form-preview" class="chat-form-preview"></div>
                                </div>
                            </div>
                        </div>
                    </div>
            <div class="tab-pane fade" id="tab-test-trace"><div class="brain-manager-toolbar"><div><h3>Test public booking flow</h3><p>Test như khách thật: nhập context, nhắn câu hỏi, xem answer và UI blocks.</p></div></div><div class="compact-test-grid"><section class="compact-panel"><input id="public-ai-test-name" class="form-control mb-2" placeholder="Tên khách" /><select id="public-ai-test-branch" class="form-select mb-2"></select><select id="public-ai-test-mode" class="form-select mb-2"><option value="hourly">Theo giờ</option><option value="daily">Theo ngày</option></select><input id="public-ai-test-guests" class="form-control mb-2" type="number" min="1" value="1" /><textarea id="public-ai-test-message" class="form-control mb-2" rows="3" placeholder="VD: ngày mai còn phòng không?"></textarea><button class="btn btn-primary rounded-pill fw-bold" onclick="runPublicAIFlowTest()">Chạy test</button><pre id="public-ai-test-output" class="agent-preview mt-3"></pre></section><section class="compact-panel"><div class="brain-manager-toolbar"><div><h3>Conversation Trace</h3><p>Xem AI đã lưu gì sau mỗi phiên: persona, live snapshot, knowledge, graph reasoning, guard và final answer.</p></div><button class="btn btn-outline-primary rounded-pill fw-bold" onclick="loadBrainConversationTraces()"><i class="fas fa-rotate me-2"></i>Tải trace</button></div><div class="trace-manager-layout">
                    <div class="trace-list-panel">
                        <div id="conversation-trace-list" class="trace-list-items">
                            <div class="empty-state">Bấm “Tải trace” để xem lịch sử AIConversationTrace.</div>
                        </div>
                    </div>
                    <div class="trace-detail-panel" id="conversation-trace-detail">
                        <div class="empty-state">Chọn một trace để xem chi tiết.</div>
                    </div>
                </div></section></div></div>
        </div>
    </section>
</div>

<div class="modal fade" id="finalFormFieldModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content brain-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="final-form-field-modal-title">Thêm trường form</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label fw-bold">Tên hiển thị</label>
                <input id="final-form-field-label" class="form-control mb-3" placeholder="VD: Số điện thoại" />
                <label class="form-label fw-bold">Trường dữ liệu</label>
                <select id="final-form-field-type" class="form-select mb-3">
                    <option value="customerName">Tên khách</option>
                    <option value="customerPhone">Số điện thoại</option>
                    <option value="customerEmail">Email</option>
                    <option value="guestCount">Số khách</option>
                    <option value="idCardFront">CCCD mặt trước</option>
                    <option value="idCardBack">CCCD mặt sau</option>
                    <option value="customerNote">Ghi chú</option>
                    <option value="paymentQr">QR thanh toán</option>
                </select>
                <div class="form-check mb-4">
                    <input id="final-form-field-required" class="form-check-input" type="checkbox" checked />
                    <label class="form-check-label fw-bold" for="final-form-field-required">Bắt buộc nhập</label>
                </div>
                <div id="final-payment-qr-settings" class="border rounded-4 p-3 mb-4" style="display:none; background:#f8fafc;">
                    <div class="small text-uppercase fw-800 text-primary mb-3">Cấu hình QR chuyển khoản</div>
                    <label class="form-label fw-bold">URL ảnh QR</label>
                    <input id="final-form-field-qr-url" class="form-control mb-3" placeholder="VD: /uploads/ai-payment/qr.png hoặc https://..." />
                    <label class="form-label fw-bold">Upload ảnh QR</label>
                    <div class="input-group mb-3">
                        <input id="final-form-field-qr-file" type="file" class="form-control" accept="image/*" />
                        <button type="button" class="btn btn-outline-primary fw-bold" onclick="uploadFinalPaymentQrImage()">Upload</button>
                    </div>
                    <label class="form-label fw-bold">Nội dung gửi kèm</label>
                    <textarea id="final-form-field-payment-message" class="form-control mb-3" rows="3" placeholder="VD: Bạn vui lòng chuyển khoản {{amount}} theo mã QR bên dưới. Mã đơn: {{bookingId}}."></textarea>
                    <label class="form-label fw-bold">Thời gian đếm ngược</label>
                    <input id="final-form-field-countdown" class="form-control mb-3" type="number" min="60" max="1800" value="300" />
                    <label class="form-label fw-bold">Nhãn upload bill</label>
                    <input id="final-form-field-proof-label" class="form-control mb-3" placeholder="VD: Upload bill thanh toán" />
                    <label class="form-label fw-bold">Nút gửi bill</label>
                    <input id="final-form-field-proof-button" class="form-control mb-3" placeholder="VD: Gửi bill thanh toán" />
                    <label class="form-label fw-bold">Thông báo sau khi gửi bill</label>
                    <textarea id="final-form-field-success-message" class="form-control" rows="2" placeholder="VD: Homestay đã nhận bill, nhân viên sẽ xác nhận trong ít phút."></textarea>
                </div>
                <div class="border-top pt-3">
                    <div class="small text-uppercase fw-800 text-primary mb-3">Điều kiện hiển thị</div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-bold mb-0">Intent khách</label>
                        <button type="button" class="btn btn-sm btn-light border rounded-pill" onclick="openFinalConditionOptionManager('intent')"><i class="fas fa-gear me-1"></i>Quản lý</button>
                    </div>
                    <select id="final-form-field-intent" class="form-select mb-3"></select>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-bold mb-0">Dữ liệu đang thiếu</label>
                        <button type="button" class="btn btn-sm btn-light border rounded-pill" onclick="openFinalConditionOptionManager('missingData')"><i class="fas fa-gear me-1"></i>Quản lý</button>
                    </div>
                    <select id="final-form-field-missing" class="form-select mb-3"></select>
                    <label class="form-label fw-bold">Từ khóa kích hoạt</label>
                    <input id="final-form-field-keywords" class="form-control mb-3" placeholder="VD: đặt,chốt,book,giữ phòng" />
                    <label class="form-label fw-bold">Điều kiện nâng cao</label>
                    <textarea id="final-form-field-advanced" class="form-control" rows="3" placeholder="VD: Chỉ hỏi số điện thoại khi khách đã muốn giữ phòng hoặc đặt phòng."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" onclick="saveBookingFormFieldFromModal(true)">Lưu trường & Booking Form</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="finalConditionOptionModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content brain-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="final-condition-option-title">Quản lý option điều kiện</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="final-condition-option-kind" />
                <input type="hidden" id="final-condition-option-editing" />
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Tên hiển thị</label>
                        <input id="final-condition-option-label" class="form-control" placeholder="VD: Muốn xem ảnh phòng" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Mã value</label>
                        <input id="final-condition-option-value" class="form-control" placeholder="VD: view_photos" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-bold">Từ khóa</label>
                        <input id="final-condition-option-keywords" class="form-control" placeholder="VD: ảnh,hình,view phòng" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">Prompt rule</label>
                        <textarea id="final-condition-option-rule" class="form-control" rows="2" placeholder="Mô tả khi nào AI nên hiểu option này đúng."></textarea>
                    </div>
                </div>
                <div class="d-flex gap-2 mb-4">
                    <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" onclick="saveFinalConditionOption()">Lưu option</button>
                    <button type="button" class="btn btn-light rounded-pill px-4" onclick="resetFinalConditionOptionForm()">Làm mới</button>
                </div>
                <div id="final-condition-option-list" class="list-group"></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="brainScopeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content brain-modal">
            <div class="modal-header"><h5 class="modal-title fw-bold">Scope kiến thức</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="scope-id" />
                <label class="form-label fw-bold">Tên scope</label>
                <input id="scope-name" class="form-control mb-3" placeholder="VD: Chính sách đặt phòng" />
                <label class="form-label fw-bold">Mô tả</label>
                <textarea id="scope-description" class="form-control mb-3" rows="3"></textarea>
                <label class="form-label fw-bold">Thứ tự</label>
                <input id="scope-order" type="number" class="form-control" value="1" />
            </div>
            <div class="modal-footer"><button class="btn btn-primary rounded-pill px-4" onclick="saveBrainScope()">Lưu scope</button></div>
        </div>
    </div>
</div>

<div class="modal fade" id="brainKnowledgeModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content brain-modal">
            <div class="modal-header"><h5 class="modal-title fw-bold">Knowledge Unit</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="knowledge-id" />
                <label class="form-label fw-bold">Scope</label>
                <select id="knowledge-scope" class="form-select mb-3"></select>
                <label class="form-label fw-bold">Tiêu đề</label>
                <input id="knowledge-title" class="form-control mb-3" placeholder="VD: Quy tắc không xác nhận booking" />
                <label class="form-label fw-bold">Nội dung tri thức</label>
                <textarea id="knowledge-content" class="form-control mb-3" rows="7" placeholder="Viết chính sách, kịch bản tư vấn, hướng dẫn..."></textarea>
                <div class="row g-3">
                    <div class="col-md-8"><label class="form-label fw-bold">Tags</label><input id="knowledge-tags" class="form-control" placeholder="sales,policy,checkin" /></div>
                    <div class="col-md-4"><label class="form-label fw-bold">Priority</label><input id="knowledge-priority" type="number" class="form-control" value="10" /></div>
                </div>
            </div>
            <div class="modal-footer"><button class="btn btn-primary rounded-pill px-4" onclick="saveBrainKnowledgeUnit()">Lưu knowledge</button></div>
        </div>
    </div>
</div>

<div class="modal fade" id="brainGraphNodeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content brain-modal">
            <div class="modal-header"><h5 class="modal-title fw-bold">Graph Node</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="graph-node-id" />
                <label class="form-label fw-bold">Loại node</label>
                <input id="graph-node-type" class="form-control mb-3" placeholder="branch, room, persona, policy" />
                <label class="form-label fw-bold">Tên node</label>
                <input id="graph-node-label" class="form-control mb-3" />
                <label class="form-label fw-bold">Tóm tắt</label>
                <textarea id="graph-node-summary" class="form-control mb-3" rows="4"></textarea>
                <label class="form-label fw-bold">Metadata JSON</label>
                <textarea id="graph-node-metadata" class="form-control" rows="3">{}</textarea>
            </div>
            <div class="modal-footer"><button class="btn btn-primary rounded-pill px-4" onclick="saveBrainGraphNode()">Lưu node</button></div>
        </div>
    </div>
</div>

<div class="modal fade" id="brainGraphEdgeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content brain-modal">
            <div class="modal-header"><h5 class="modal-title fw-bold">Graph Edge</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="graph-edge-id" />
                <label class="form-label fw-bold">From node</label>
                <select id="graph-edge-from" class="form-select mb-3"></select>
                <label class="form-label fw-bold">To node</label>
                <select id="graph-edge-to" class="form-select mb-3"></select>
                <label class="form-label fw-bold">Quan hệ</label>
                <input id="graph-edge-type" class="form-control mb-3" placeholder="contains_room, best_for, requires_policy" />
                <label class="form-label fw-bold">Weight</label>
                <input id="graph-edge-weight" type="number" step="0.1" class="form-control mb-3" value="1" />
                <label class="form-label fw-bold">Evidence</label>
                <textarea id="graph-edge-evidence" class="form-control" rows="3"></textarea>
            </div>
            <div class="modal-footer"><button class="btn btn-dark rounded-pill px-4" onclick="saveBrainGraphEdge()">Lưu edge</button></div>
        </div>
    </div>
</div>


