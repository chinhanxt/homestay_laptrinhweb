@using WebHomestay.Services
@inject ISettingService SettingService
@{
    Layout = "_Layout";
    ViewData["Title"] = "Trung tâm Bộ não AI";
    var aiRetentionDays = await SettingService.GetIntAsync("BookingTrashRetentionDays", 7);
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-ai-brain-center.css" asp-append-version="true" />
    <style>
        .grounding-grid.showing-trash { display: none; }
        #brain-trash-panel { display: none; }
        #brain-trash-panel.is-open { display: block; }
        #brain-trash-toggle.is-active { background: #dc2626; color: #fff; border-color: #dc2626; }
        .trash-panel-header { padding: 20px 0 12px; }
        .trash-panel-header h4 { font-size: 1.1rem; font-weight: 700; }
        .trash-panel-header p { font-size: 0.85rem; color: #6b7280; margin: 0; }
        .trash-list { display: flex; flex-direction: column; gap: 8px; }
        .trash-item { display: flex; align-items: center; justify-content: space-between; background: #fff; border: 1px solid #f3f4f6; border-radius: 12px; padding: 14px 18px; transition: all 0.2s; }
        .trash-item:hover { border-color: #e5e7eb; box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
        .trash-item-body { flex: 1; min-width: 0; }
        .trash-item-type { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em; color: #9ca3af; font-weight: 600; margin-bottom: 2px; }
        .trash-item-title { font-weight: 600; font-size: 0.9rem; color: #111827; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .trash-item-subtitle { font-size: 0.8rem; color: #6b7280; }
        .trash-item-date { font-size: 0.75rem; color: #9ca3af; margin-top: 2px; }
        .trash-item-actions { display: flex; gap: 6px; flex-shrink: 0; margin-left: 12px; }
        .trash-item-actions .btn { font-size: 0.75rem; padding: 4px 12px; }
    </style>
}

<div class="ai-studio-page">
    <section class="workspace-card ai-tabs-shell">
        <div class="ai-tabs-nav nav nav-pills" id="admin-ai-tabs" role="tablist">
            <button class="nav-link active" id="tab-overview-trigger" data-bs-toggle="pill" data-bs-target="#tab-overview" type="button" role="tab" aria-controls="tab-overview" aria-selected="true">
                Tổng quan & Briefing
            </button>
            <button class="nav-link" id="tab-grounding-trigger" data-bs-toggle="pill" data-bs-target="#tab-grounding" type="button" role="tab" aria-controls="tab-grounding" aria-selected="false">
                Tri thức & Graph
            </button>
            <button class="nav-link" id="tab-studio-trigger" data-bs-toggle="pill" data-bs-target="#tab-studio" type="button" role="tab" aria-controls="tab-studio" aria-selected="false">
                Trả lời & Form
            </button>
        </div>

        <div class="tab-content ai-tabs-content">
            <section class="tab-pane fade show active workspace-tab" id="tab-overview" role="tabpanel" aria-labelledby="tab-overview-trigger">
                <div class="workspace-header">
                    <div>
                        <p class="ai-eyebrow">Tổng quan AI</p>
                        <h2>Trung tâm Điều khiển Bộ não AI</h2>
                        <p class="workspace-copy">
                            Giám sát tình hình vận hành thông qua trợ lý AI và đồng bộ hóa tri thức ngữ nghĩa thời gian thực.
                        </p>
                    </div>
                </div>

                <div class="overview-bento-grid">
                    <!-- Daily Briefing Card -->
                    <div class="bento-card briefing-card">
                        <div class="bento-card-header d-flex justify-content-between align-items-center gap-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fas fa-bullseye card-icon"></i>
                                <h3 class="mb-0">Bản tin Vận hành Hôm nay</h3>
                            </div>
                            <button id="refresh-operational-briefing" type="button" class="btn btn-sm btn-outline-primary rounded-pill fw-bold px-3">
                                <i class="fas fa-rotate me-1"></i>Làm mới
                            </button>
                        </div>
                        <div class="bento-card-body d-flex flex-column justify-content-between h-100">
                            <div>
                                <div id="ai-briefing-loading" class="ai-loading-placeholder" style="display: none;">
                                    <div class="spinner-border text-primary" role="status"></div>
                                    <p class="mt-2 text-muted">Trợ lý AI đang tổng hợp báo cáo vận hành...</p>
                                </div>
                                <div id="ai-briefing-content" class="ai-briefing-text">
                                    <div class="text-center py-4 px-3 border rounded-4 bg-light-subtle">
                                        <i class="fas fa-bullhorn text-primary mb-2" style="font-size: 1.5rem;"></i>
                                        <p class="mb-1 fw-bold text-dark">Bản tin chưa được tải</p>
                                        <p class="mb-0 text-muted small">Nhấn <strong>Làm mới</strong> để lấy bản tin vận hành và chỉ khi đó hệ thống mới gọi AI.</p>
                                    </div>
                                </div>
                            </div>
                            <div id="ai-quick-actions" class="mt-4 d-flex flex-column gap-2 w-100">
                                <span class="text-muted small">Chưa có hành động nào vì bản tin chưa được tải.</span>
                            </div>
                        </div>
                    </div>

                    <!-- Vector Sync Card -->
                    <div class="bento-card sync-card shadow-lg border border-primary-subtle">
                        <div class="bento-card-header d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fas fa-project-diagram card-icon text-primary animate-pulse"></i>
                                <h3 class="mb-0">Cơ sở dữ liệu Vector &amp; RAG Ngữ nghĩa</h3>
                            </div>
                            <span class="badge bg-success text-white px-2 py-1 rounded-pill small" id="rag-status-badge" style="font-size:0.75em;">
                                <span class="spinner-grow spinner-grow-sm me-1" role="status" style="width: 8px; height: 8px;"></span>Hoạt động
                            </span>
                        </div>
                        <div class="bento-card-body">
                            <p class="text-muted small mb-3">
                                Theo dõi trạng thái dữ liệu nhúng và quá trình đồng bộ tri thức. Chỉ gọi là semantic retrieval production khi hệ thống đang truy vấn vector trực tiếp trong PostgreSQL.
                            </p>

                            <!-- Vector Stats Grid -->
                            <div class="vector-stats-grid mb-3">
                                <div class="vector-stat-item">
                                    <span class="v-stat-label">Số lượng Vector:</span>
                                    <strong class="v-stat-val text-primary"><span id="vector-db-count">--</span> / <span id="vector-db-total">--</span></strong>
                                </div>
                                <div class="vector-stat-item">
                                    <span class="v-stat-label">Kích thước vector:</span>
                                    <strong class="v-stat-val">1536 chiều</strong>
                                </div>
                                <div class="vector-stat-item">
                                    <span class="v-stat-label">Chỉ mục &amp; Tìm kiếm:</span>
                                    <strong class="v-stat-val">Trạng thái runtime</strong>
                                </div>
                                <div class="vector-stat-item text-md-end">
                                    <span class="v-stat-label">Mô hình nhúng:</span>
                                    <strong class="v-stat-val text-muted" style="font-size:0.85em;">gemini-embedding-001</strong>
                                </div>
                            </div>

                            <!-- RAG Pipeline Visualization -->
                            <div class="rag-pipeline-viz my-4 p-3 rounded-4 bg-light border border-light-subtle">
                                <h4 class="rag-sub-title text-center mb-3 fw-bold" style="font-size:0.95em; color:var(--ai-ink);"><i class="fas fa-exchange-alt me-1 text-primary animate-pulse"></i>Sơ đồ Quy trình xử lý RAG</h4>
                                <div class="pipeline-flow d-flex justify-content-between align-items-center">
                                    <div class="pipeline-step text-center flex-fill" data-bs-toggle="tooltip" title="Nạp nội dung tri thức của homestay từ database.">
                                        <div class="step-icon mx-auto"><i class="fas fa-file-alt text-primary"></i></div>
                                        <div class="step-label mt-1 fw-bold">1. Dữ liệu thô</div>
                                        <div class="step-value text-muted small" style="font-size:0.75em;">DB Homestay</div>
                                    </div>
                                    <div class="pipeline-arrow px-1"><i class="fas fa-chevron-right text-muted small-arrow-animation"></i></div>
                                    <div class="pipeline-step text-center flex-fill" data-bs-toggle="tooltip" title="Tách nhỏ nội dung thành các mảnh logic độc lập để tối ưu tìm kiếm.">
                                        <div class="step-icon mx-auto"><i class="fas fa-scissors text-warning"></i></div>
                                        <div class="step-label mt-1 fw-bold">2. Phân mảnh</div>
                                        <div class="step-value text-muted small" style="font-size:0.75em;">Chunking</div>
                                    </div>
                                    <div class="pipeline-arrow px-1"><i class="fas fa-chevron-right text-muted small-arrow-animation"></i></div>
                                    <div class="pipeline-step text-center flex-fill" data-bs-toggle="tooltip" title="Dùng AI biến đổi mảnh văn bản thành chuỗi vector 1536 chiều.">
                                        <div class="step-icon mx-auto"><i class="fas fa-microchip text-success"></i></div>
                                        <div class="step-label mt-1 fw-bold">3. Nhúng Vector</div>
                                        <div class="step-value text-muted small" style="font-size:0.75em;">Embedding</div>
                                    </div>
                                    <div class="pipeline-arrow px-1"><i class="fas fa-chevron-right text-muted small-arrow-animation"></i></div>
                                    <div class="pipeline-step text-center flex-fill" data-bs-toggle="tooltip" title="Lưu vào PostgreSQL pgvector để tìm kiếm nhanh bằng khoảng cách Cosine.">
                                        <div class="step-icon mx-auto"><i class="fas fa-database text-info"></i></div>
                                        <div class="step-label mt-1 fw-bold">4. Lưu vector</div>
                                        <div class="step-value text-muted small" style="font-size:0.75em;">PostgreSQL / pgvector</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Progress Bar and Steps -->
                            <div class="vector-progress-wrapper mb-3">
                                <div class="d-flex justify-content-between mb-1 small fw-bold">
                                    <span id="sync-progress-label" class="text-muted">Đồng bộ hoàn tất</span>
                                    <span id="sync-percentage" class="text-success">100%</span>
                                </div>
                                <div class="progress mb-3" style="height: 10px; border-radius: 999px; background: rgba(0, 0, 0, 0.06); overflow: hidden;">
                                    <div id="sync-progress-bar" class="progress-bar bg-success" role="progressbar" style="width: 100%; transition: width 0.4s ease, background-color 0.4s ease;"></div>
                                </div>
                                
                                <!-- Sync steps checklist -->
                                <div id="sync-steps-checklist" class="sync-steps-checklist small d-none p-2 rounded-3 bg-light border border-light-subtle">
                                    <div class="sync-step-item d-flex align-items-center gap-2 mb-2 text-muted" id="sync-step-1">
                                        <i class="fas fa-circle-notch fa-spin step-icon-status"></i>
                                        <span class="step-text">Đọc dữ liệu tri thức &amp; thông tin phòng</span>
                                    </div>
                                    <div class="sync-step-item d-flex align-items-center gap-2 mb-2 text-muted" id="sync-step-2">
                                        <i class="far fa-circle step-icon-status"></i>
                                        <span class="step-text">Mã hóa văn bản thành Vector (Gemini)</span>
                                    </div>
                                    <div class="sync-step-item d-flex align-items-center gap-2 mb-2 text-muted" id="sync-step-3">
                                        <i class="far fa-circle step-icon-status"></i>
                                        <span class="step-text">Cập nhật cơ sở dữ liệu pgvector</span>
                                    </div>
                                    <div class="sync-step-item d-flex align-items-center gap-2 text-muted" id="sync-step-4">
                                        <i class="far fa-circle step-icon-status"></i>
                                        <span class="step-text">Xây dựng chỉ mục tìm kiếm HNSW</span>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3">
                                <button id="btn-reindex-embeddings" class="btn btn-primary rounded-pill w-100 fw-bold py-2 shadow-sm transition-all btn-sync-vector">
                                    <i class="fas fa-sync me-2"></i>Đồng bộ hóa Vector DB
                                </button>
                            </div>
                            <div id="sync-status-message" class="mt-2 small text-muted text-center fw-bold"></div>
                            
                            <!-- RAG Semantic Query Tester -->
                            <div class="rag-tester-section mt-4 pt-4 border-top">
                                <h4 class="rag-sub-title mb-2 text-dark fw-bold" style="font-size:1.05em;"><i class="fas fa-search-dollar me-2 text-success"></i>Trình thử nghiệm Truy xuất Ngữ nghĩa (RAG)</h4>
                                <p class="text-muted small mb-3">
                                    Nhập câu hỏi bất kỳ để kiểm tra xem thuật toán RAG sẽ truy xuất các điểm tri thức nào và tính toán phần trăm (%) độ trùng khớp ngữ nghĩa (Cosine Similarity).
                                </p>
                                <div class="input-group mb-3 rag-input-group shadow-sm rounded-pill overflow-hidden border">
                                    <input type="text" id="rag-test-query" class="form-control border-0 ps-3 py-2" placeholder="Ví dụ: 'giá phòng đơn', 'chính sách hủy phòng'..." style="box-shadow:none;" />
                                    <button id="btn-rag-test" class="btn btn-dark px-4 fw-bold border-0">
                                        <i class="fas fa-bolt me-1 text-warning"></i>Truy xuất (RAG)
                                    </button>
                                </div>
                                
                                <div id="rag-test-results" class="rag-results-list">
                                    <div class="empty-state py-3 text-muted text-center rounded-4 border border-dashed bg-light">
                                        <i class="fas fa-info-circle mb-2" style="font-size: 1.5rem; color: var(--ai-muted);"></i>
                                        <p class="mb-0 small">Nhập câu hỏi và nhấn nút "Truy xuất (RAG)" để kiểm tra kết quả tìm kiếm ngữ nghĩa.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Agent Health Status -->
                    <div class="bento-card agents-card shadow-lg border border-success-subtle">
                        <div class="bento-card-header d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fas fa-network-wired card-icon text-success animate-pulse"></i>
                                <h3 class="mb-0">Luồng tác nhân AI (Multi-Agent Flow)</h3>
                            </div>
                            <span class="badge bg-success text-white px-2 py-1 rounded-pill small" style="font-size:0.75em;">
                                <span class="spinner-grow spinner-grow-sm me-1" role="status" style="width: 8px; height: 8px;"></span>Đồng bộ
                            </span>
                        </div>
                        <div class="bento-card-body">
                            <p class="text-muted small mb-3">
                                Luồng xử lý tuần tự qua 5 AI Agents chuyên biệt giúp tối ưu câu trả lời dựa trên ngữ cảnh thực tế của hệ thống và các nguyên tắc an toàn.
                            </p>

                            <!-- Agent Flow Diagram -->
                            <div class="agent-flow-viz my-4 p-3 rounded-4 bg-light border border-light-subtle">
                                <h4 class="agent-sub-title text-center mb-3 fw-bold" style="font-size:0.95em; color:var(--ai-ink);"><i class="fas fa-route me-1 text-success"></i>Sơ đồ xử lý hội thoại đa tác nhân</h4>
                                <div class="agent-pipeline-flow d-flex justify-content-between align-items-center">
                                    <div class="agent-step text-center flex-fill" data-bs-toggle="tooltip" title="Phân tích thông điệp để nhận diện ý định và phân loại nhu cầu.">
                                        <div class="agent-icon mx-auto bg-white border border-primary position-relative">
                                            <i class="fas fa-brain text-primary"></i>
                                            <span class="agent-status-indicator agent-pulse-glow"></span>
                                        </div>
                                        <div class="agent-label mt-1 fw-bold">1. Ý định</div>
                                        <div class="agent-value text-primary small" style="font-size:0.75em;">Classifier</div>
                                    </div>
                                    <div class="pipeline-arrow px-1"><i class="fas fa-chevron-right text-muted small-arrow-animation"></i></div>
                                    <div class="agent-step text-center flex-fill" data-bs-toggle="tooltip" title="Truy xuất thông tin ngữ nghĩa từ cơ sở dữ liệu vector pgvector.">
                                        <div class="agent-icon mx-auto bg-white border border-warning position-relative">
                                            <i class="fas fa-search-plus text-warning"></i>
                                            <span class="agent-status-indicator agent-pulse-glow"></span>
                                        </div>
                                        <div class="agent-label mt-1 fw-bold">2. RAG</div>
                                        <div class="agent-value text-warning small" style="font-size:0.75em;">Recall</div>
                                    </div>
                                    <div class="pipeline-arrow px-1"><i class="fas fa-chevron-right text-muted small-arrow-animation"></i></div>
                                    <div class="agent-step text-center flex-fill" data-bs-toggle="tooltip" title="Truy vấn các node và liên kết quan hệ trong đồ thị tri thức.">
                                        <div class="agent-icon mx-auto bg-white border border-info position-relative">
                                            <i class="fas fa-project-diagram text-info"></i>
                                            <span class="agent-status-indicator agent-pulse-glow"></span>
                                        </div>
                                        <div class="agent-label mt-1 fw-bold">3. Đồ thị</div>
                                        <div class="agent-value text-info small" style="font-size:0.75em;">Graph</div>
                                    </div>
                                    <div class="pipeline-arrow px-1"><i class="fas fa-chevron-right text-muted small-arrow-animation"></i></div>
                                    <div class="agent-step text-center flex-fill" data-bs-toggle="tooltip" title="Kiểm tra các quy tắc an toàn, ngăn chặn ảo giác và rò rỉ dữ liệu.">
                                        <div class="agent-icon mx-auto bg-white border border-danger position-relative">
                                            <i class="fas fa-shield-alt text-danger"></i>
                                            <span class="agent-status-indicator agent-pulse-glow"></span>
                                        </div>
                                        <div class="agent-label mt-1 fw-bold">4. An toàn</div>
                                        <div class="agent-value text-danger small" style="font-size:0.75em;">Booking Guard</div>
                                    </div>
                                    <div class="pipeline-arrow px-1"><i class="fas fa-chevron-right text-muted small-arrow-animation"></i></div>
                                    <div class="agent-step text-center flex-fill" data-bs-toggle="tooltip" title="Tổng hợp tri thức và dữ liệu để tạo ra câu trả lời tự nhiên nhất.">
                                        <div class="agent-icon mx-auto bg-white border border-success position-relative">
                                            <i class="fas fa-magic text-success"></i>
                                            <span class="agent-status-indicator agent-pulse-glow"></span>
                                        </div>
                                        <div class="agent-label mt-1 fw-bold">5. Phản hồi</div>
                                        <div class="agent-value text-success small" style="font-size:0.75em;">Composer</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Agent Health list in list format for details -->
                            <div class="agent-details-grid d-grid gap-2 mt-3">
                                <div class="agent-details-item d-flex justify-content-between align-items-center p-2 rounded-3 bg-light border border-light-subtle">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-primary-subtle text-primary rounded-circle p-1" style="width:24px; height:24px; display:inline-flex; align-items:center; justify-content:center;"><i class="fas fa-brain" style="font-size:0.8em;"></i></span>
                                        <span class="small fw-bold text-dark">Tác nhân Phân loại Ý định (Intent Classifier)</span>
                                    </div>
                                    <span class="badge bg-success-glow text-success rounded-pill small" style="font-size:0.75em;">Hoạt động</span>
                                </div>
                                <div class="agent-details-item d-flex justify-content-between align-items-center p-2 rounded-3 bg-light border border-light-subtle">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-warning-subtle text-warning rounded-circle p-1" style="width:24px; height:24px; display:inline-flex; align-items:center; justify-content:center;"><i class="fas fa-search-plus" style="font-size:0.8em;"></i></span>
                                        <span class="small fw-bold text-dark">Truy xuất Vector Tri thức (Vector Recall / RAG)</span>
                                    </div>
                                    <span class="badge bg-success-glow text-success rounded-pill small" style="font-size:0.75em;">Hoạt động</span>
                                </div>
                                <div class="agent-details-item d-flex justify-content-between align-items-center p-2 rounded-3 bg-light border border-light-subtle">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-info-subtle text-info rounded-circle p-1" style="width:24px; height:24px; display:inline-flex; align-items:center; justify-content:center;"><i class="fas fa-project-diagram" style="font-size:0.8em;"></i></span>
                                        <span class="small fw-bold text-dark">Suy luận Đồ thị Tri thức (Graph Expansion)</span>
                                    </div>
                                    <span class="badge bg-success-glow text-success rounded-pill small" style="font-size:0.75em;">Đã kết nối</span>
                                </div>
                                <div class="agent-details-item d-flex justify-content-between align-items-center p-2 rounded-3 bg-light border border-light-subtle">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-danger-subtle text-danger rounded-circle p-1" style="width:24px; height:24px; display:inline-flex; align-items:center; justify-content:center;"><i class="fas fa-shield-alt" style="font-size:0.8em;"></i></span>
                                        <span class="small fw-bold text-dark">Hàng rào Bảo vệ &amp; An toàn (Booking Guard)</span>
                                    </div>
                                    <span class="badge bg-success-glow text-success rounded-pill small" style="font-size:0.75em;">Hoạt động</span>
                                </div>
                                <div class="agent-details-item d-flex justify-content-between align-items-center p-2 rounded-3 bg-light border border-light-subtle">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-success-subtle text-success rounded-circle p-1" style="width:24px; height:24px; display:inline-flex; align-items:center; justify-content:center;"><i class="fas fa-magic" style="font-size:0.8em;"></i></span>
                                        <span class="small fw-bold text-dark">Tổng hợp Phản hồi (Response Composer)</span>
                                    </div>
                                    <span class="badge bg-success-glow text-success rounded-pill small" style="font-size:0.75em;">Đang chạy</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="tab-pane fade workspace-tab" id="tab-grounding" role="tabpanel" aria-labelledby="tab-grounding-trigger">
            <div class="workspace-header">
                <div>
                    <p class="ai-eyebrow">Tri thức & Graph</p>
                    <h2>Dữ liệu AI nhìn vào để trả lời</h2>
                    <p class="workspace-copy">
                        Toàn bộ tri thức hệ thống sẽ được seed lại từ dữ liệu thật của chi nhánh và phòng. Admin vẫn có thể sửa tay sau khi seed.
                    </p>
                </div>
                <div class="workspace-actions">
                    <button id="reseed-ai-grounding" class="btn btn-danger rounded-pill fw-bold">
                        <i class="fas fa-broom-ball me-2"></i>Xóa sạch và seed lại
                    </button>
                </div>
            </div>

            <div class="grounding-summary-row">
                <div id="ai-grounding-stats" class="grounding-stats"></div>

                <section class="scope-strip-panel is-collapsed" id="scope-strip-panel">
                    <button class="scope-panel-toggle" id="toggle-scope-strip" type="button" aria-expanded="false">
                        <span>
                            <strong>Scopes đang có</strong>
                            <small>Ẩn chi tiết để tiết kiệm diện tích.</small>
                        </span>
                        <i class="fas fa-chevron-down"></i>
                    </button>
                    <div id="brain-scope-list" class="scope-strip"></div>
                </section>
            </div>

            <div class="grounding-toolbar">
                <div class="grounding-actions">
                    <button class="btn btn-outline-dark rounded-pill fw-bold" id="reload-grounding">
                        <i class="fas fa-rotate me-2"></i>Tải lại
                    </button>
                    <button class="btn btn-outline-primary rounded-pill fw-bold" id="open-scope-modal">
                        <i class="fas fa-layer-group me-2"></i>Scope
                    </button>
                    <button class="btn btn-primary rounded-pill fw-bold" id="open-knowledge-modal">
                        <i class="fas fa-plus me-2"></i>Knowledge
                    </button>
                    <button class="btn btn-success rounded-pill fw-bold" data-bs-toggle="modal" data-bs-target="#importAIKnowledgeModal">
                        <i class="fas fa-file-import me-2"></i>Import Excel/Word
                    </button>
                    <button class="btn btn-dark rounded-pill fw-bold" id="open-node-modal">
                        <i class="fas fa-circle-plus me-2"></i>Node
                    </button>
                    <button class="btn btn-outline-dark rounded-pill fw-bold" id="open-edge-modal">
                        <i class="fas fa-link me-2"></i>Edge
                    </button>
                    <button class="btn btn-outline-danger rounded-pill fw-bold" id="brain-trash-toggle">
                        <i class="fas fa-trash-alt me-2"></i>Thùng rác
                    </button>
                </div>
            </div>

            <div id="brain-trash-panel">
                <div class="trash-panel-header">
                    <h4><i class="fas fa-trash-alt me-2 text-danger"></i>Thùng rác Tri thức & Graph</h4>
                    <p>Các mục trong này sẽ tự động bị xóa vĩnh viễn sau @aiRetentionDays ngày. Có thể khôi phục hoặc xóa vĩnh viễn ngay.</p>
                </div>
                <div id="brain-trash-list" class="trash-list"></div>
            </div>

            <div class="grounding-grid" id="grounding-grid">
                <section class="grounding-panel knowledge-panel">
                    <div class="panel-heading">
                        <div>
                            <h3>Knowledge Units</h3>
                            <p>Danh sách knowledge units được chia nhỏ để AI nhìn vào và trả lời.</p>
                        </div>
                        <input id="knowledge-search" class="form-control" placeholder="Tìm knowledge..." />
                    </div>
                    <div id="brain-knowledge-list" class="entity-list"></div>
                </section>

                <section class="grounding-panel graph-panel">
                    <div class="panel-heading">
                        <div>
                            <h3>Graph Nodes & Edges</h3>
                            <p>Xem dạng danh sách thu gọn hoặc chuyển sang bản đồ node để nhìn quan hệ trực quan hơn.</p>
                        </div>
                        <div class="graph-panel-actions">
                            <input id="graph-search" class="form-control" placeholder="Tìm node hoặc edge..." />
                            <div class="graph-view-toggle">
                                <button type="button" class="chip-button is-active" data-graph-view="list">Danh sách</button>
                                <button type="button" class="chip-button" data-graph-view="map3d">3D</button>
                            </div>
                        </div>
                    </div>
                    <div class="graph-map-toolbar" id="graph-map-toolbar" hidden>
                        <button type="button" class="icon-tool-button" id="graph-zoom-out" title="Thu nhỏ"><i class="fas fa-minus"></i></button>
                        <button type="button" class="icon-tool-button" id="graph-zoom-in" title="Phóng to"><i class="fas fa-plus"></i></button>
                        <button type="button" class="icon-tool-button" id="graph-reset-view" title="Đặt lại góc nhìn"><i class="fas fa-compress-arrows-alt"></i></button>
                    </div>
                    <div id="graph-list-mode" class="graph-list-mode">
                        <div class="graph-list-section">
                            <div class="mini-heading">Nodes</div>
                            <div id="brain-graph-nodes" class="entity-list"></div>
                        </div>
                        <div class="graph-list-section">
                            <div class="mini-heading">Edges</div>
                            <div id="brain-graph-edges" class="entity-list"></div>
                        </div>
                    </div>
                    <div id="graph-map-mode" class="graph-map-mode" hidden>
                        <svg id="graph-map-canvas" viewBox="0 0 1200 760" preserveAspectRatio="xMidYMid meet"></svg>
                    </div>
                </section>
            </div>
            </section>

            <section class="tab-pane fade workspace-tab" id="tab-studio" role="tabpanel" aria-labelledby="tab-studio-trigger">
            <div class="studio-toolbar">
                <div>
                    <p class="ai-eyebrow">Trả lời & Form</p>
                    <p class="workspace-copy mb-0">
                        Cấu hình sale-assist theo flow: hồ sơ trợ lý, field cần thu thập, block giao diện, luật runtime và handoff người thật.
                    </p>
                </div>
                <div class="workspace-actions">
                    <button id="save-studio-config" class="btn btn-primary rounded-pill fw-bold">
                        <i class="fas fa-save me-2"></i>Lưu cấu hình
                    </button>
                </div>
            </div>

            <div class="studio-shell">
                <aside class="studio-nav">
                    <div class="studio-nav-head">
                        <h3>Danh mục cấu hình</h3>
                        <p>Chọn phần cần chỉnh trong studio.</p>
                    </div>
                    <div id="studio-category-nav" class="studio-category-nav"></div>
                </aside>

                <main class="studio-editor">
                    <div class="studio-editor-head">
                        <div>
                            <h3 id="studio-editor-title">Đang tải cấu hình...</h3>
                            <p id="studio-editor-copy">Studio sẽ hiển thị trình chỉnh cấu hình tương ứng với nhóm đang chọn.</p>
                        </div>
                        <div id="studio-last-updated" class="studio-updated"></div>
                    </div>
                    <div id="studio-config-editor" class="studio-config-editor"></div>
                </main>
            </div>
            </section>
        </div>
    </section>
</div>

<div class="modal fade" id="brainScopeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content ai-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Scope kiến thức</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="scope-id" />
                <label class="form-label fw-bold">Tên scope</label>
                <input id="scope-name" class="form-control mb-3" />
                <label class="form-label fw-bold">Mô tả</label>
                <textarea id="scope-description" class="form-control mb-3" rows="3"></textarea>
                <label class="form-label fw-bold">Thứ tự</label>
                <input id="scope-order" type="number" class="form-control" value="1" />
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary rounded-pill px-4" id="save-scope-btn">Lưu scope</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="brainKnowledgeModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content ai-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Knowledge Unit</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="knowledge-id" />
                <label class="form-label fw-bold">Scope</label>
                <select id="knowledge-scope" class="form-select mb-3"></select>
                <label class="form-label fw-bold">Tiêu đề</label>
                <input id="knowledge-title" class="form-control mb-3" />
                <label class="form-label fw-bold">Nội dung</label>
                <textarea id="knowledge-content" class="form-control mb-3" rows="7"></textarea>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label fw-bold">Tags</label>
                        <input id="knowledge-tags" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Priority</label>
                        <input id="knowledge-priority" type="number" class="form-control" value="10" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary rounded-pill px-4" id="save-knowledge-btn">Lưu knowledge</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="brainGraphNodeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content ai-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Graph Node</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="graph-node-id" />
                <label class="form-label fw-bold">Loại node</label>
                <input id="graph-node-type" class="form-control mb-3" />
                <label class="form-label fw-bold">Tên node</label>
                <input id="graph-node-label" class="form-control mb-3" />
                <label class="form-label fw-bold">Tóm tắt</label>
                <textarea id="graph-node-summary" class="form-control mb-3" rows="4"></textarea>
                <label class="form-label fw-bold">Metadata JSON</label>
                <textarea id="graph-node-metadata" class="form-control" rows="4">{}</textarea>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary rounded-pill px-4" id="save-node-btn">Lưu node</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="brainGraphEdgeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content ai-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Graph Edge</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="graph-edge-id" />
                <label class="form-label fw-bold">From node</label>
                <select id="graph-edge-from" class="form-select mb-3"></select>
                <label class="form-label fw-bold">To node</label>
                <select id="graph-edge-to" class="form-select mb-3"></select>
                <label class="form-label fw-bold">Quan hệ</label>
                <input id="graph-edge-type" class="form-control mb-3" />
                <label class="form-label fw-bold">Weight</label>
                <input id="graph-edge-weight" type="number" step="0.1" class="form-control mb-3" value="1" />
                <label class="form-label fw-bold">Evidence</label>
                <textarea id="graph-edge-evidence" class="form-control" rows="3"></textarea>
            </div>
            <div class="modal-footer">
                <button class="btn btn-dark rounded-pill px-4" id="save-edge-btn">Lưu edge</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: IMPORT AI KNOWLEDGE -->
<div class="modal fade" id="importAIKnowledgeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content ai-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fas fa-file-import me-2 text-primary"></i>Import Tri Thức AI</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ImportKnowledge" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <p class="text-muted small">Chọn file Excel (.xlsx) hoặc Word (.docx) để nhập hàng loạt bài học tri thức đào tạo cho AI.</p>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Chọn file (.xlsx, .docx)</label>
                        <input type="file" name="file" class="form-control" accept=".xlsx,.xls,.docx,.doc" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4" style="background: linear-gradient(135deg, #4F81BD 0%, #295B96 100%); border: none;">Bắt đầu Import</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-ai-brain-center.js" asp-append-version="true"></script>
    <script src="~/js/admin-import-preview.js" asp-append-version="true"></script>
    <script>
        $(function() {
            window.initImportPreview({
                formSelector: '#importAIKnowledgeModal form',
                previewUrl: '@Url.Action("ImportKnowledgePreview", "AdminAI")',
                confirmUrl: '@Url.Action("ImportKnowledgeConfirm", "AdminAI")',
                modalId: 'importAIKnowledgeModal'
            });
        });
    </script>
}
