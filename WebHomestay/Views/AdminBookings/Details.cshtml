@model WebHomestay.Models.Entities.Core.Booking

@{
    ViewData["Title"] = "Chi tiết Đơn hàng #" + Model.Id;
    bool canViewOriginalImages = WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "images.original");
    var maskedImageVersion = Model.CreatedAt.Ticks;
}

<link rel="stylesheet" href="~/css/admin-premium.css" asp-append-version="true" />

<div class="premium-admin-body">
    <div class="admin-shell">
        <header class="admin-hero">
            <div class="admin-hero-title">
                <span class="admin-kicker">Hồ sơ giao dịch</span>
                <h1>Chi tiết Đơn hàng #@Model.Id</h1>
            </div>
            <div class="admin-hero-actions">
                <a asp-action="Index" class="btn-premium-outline">
                    <i class="fas fa-arrow-left"></i>
                    <span>Quay lại</span>
                </a>
            </div>
        </header>

        <div class="row g-4">
            <div class="col-lg-8">
                <!-- Customer Info Card -->
                <div class="admin-card mb-4 p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold text-primary mb-0"><i class="fas fa-user-circle me-2"></i>Thông tin khách hàng</h5>
                        @{
                            var statusDisplay = Model.Status switch {
                                "AwaitingApproval" => "Cần duyệt bill",
                                "Confirmed" => "Đã xác nhận",
                                "CheckedIn" => "Check-in",
                                "CheckedOut" => "Check-out",
                                "Cancelled" => "Đã hủy",
                                "AwaitingPayment" or "PendingPayment" or "PENDING" => "Chờ thanh toán",
                                _ => Model.Status
                            };
                            var statusClass = Model.Status switch {
                                "Confirmed" => "badge-success-soft",
                                "AwaitingApproval" => "badge-warning-soft",
                                "Cancelled" => "badge-danger-soft",
                                _ => "badge-primary-soft"
                            };
                        }
                        <span class="badge-premium @statusClass">@statusDisplay</span>
                    </div>
                    
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="admin-form-label">Họ và tên</label>
                            <div class="fw-bold fs-5">@Model.CustomerName</div>
                        </div>
                        <div class="col-md-6">
                            <label class="admin-form-label">SĐT Zalo</label>
                            <div class="fw-bold fs-5 text-primary">@Model.CustomerPhone</div>
                            @if (!string.IsNullOrEmpty(Model.CustomerZalo) && Model.CustomerZalo != Model.CustomerPhone)
                            {
                                <div class="small text-muted mt-1">
                                    <i class="fab fa-whatsapp me-1"></i> Zalo phụ: @Model.CustomerZalo
                                </div>
                            }
                        </div>
                        <div class="col-md-6">
                            <label class="admin-form-label">Email</label>
                            <div class="text-muted">@(Model.CustomerEmail ?? "Không cung cấp")</div>
                        </div>
                        <div class="col-12">
                            <label class="admin-form-label">Ghi chú từ khách</label>
                            <div class="p-3 bg-light rounded italic small">
                                @(Model.CustomerNote ?? "Không có ghi chú thêm.")
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ID Cards Card -->
                <div class="admin-card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold text-primary mb-0"><i class="fas fa-id-card me-2"></i>Hồ sơ định danh (CCCD)</h5>
                        @if (!canViewOriginalImages)
                        {
                            <span class="badge bg-warning-soft text-warning small"><i class="fas fa-shield-alt me-1"></i>Bản đã che thông tin</span>
                        }
                    </div>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="admin-form-label">Mặt trước</label>
                            <div class="rounded overflow-hidden border shadow-sm bg-light d-flex align-items-center justify-content-center" style="min-height: 200px;">
                                @if (!string.IsNullOrEmpty(Model.IdCardFrontPath))
                                {
                                    if (canViewOriginalImages)
                                    {
                                        <img src="/SecureImage/GetOriginal?fileName=@Model.IdCardFrontPath" class="w-100" style="cursor: zoom-in;" onclick="window.open(this.src)" />
                                    }
                                    else
                                    {
                                        <img src="@(string.IsNullOrEmpty(Model.IdCardFrontMaskedPath) ? string.Empty : $"{Model.IdCardFrontMaskedPath}?v={maskedImageVersion}")" class="w-100" />
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Chưa tải lên</span>
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="admin-form-label">Mặt sau</label>
                            <div class="rounded overflow-hidden border shadow-sm bg-light d-flex align-items-center justify-content-center" style="min-height: 200px;">
                                @if (!string.IsNullOrEmpty(Model.IdCardBackPath))
                                {
                                    if (canViewOriginalImages)
                                    {
                                        <img src="/SecureImage/GetOriginal?fileName=@Model.IdCardBackPath" class="w-100" style="cursor: zoom-in;" onclick="window.open(this.src)" />
                                    }
                                    else
                                    {
                                        <img src="@(string.IsNullOrEmpty(Model.IdCardBackMaskedPath) ? string.Empty : $"{Model.IdCardBackMaskedPath}?v={maskedImageVersion}")" class="w-100" />
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Chưa tải lên</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <!-- Booking Summary Card -->
                <div class="admin-card p-4 sticky-top" style="top: 100px; z-index: 10;">
                    <h5 class="fw-bold text-primary mb-4"><i class="fas fa-receipt me-2"></i>Tóm tắt lưu trú</h5>
                    
                    <div class="mb-4">
                        <label class="admin-form-label">Phòng đặt</label>
                        <div class="fw-bold">@Model.Room?.Name</div>
                        <div class="small text-muted">@Model.Room?.Branch?.Name</div>
                    </div>

                    <div class="mb-4">
                        <label class="admin-form-label">Thời gian lưu trú</label>
                        @if (Model.BookingMode == WebHomestay.Models.Enums.BookingMode.Hourly)
                        {
                            <div class="fw-bold text-primary">@Model.SlotLabel</div>
                            <div class="small">(@Model.StartTime.ToString("HH:mm") - @Model.EndTime.ToString("HH:mm"))</div>
                            <div class="small text-muted">Ngày: @Model.StartTime.ToString("dd/MM/yyyy")</div>
                        }
                        else
                        {
                            <div class="fw-bold text-primary">Theo ngày (Overnight)</div>
                            <div class="small">Từ: @Model.StartTime.ToString("dd/MM/yyyy HH:mm")</div>
                            <div class="small">Đến: @Model.EndTime.ToString("dd/MM/yyyy HH:mm")</div>
                        }
                    </div>

                    <div class="mb-4">
                        <label class="admin-form-label">Số khách</label>
                        <div class="fw-bold">@Model.GuestCount người</div>
                    </div>

                    <div class="py-3 border-top border-bottom mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold">Tổng thanh toán</span>
                            <span class="fs-4 fw-bold text-primary">@Model.TotalPrice.ToString("N0")đ</span>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        @if (Model.Status == "AwaitingApproval")
                        {
                             <button type="button" class="btn-ready py-2 fw-bold rounded-pill" data-bs-toggle="modal" data-bs-target="#approveModal-@Model.Id">
                                <i class="fas fa-check-double me-2"></i>DUYỆT & GỬI VÉ
                            </button>
                        }
                        @if (ViewBag.CheckoutMode == "Manual" && (Model.Status == "Confirmed" || Model.Status == "CheckedIn"))
                        {
                            bool canCheckout = Model.EndTime <= DateTime.Now;
                            <form asp-action="Checkout" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn-ready py-2 fw-bold rounded-pill @(canCheckout ? "" : "opacity-50")"
                                        @(canCheckout ? "" : "disabled")>
                                    <i class="fas fa-check-double me-2"></i>XÁC NHẬN CHECK-OUT
                                </button>
                            </form>
                        }
                        @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "bookings.delete"))
                        {
                            bool isRestricted = Model.Status == "Confirmed" || Model.Status == "AwaitingApproval";
                            
                            if (isRestricted)
                            {
                                <button type="button" class="btn btn-link text-danger text-decoration-none small opacity-50" 
                                        onclick="premiumToast('Không thể xóa đơn hàng đang vận hành!', 'error')">Hủy đơn hàng này</button>
                            }
                            else
                            {
                                <form asp-action="SoftDelete" method="post" class="d-grid" data-premium-confirm="Bạn muốn xóa đơn hàng #@Model.Id vào thùng rác?" data-premium-title="Xóa đơn hàng" data-premium-ok="Xóa" data-premium-danger="true">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <button type="submit" class="btn btn-link text-danger text-decoration-none small">Hủy đơn hàng này</button>
                                </form>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        function showLuxToast(message, type = 'success') {
            premiumToast(message, type);
        }
    </script>
}
