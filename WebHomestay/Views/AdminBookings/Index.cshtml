@model IEnumerable<WebHomestay.Models.Booking>

@{
    ViewData["Title"] = "Quản lý Đơn đặt phòng";
}

<link rel="stylesheet" href="~/css/admin-premium.css" asp-append-version="true" />

<div class="premium-admin-body">
    <div class="admin-shell">
        <header class="admin-hero">
            <div class="admin-hero-title">
                <span class="admin-kicker">Lịch sử giao dịch</span>
                <h1>Quản lý Đơn đặt phòng</h1>
            </div>
            <div class="admin-hero-actions">
                @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "bookings.delete"))
                {
                    <a asp-action="Trash" class="btn-premium-outline">
                        <i class="fas fa-trash-alt"></i>
                        <span>Thùng rác</span>
                    </a>
                }
            </div>
        </header>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success border-0 shadow-sm mb-4 d-flex align-items-center">
                <i class="fas fa-check-circle me-3 fs-4"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
        }

        <!-- Filter Bar -->
        <div class="staff-filter-bar mb-3">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="filter-group">
                    <label class="filter-label">Trạng thái</label>
                    <select class="form-select form-select-sm booking-filter" id="filterStatus">
                        <option value="">Tất cả</option>
                        <option value="AwaitingPayment">Chờ thanh toán</option>
                        <option value="AwaitingApproval">Cần duyệt bill</option>
                        <option value="Confirmed">Đã xác nhận</option>
                        <option value="CheckedIn">Check-in</option>
                        <option value="CheckedOut">Check-out</option>
                        <option value="Cancelled">Đã hủy</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label class="filter-label">Chi nhánh</label>
                    <select class="form-select form-select-sm booking-filter" id="filterBranch">
                        <option value="">Tất cả</option>
                        @foreach (var branch in ViewBag.Branches as List<WebHomestay.Models.Branch> ?? new())
                        {
                            <option value="@branch.Id">@branch.Name</option>
                        }
                    </select>
                </div>
                <div class="filter-group">
                    <label class="filter-label">Hình thức</label>
                    <select class="form-select form-select-sm booking-filter" id="filterMode">
                        <option value="">Tất cả</option>
                        <option value="Daily">Theo ngày</option>
                        <option value="Hourly">Theo giờ</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label class="filter-label">Tìm kiếm</label>
                    <input type="text" class="form-control form-control-sm booking-filter" id="filterSearch" placeholder="Tên khách, SĐT..." style="min-width: 180px;" />
                </div>
                <button class="btn btn-sm btn-outline-secondary" id="resetFilters" title="Xoá bộ lọc">
                    <i class="fas fa-undo"></i>
                </button>
            </div>
        </div>

        <div class="admin-card">
            <div class="admin-table-responsive">
                <table class="admin-table staff-table" id="bookingsTable">
                    <thead>
                        <tr>
                            <th class="sortable" data-sort="id">Mã đơn <i class="fas fa-sort"></i></th>
                            <th class="sortable" data-sort="customer">Khách hàng <i class="fas fa-sort"></i></th>
                            <th class="sortable" data-sort="room">Phòng <i class="fas fa-sort"></i></th>
                            <th class="sortable" data-sort="time">Thời gian / Số lượng <i class="fas fa-sort"></i></th>
                            <th>Minh chứng</th>
                            <th class="sortable" data-sort="status">Trạng thái <i class="fas fa-sort"></i></th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr data-status="@item.Status" data-branch="@item.Room?.BranchId" data-mode="@item.BookingMode" data-customer="@item.CustomerName" data-phone="@item.CustomerPhone" data-price="@item.TotalPrice" data-start="@item.StartTime.ToString("yyyy-MM-ddTHH:mm:ss")" data-room="@item.Room?.Name">
                                <td>
                                    <div class="fw-bold">#@item.Id</div>
                                    <div class="small text-muted">@item.CreatedAt.AddHours(7).ToString("dd/MM HH:mm")</div>
                                </td>
                                <td>
                                    <div class="fw-bold text-primary">@item.CustomerName</div>
                                    <div class="small text-muted"><i class="fas fa-phone me-1"></i>@item.CustomerPhone</div>
                                    <div class="small text-muted"><i class="fas fa-envelope me-1"></i>@item.CustomerEmail</div>
                                </td>
                                <td>
                                    <div class="fw-bold">@item.Room?.Name</div>
                                    <div class="small text-muted">@item.Room?.Branch?.Name</div>
                                </td>
                                <td>
                                    @if (item.BookingMode == WebHomestay.Models.BookingMode.Hourly)
                                    {
                                        var label = item.RoomSlotInventory?.Template?.Name ?? item.SlotLabel;
                                        <div class="fw-bold text-info">Theo giờ @label</div>
                                        <div class="small">(@item.StartTime.ToString("HH:mm") - @item.EndTime.ToString("HH:mm"))</div>
                                    }
                                    else
                                    {
                                        var days = (item.EndTime.Date - item.StartTime.Date).Days;
                                        if (days == 0) days = 1;
                                        <div class="fw-bold text-primary">Theo ngày @days ngày</div>
                                        <div class="small">(@item.StartTime.ToString("dd/MM") - @item.EndTime.ToString("dd/MM"))</div>
                                    }
                                    <div class="fw-bold mt-1" style="color: #2e7d5a;">@item.TotalPrice.ToString("N0")đ</div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.PaymentProofUrl))
                                    {
                                        <a href="#" data-bs-toggle="modal" data-bs-target="#billModal-@item.Id">
                                            <img src="@item.PaymentProofUrl" class="admin-img-thumb" style="border-radius: 4px;" />
                                        </a>
                                        
                                        <!-- Bill Preview Modal -->
                                        <div class="modal fade" id="billModal-@item.Id" tabindex="-1">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content border-0 shadow-lg">
                                                    <div class="modal-header border-0">
                                                        <h6 class="modal-title fw-bold">Minh chứng #@item.Id</h6>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body p-0">
                                                        <img src="@item.PaymentProofUrl" class="w-100" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small italic">Chưa có bill</span>
                                    }
                                </td>
                                 <td>
                                    @if (item.Status?.Equals("AwaitingPayment", StringComparison.OrdinalIgnoreCase) == true || 
                                         item.Status?.Equals("PendingPayment", StringComparison.OrdinalIgnoreCase) == true ||
                                         item.Status?.Equals("PENDING", StringComparison.OrdinalIgnoreCase) == true)
                                    {
                                        <span class="badge-premium badge-secondary-soft">Chờ thanh toán</span>
                                    }
                                    else if (item.Status?.Equals("AwaitingApproval", StringComparison.OrdinalIgnoreCase) == true)
                                    {
                                        <span class="badge-premium badge-warning-soft">Cần duyệt bill</span>
                                    }
                                    else if (item.Status?.Equals("Confirmed", StringComparison.OrdinalIgnoreCase) == true)
                                    {
                                        <span class="badge-premium badge-success-soft">Đã xác nhận</span>
                                    }
                                    else if (item.Status?.Equals("CheckedIn", StringComparison.OrdinalIgnoreCase) == true)
                                    {
                                        <span class="badge-premium" style="background: #e0f2fe; color: #0369a1; padding: 4px 10px; border-radius: 6px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase;">Check-in</span>
                                    }
                                    else if (item.Status?.Equals("CheckedOut", StringComparison.OrdinalIgnoreCase) == true)
                                    {
                                        <span class="badge-premium" style="background: #f1f5f9; color: #475569; padding: 4px 10px; border-radius: 6px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase;">Check-out</span>
                                    }
                                    else
                                    {
                                        <span class="badge-premium badge-primary-soft">@item.Status</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="admin-actions">
                                        @if (item.Status == "AwaitingApproval")
                                        {
                                            <button type="button" class="btn btn-sm btn-ready py-1 px-3 fw-bold" style="font-size: 0.75rem; border-radius: 6px;" data-bs-toggle="modal" data-bs-target="#approveModal-@item.Id">
                                                Duyệt & Gửi vé
                                            </button>
                                        }
                                        
                                        @if (ViewBag.CheckoutMode == "Manual" && (item.Status == "Confirmed" || item.Status == "CheckedIn"))
                                        {
                                            bool canCheckout = item.EndTime <= DateTime.UtcNow;
                                            <form asp-action="Checkout" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm py-1 px-3 fw-bold @(canCheckout ? "btn-success" : "btn-light opacity-50")" 
                                                        style="font-size: 0.75rem; border-radius: 6px;"
                                                        title="@(canCheckout ? "Xác nhận hoàn thành" : "Chưa đến giờ trả phòng")"
                                                        @(canCheckout ? "" : "disabled")>
                                                    <i class="fas fa-check-double me-1"></i> Check-out
                                                </button>
                                            </form>
                                        }

                                        <a asp-action="Details" asp-route-id="@item.Id" class="admin-btn-icon" title="Chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                         @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "bookings.delete"))
                                        {
                                            var s = item.Status ?? "";
                                            bool isRestricted = s.Equals("Confirmed", StringComparison.OrdinalIgnoreCase) || 
                                                                s.Equals("AwaitingApproval", StringComparison.OrdinalIgnoreCase);
                                            
                                            if (isRestricted)
                                            {
                                                <button type="button" class="admin-btn-icon is-danger border-0 bg-transparent opacity-50" 
                                                        onclick="premiumToast('Không thể xóa đơn hàng đang vận hành!', 'error')" title="Xóa (Bị chặn)">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <form asp-action="SoftDelete" method="post" class="d-inline" data-premium-confirm="Bạn muốn xóa đơn hàng #@item.Id vào thùng rác?" data-premium-title="Xóa đơn hàng" data-premium-ok="Xóa" data-premium-danger="true">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="admin-btn-icon is-danger border-0 bg-transparent">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                        }
                                    </div>

                                    <!-- Approval Modal -->
                                    <div class="modal fade" id="approveModal-@item.Id" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered text-start">
                                            <form asp-action="Approve" method="post">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
                                                    <div class="modal-header bg-ready text-white border-0 py-3">
                                                        <h6 class="modal-title fw-bold">Duyệt & Gửi vé điện tử #@item.Id</h6>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body p-4">
                                                        <div class="mb-3">
                                                            <label class="form-label small fw-bold text-muted">Mã số cửa (Smart Lock PIN)</label>
                                                            <input type="text" name="smartLockCode" class="form-control border-light-subtle" placeholder="Ví dụ: 123456" required />
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label small fw-bold text-muted">Mật khẩu Wifi</label>
                                                            <input type="text" name="wifiPassword" class="form-control border-light-subtle" value="StayEasy@2026" required />
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label small fw-bold text-muted">Hướng dẫn nhận phòng</label>
                                                            <textarea name="instructions" class="form-control border-light-subtle" rows="3">Lấy chìa khóa trong hộp box cạnh cửa hoặc dùng mã PIN trên.</textarea>
                                                        </div>
                                                        <div class="alert alert-warning border-0 small py-2 px-3 mb-0" style="background: #fff8e1;">
                                                            <i class="fas fa-magic me-2"></i>
                                                            Email xác nhận và vé điện tử sẽ được gửi ngay lập tức.
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-0 p-4 pt-0">
                                                        <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal" style="font-size: 0.85rem;">Hủy</button>
                                                        <button type="submit" class="btn btn-ready fw-bold px-4" style="font-size: 0.85rem;">XÁC NHẬN & GỬI VÉ</button>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="text-muted opacity-50">
                                        <i class="fas fa-receipt fa-3x mb-3"></i>
                                        <p>Chưa có đơn đặt phòng nào.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@{
    var isError = TempData["ErrorMessage"] != null;
    var message = isError ? TempData["ErrorMessage"] : TempData["SuccessMessage"];
}

@if (TempData["ErrorMessage"] != null || TempData["SuccessMessage"] != null)
{
    <div class="lux-toast-container" id="toast-notif">
        <div class="lux-toast @(isError ? "is-danger" : "is-success")">
            <div class="lux-toast-accent"></div>
            <div class="lux-toast-content">
                @message
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        @if (TempData["ErrorMessage"] != null || TempData["SuccessMessage"] != null)
        {
            <text>
            setTimeout(function() {
                const toast = document.getElementById('toast-notif');
                if (toast) {
                    toast.classList.add('fade-out');
                    setTimeout(() => toast.remove(), 500);
                }
            }, 4000);
            </text>
        }

        // Filter
        function filterBookingTable() {
            var status = document.getElementById('filterStatus').value;
            var branch = document.getElementById('filterBranch').value;
            var mode = document.getElementById('filterMode').value;
            var search = document.getElementById('filterSearch').value.toLowerCase().trim();
            var rows = document.querySelectorAll('#bookingsTable tbody tr');
            rows.forEach(function(r) {
                if (r.querySelectorAll('td').length < 7) return;
                var match = true;
                if (status && r.dataset.status !== status) match = false;
                if (branch && r.dataset.branch !== branch) match = false;
                if (mode && r.dataset.mode !== mode) match = false;
                if (search) {
                    var cus = (r.dataset.customer || '').toLowerCase();
                    var phone = (r.dataset.phone || '').toLowerCase();
                    if (cus.indexOf(search) === -1 && phone.indexOf(search) === -1) match = false;
                }
                r.style.display = match ? '' : 'none';
            });
        }

        document.querySelectorAll('.booking-filter').forEach(function(el) {
            el.addEventListener('change', filterBookingTable);
            el.addEventListener('input', filterBookingTable);
        });
        document.getElementById('resetFilters').addEventListener('click', function() {
            document.getElementById('filterStatus').value = '';
            document.getElementById('filterBranch').value = '';
            document.getElementById('filterMode').value = '';
            document.getElementById('filterSearch').value = '';
            filterBookingTable();
        });

        // Sort
        var bookingsSortAsc = null, bookingsSortField = null;
        document.querySelectorAll('#bookingsTable .sortable').forEach(function(th) {
            th.addEventListener('click', function() {
                var field = this.dataset.sort;
                if (bookingsSortField === field) { bookingsSortAsc = !bookingsSortAsc; }
                else { bookingsSortField = field; bookingsSortAsc = true; }
                document.querySelectorAll('#bookingsTable .sortable i').forEach(function(i) { i.className = 'fas fa-sort'; });
                this.querySelector('i').className = bookingsSortAsc ? 'fas fa-sort-up' : 'fas fa-sort-down';
                var tbody = document.querySelector('#bookingsTable tbody');
                var rows = Array.from(tbody.querySelectorAll('tr')).filter(function(r) { return r.dataset.status !== undefined; });
                rows.sort(function(a, b) {
                    var order = bookingsSortAsc ? 1 : -1, va, vb;
                    if (field === 'id') { return ((a.dataset.start || '')).localeCompare(b.dataset.start || '') * order; }
                    if (field === 'customer') { va = (a.dataset.customer || '').toLowerCase(); vb = (b.dataset.customer || '').toLowerCase(); return va.localeCompare(vb) * order; }
                    if (field === 'room') { va = (a.dataset.room || '').toLowerCase(); vb = (b.dataset.room || '').toLowerCase(); return va.localeCompare(vb) * order; }
                    if (field === 'time') { return ((a.dataset.start || '')).localeCompare(b.dataset.start || '') * order; }
                    if (field === 'price') { va = parseFloat(a.dataset.price) || 0; vb = parseFloat(b.dataset.price) || 0; return (va - vb) * order; }
                    if (field === 'status') { va = a.dataset.status || ''; vb = b.dataset.status || ''; return va.localeCompare(vb) * order; }
                    return 0;
                });
                rows.forEach(function(r) { tbody.appendChild(r); });
            });
        });
    </script>
}
