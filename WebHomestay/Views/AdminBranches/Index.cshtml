@using System.Text.Json
@model IEnumerable<WebHomestay.Models.Branch>

@{
    ViewData["Title"] = "Quản lý Chi nhánh";
}

<link rel="stylesheet" href="~/css/admin-premium.css" asp-append-version="true" />

<div class="premium-admin-body">
    <div class="admin-shell">
        <header class="admin-hero">
            <div class="admin-hero-title">
                <span class="admin-kicker">Hệ thống vận hành</span>
                <h1>Quản lý Chi nhánh</h1>
            </div>
            <div class="admin-hero-actions">
                @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "branches.create"))
                {
                    <a asp-action="Create" class="btn-premium">
                        <i class="fas fa-plus"></i>
                        <span>Thêm chi nhánh mới</span>
                    </a>
                    <button type="button" class="btn-premium-outline" data-bs-toggle="modal" data-bs-target="#importBranchesModal">
                        <i class="fas fa-file-import"></i>
                        <span>Import Excel/ZIP</span>
                    </button>
                }
                @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "branches.trash"))
                {
                    <a asp-action="Trash" class="btn-premium-outline">
                        <i class="fas fa-trash-alt"></i>
                        <span>Thùng rác</span>
                    </a>
                }
            </div>
        </header>

        <!-- Filter Bar -->
        <div class="staff-filter-bar mb-3">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="filter-group">
                    <label class="filter-label">Chi nhánh</label>
                    <select class="form-select form-select-sm" id="filterBranch">
                        <option value="">Tất cả</option>
                        @foreach (var item in Model.OrderBy(b => b.Name))
                        {
                            <option value="@item.Name">@item.Name</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="admin-card">
            <div class="admin-table-responsive">
                <table class="admin-table staff-table" id="branchesTable">
                    <thead>
                        <tr>
                            <th class="sortable" data-sort="name">Tên chi nhánh <i class="fas fa-sort"></i></th>
                            <th class="sortable" data-sort="address">Địa chỉ <i class="fas fa-sort"></i></th>
                            <th class="sortable" data-sort="hotline">SĐT Zalo <i class="fas fa-sort"></i></th>
                            <th>Email</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr data-name="@item.Name" data-address="@item.Address" data-hotline="@item.Hotline">
                                <td>
                                    <div class="fw-bold text-primary">@item.Name</div>
                                    <div class="small text-muted">ID: #@item.Id</div>
                                </td>
                                <td>
                                    <div class="small"><i class="fas fa-map-marker-alt me-2 text-muted"></i>@item.Address</div>
                                </td>
                                <td>
                                    <div class="small"><i class="fas fa-comment-dots me-2 text-muted"></i>@item.Hotline</div>
                                </td>
                                <td>
                                    <div class="small"><i class="fas fa-envelope me-2 text-muted"></i>@(string.IsNullOrWhiteSpace(item.Email) ? "Chưa cấu hình" : item.Email)</div>
                                </td>
                                <td class="text-end">
                                     <div class="admin-actions">
                                        @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "branches.edit"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="admin-btn-icon" title="Chỉnh sửa">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        }
                                        <a asp-action="Details" asp-route-id="@item.Id" class="admin-btn-icon" title="Chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (WebHomestay.Helpers.PermissionHelper.HasPermission(Context, "branches.delete"))
                                        {
                                            <form asp-action="SoftDelete" asp-route-id="@item.Id" method="post" class="d-inline" data-premium-confirm="Chuyển chi nhánh này vào thùng rác?" data-premium-title="Xóa chi nhánh" data-premium-ok="Xóa" data-premium-danger="true">
                                                <button type="submit" class="admin-btn-icon is-danger border-0 bg-transparent" title="Xóa">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        }
                                     </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fas fa-building fa-3x mb-3 opacity-20"></i>
                                        <p>Chưa có chi nhánh nào trong hệ thống.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal: IMPORT CHI NHÁNH -->
<div class="modal fade" id="importBranchesModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content premium-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold"><i class="fas fa-file-import me-2 text-primary"></i>Import Chi Nhánh</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ImportZip" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <p class="text-muted small">Chọn file Excel (.xlsx) hoặc file nén ZIP chứa file excel để nhập hàng loạt thông tin chi nhánh.</p>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Chọn file (.xlsx hoặc .zip)</label>
                        <input type="file" name="file" class="form-control premium-input" accept=".xlsx,.zip" required />
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4" style="background: linear-gradient(135deg, #4F81BD 0%, #295B96 100%); border: none;">Bắt đầu Import</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Sort columns
        var branchesSortAsc = null, branchesSortField = null;
        document.querySelectorAll('#branchesTable .sortable').forEach(function(th) {
            th.addEventListener('click', function() {
                var field = this.dataset.sort;
                if (branchesSortField === field) { branchesSortAsc = !branchesSortAsc; }
                else { branchesSortField = field; branchesSortAsc = true; }
                document.querySelectorAll('#branchesTable .sortable i').forEach(function(i) { i.className = 'fas fa-sort'; });
                this.querySelector('i').className = branchesSortAsc ? 'fas fa-sort-up' : 'fas fa-sort-down';
                var tbody = document.querySelector('#branchesTable tbody');
                var rows = Array.from(tbody.querySelectorAll('tr')).filter(function(r) { return r.dataset.name !== undefined; });
                rows.sort(function(a, b) {
                    var order = branchesSortAsc ? 1 : -1, va, vb;
                    if (field === 'name') { va = (a.dataset.name || '').toLowerCase(); vb = (b.dataset.name || '').toLowerCase(); return va.localeCompare(vb) * order; }
                    if (field === 'address') { va = (a.dataset.address || '').toLowerCase(); vb = (b.dataset.address || '').toLowerCase(); return va.localeCompare(vb) * order; }
                    if (field === 'hotline') { va = a.dataset.hotline || ''; vb = b.dataset.hotline || ''; return va.localeCompare(vb) * order; }
                    return 0;
                });
                rows.forEach(function(r) { tbody.appendChild(r); });
            });
        });

        // Branch filter
        document.getElementById('filterBranch').addEventListener('change', function() {
            var selected = this.value;
            var rows = document.querySelectorAll('#branchesTable tbody tr');
            rows.forEach(function(r) {
                if (r.querySelectorAll('td').length < 5) return;
                r.style.display = (selected && r.dataset.name !== selected) ? 'none' : '';
            });
        });
    </script>
    <script>
        // Tự động hiển thị TempData message nếu có
        @if (TempData["SuccessMessage"] != null)
        {
            <text>premiumToast(@Html.Raw(JsonSerializer.Serialize(TempData["SuccessMessage"])), 'success');</text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>premiumToast(@Html.Raw(JsonSerializer.Serialize(TempData["ErrorMessage"])), 'error');</text>
        }
    </script>
}
