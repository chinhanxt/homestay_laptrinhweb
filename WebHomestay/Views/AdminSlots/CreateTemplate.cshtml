@model WebHomestay.Models.RoomSlotTemplate

@{
    ViewData["Title"] = "Thêm Mẫu khung giờ";
}

<link rel="stylesheet" href="~/css/admin-premium.css" asp-append-version="true" />

<div class="premium-admin-body">
    <div class="admin-shell">
        <header class="admin-hero">
            <div class="admin-hero-title">
                <span class="admin-kicker">Cấu hình thời gian</span>
                <h1>Thiết lập Mẫu khung giờ</h1>
            </div>
            <div class="admin-hero-actions">
                <a asp-action="Index" class="btn-premium-outline">
                    <i class="fas fa-arrow-left"></i>
                    <span>Quay lại</span>
                </a>
            </div>
        </header>

        <div class="admin-form-card" style="max-width: 600px;">
            <form asp-action="CreateTemplate" method="post">
                <div class="admin-form-group">
                    <label asp-for="Name" class="admin-form-label">Tên hiển thị (VD: Combo 4h Trưa)</label>
                    <input asp-for="Name" class="admin-form-input" placeholder="Nhập tên mẫu..." required />
                </div>

                <div class="admin-form-group">
                    <label asp-for="Code" class="admin-form-label">Mã định danh (Duy nhất)</label>
                    <input asp-for="Code" class="admin-form-input" placeholder="VD: 4H_NOON" required />
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="admin-form-group">
                            <label asp-for="DurationMinutes" class="admin-form-label">Thời lượng (phút)</label>
                            <input asp-for="DurationMinutes" type="number" class="admin-form-input" value="120" required />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="admin-form-group">
                            <label asp-for="CleanupMinutes" class="admin-form-label">Dọn dẹp (phút)</label>
                            <input asp-for="CleanupMinutes" type="number" class="admin-form-input" value="30" required />
                        </div>
                    </div>
                </div>

                <div class="admin-form-group">
                    <label class="admin-form-label">Thời điểm bắt đầu nhảy slot</label>
                    <input name="SeedStartTime" type="time" class="admin-form-input" value="09:00" />
                </div>

                <div class="admin-form-group mb-4">
                    <div class="form-check custom-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                        <label asp-for="IsActive" class="form-check-label fw-bold small text-primary">Kích hoạt mẫu này để sử dụng</label>
                    </div>
                </div>

                <div class="mt-5 d-grid">
                    <button type="submit" class="btn-premium py-2 justify-content-center">
                        <i class="fas fa-save"></i>
                        <span>LƯU MẪU CẤU HÌNH</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
