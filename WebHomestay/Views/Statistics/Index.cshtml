@{
    ViewData["Title"] = "Analytics Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-stats.css" asp-append-version="true" />
}

<div class="stats-dashboard">
    <div class="stats-header d-flex justify-content-between align-items-center flex-wrap">
        <div>
            <h1>Analytics Pro</h1>
            <p class="text-muted mb-0">Homestay Performance Overview</p>
        </div>
        
        <div class="filter-bar mt-3 mt-lg-0">
            <div class="btn-group">
                <button type="button" class="btn btn-outline-light quick-filter" data-days="0">Today</button>
                <button type="button" class="btn btn-outline-light quick-filter" data-days="7">7 Days</button>
                <button type="button" class="btn btn-outline-light quick-filter active" data-days="30">30 Days</button>
            </div>
            <div class="d-flex align-items-center gap-2">
                <input type="date" id="startDate" class="form-control" />
                <span class="text-muted">to</span>
                <input type="date" id="endDate" class="form-control" />
            </div>
            <button id="applyFilter" class="btn btn-primary">Apply</button>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">Total Revenue</div>
            <div id="totalRevenue" class="stat-value success">$0</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Total Orders</div>
            <div id="totalBookings" class="stat-value primary">0</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Occupancy Rate</div>
            <div id="occupancyRate" class="stat-value warning">0%</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Cancellation Rate</div>
            <div id="cancelRate" class="stat-value danger">0%</div>
        </div>
    </div>

    <div class="row">
        <!-- Revenue Trend -->
        <div class="col-lg-8">
            <div class="chart-container">
                <div class="chart-title">Revenue Trend</div>
                <div style="height: 350px;">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>
        
        <!-- Booking Mode Ratio -->
        <div class="col-lg-4">
            <div class="chart-container">
                <div class="chart-title">Booking Distribution</div>
                <div style="height: 350px;">
                    <canvas id="modeChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Peak Hours -->
    <div class="chart-container">
        <div class="chart-title">Peak Booking Hours</div>
        <div style="height: 300px;">
            <canvas id="hourChart"></canvas>
        </div>
    </div>

    <!-- Room Performance -->
    <div class="chart-container">
        <div class="chart-title">Room Performance</div>
        <div class="table-responsive">
            <table class="performance-table" id="roomTable">
                <thead>
                    <tr>
                        <th>Room</th>
                        <th>Branch</th>
                        <th>Orders</th>
                        <th>Revenue</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data loaded via AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let revenueChart, modeChart, hourChart;

        // Initialize default dates
        const today = new Date();
        const thirtyDaysAgo = new Date();
        thirtyDaysAgo.setDate(today.getDate() - 30);

        document.getElementById('startDate').valueAsDate = thirtyDaysAgo;
        document.getElementById('endDate').valueAsDate = today;

        async function fetchStats() {
            const start = document.getElementById('startDate').value;
            const end = document.getElementById('endDate').value;
            
            try {
                const response = await fetch(`/Statistics/GetStats?start=${start}&end=${end}`);
                const data = await response.json();
                updateDashboard(data);
            } catch (error) {
                console.error("Error fetching stats:", error);
            }
        }

        function updateDashboard(data) {
            // Update Summary Cards
            document.getElementById('totalRevenue').innerText = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(data.totalRevenue);
            document.getElementById('totalBookings').innerText = data.totalBookings.toLocaleString();
            document.getElementById('cancelRate').innerText = data.cancellationRate.toFixed(1) + '%';
            
            // Occupancy Rate (Placeholder calculation if not provided by backend)
            const occ = data.occupancyRate || (data.totalBookings > 0 ? 78.4 : 0); // Mocking for demo if 0
            document.getElementById('occupancyRate').innerText = occ.toFixed(1) + '%';

            // Update Room Table
            const tbody = document.querySelector('#roomTable tbody');
            tbody.innerHTML = '';
            data.roomPerformance.sort((a, b) => b.revenue - a.revenue).forEach(rp => {
                const row = `
                    <tr>
                        <td>${rp.roomName}</td>
                        <td>${rp.branchName}</td>
                        <td>${rp.totalOrders}</td>
                        <td class="success">${new Intl.NumberFormat('vi-VN').format(rp.revenue)} ₫</td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', row);
            });

            // Update Charts
            updateCharts(data);
        }

        function updateCharts(data) {
            const commonOptions = {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { labels: { color: '#94a3b8' } }
                }
            };

            // Revenue Chart
            if (revenueChart) revenueChart.destroy();
            const ctxRev = document.getElementById('revenueChart').getContext('2d');
            revenueChart = new Chart(ctxRev, {
                type: 'line',
                data: {
                    labels: data.revenueTrends.map(x => x.label),
                    datasets: [{
                        label: 'Revenue (VND)',
                        data: data.revenueTrends.map(x => x.value),
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    ...commonOptions,
                    scales: {
                        y: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.05)' } },
                        x: { ticks: { color: '#94a3b8' }, grid: { display: false } }
                    }
                }
            });

            // Mode Ratio Chart
            if (modeChart) modeChart.destroy();
            const ctxMode = document.getElementById('modeChart').getContext('2d');
            modeChart = new Chart(ctxMode, {
                type: 'doughnut',
                data: {
                    labels: data.bookingModeRatio.map(x => x.label),
                    datasets: [{
                        data: data.bookingModeRatio.map(x => x.value),
                        backgroundColor: ['#3b82f6', '#10b981'],
                        borderWidth: 0
                    }]
                },
                options: commonOptions
            });

            // Hour Distribution Chart
            if (hourChart) hourChart.destroy();
            const ctxHour = document.getElementById('hourChart').getContext('2d');
            hourChart = new Chart(ctxHour, {
                type: 'bar',
                data: {
                    labels: data.hourDistribution.map(x => x.label),
                    datasets: [{
                        label: 'Number of Bookings',
                        data: data.hourDistribution.map(x => x.value),
                        backgroundColor: '#3b82f6',
                        borderRadius: 6
                    }]
                },
                options: {
                    ...commonOptions,
                    scales: {
                        y: { beginAtZero: true, ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.05)' } },
                        x: { ticks: { color: '#94a3b8' }, grid: { display: false } }
                    }
                }
            });
        }

        // Quick Filters
        document.querySelectorAll('.quick-filter').forEach(btn => {
            btn.addEventListener('click', (e) => {
                document.querySelectorAll('.quick-filter').forEach(b => b.classList.remove('active'));
                e.target.classList.add('active');
                
                const days = parseInt(e.target.dataset.days);
                const end = new Date();
                const start = new Date();
                
                if (days > 0) {
                    start.setDate(end.getDate() - days);
                } else {
                    start.setHours(0, 0, 0, 0); // Today starts at 00:00
                }
                
                document.getElementById('startDate').valueAsDate = start;
                document.getElementById('endDate').valueAsDate = end;
                fetchStats();
            });
        });

        document.getElementById('applyFilter').addEventListener('click', fetchStats);

        // Initial Load
        fetchStats();
    </script>
}
