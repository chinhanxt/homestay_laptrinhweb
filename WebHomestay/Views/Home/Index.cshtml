@model IEnumerable<WebHomestay.Models.Room>
@{
    ViewData["Title"] = "StayLuxe - Danh sách phòng nghỉ";
    var branches = ViewBag.Branches as List<WebHomestay.Models.Branch>;
}

<!-- Compact Header - Search Only -->
<section class="py-2" style="padding-top: 85px !important;">
    <div class="container">
        <div class="row justify-content-center">
            
            <div class="col-lg-12">
                <form method="get" action="/Home/Search" class="editorial-search reveal-up mb-3">
                    <input type="hidden" name="branchId" id="searchBranchId" value="" />
                    <div class="search-field">
                        <label class="search-label">Nhận phòng</label>
                        <input type="date" class="search-input" name="checkIn" id="searchCheckIn" required>
                    </div>
                    <div class="search-field">
                        <label class="search-label">Trả phòng</label>
                        <input type="date" class="search-input" name="checkOut" id="searchCheckOut" required>
                    </div>
                    <div class="search-field">
                        <label class="search-label">Số khách</label>
                        <select class="search-input" name="guests">
                            @for (int g = 1; g <= 10; g++)
                            {
                                <option value="@g">@g Khách</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn-search-luxury">
                        TÌM PHÒNG
                    </button>
                </form>

                <div class="editorial-search reveal-up" style="grid-template-columns: 1fr;">
                    <div class="search-field">
                        <label class="search-label">Lọc nhanh theo chi nhánh</label>
                        <select class="search-input" id="branchQuickFilter">
                            <option value="">Tất cả địa điểm</option>
                            @if (branches != null)
                            {
                                foreach (var branch in branches)
                                {
                                    <option value="@branch.Id">@branch.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        var checkIn = document.getElementById('searchCheckIn');
        var checkOut = document.getElementById('searchCheckOut');
        var today = new Date().toISOString().split('T')[0];
        checkIn.setAttribute('min', today);
        checkOut.setAttribute('min', today);
        checkIn.addEventListener('change', function() {
            var d = new Date(this.value);
            d.setDate(d.getDate() + 1);
            checkOut.value = d.toISOString().split('T')[0];
            checkOut.setAttribute('min', checkOut.value);
        });

        var branchQuickFilter = document.getElementById('branchQuickFilter');
        var searchBranchId = document.getElementById('searchBranchId');
        var branchGroups = document.querySelectorAll('.branch-room-group');

        function applyBranchFilter() {
            var selectedBranchId = branchQuickFilter ? branchQuickFilter.value : '';
            if (searchBranchId) searchBranchId.value = selectedBranchId;

            branchGroups.forEach(function(group) {
                var isMatch = !selectedBranchId || group.getAttribute('data-branch-id') === selectedBranchId;
                group.style.display = isMatch ? '' : 'none';
            });
        }

        if (branchQuickFilter) {
            branchQuickFilter.addEventListener('change', applyBranchFilter);
            applyBranchFilter();
        }
    </script>
}

<!-- Collection of Rooms -->
<section class="py-2 bg-white">
    <div class="container">
        @if (Model != null && Model.Any())
        {
            @foreach (var branchGroup in Model.GroupBy(r => r.Branch?.Name ?? "Chi nhánh khác").OrderBy(g => g.Key))
            {
                <div class="mb-5 branch-room-group" data-branch-id="@branchGroup.FirstOrDefault()?.BranchId">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div>
                            <span class="text-uppercase small fw-bold" style="letter-spacing: .18em; color: var(--luxury-accent);">Bộ sưu tập phòng</span>
                            <h2 class="h3 mt-2 mb-0">@branchGroup.Key</h2>
                        </div>
                        <span class="text-muted">@branchGroup.Count() phòng</span>
                    </div>

                    <div class="row g-4">
                        @foreach (var room in branchGroup.OrderBy(r => r.Name))
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="luxury-card">
                                    <div class="luxury-card-img-wrapper">
                                        <span class="luxury-badge">@room.Branch?.Name</span>
                                        <img src="@(string.IsNullOrEmpty(room.ImageUrl) ? "https://images.unsplash.com/photo-1590490359683-658d3d23f972?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" : room.ImageUrl)"
                                             class="luxury-card-img" alt="@room.Name">
                                    </div>
                                    <div class="p-4">
                                        <h3 class="h5 mb-2">@room.Name</h3>
                                        <div class="d-flex gap-3 mb-3">
                                            @foreach (var amenity in room.Amenities.Take(3))
                                            {
                                                <span class="small text-muted"><i class="fas @amenity.IconClass me-1" style="color: var(--luxury-accent);"></i> @amenity.Name</span>
                                            }
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                            <div class="luxury-price">
                                                @room.PricePerDay.ToString("N0")<span class="fs-6 fw-normal">đ/ngày</span>
                                            </div>
                                            <a asp-controller="Rooms" asp-action="Details" asp-route-id="@room.Id"
                                               class="btn-auth-outline px-4">CHI TIẾT</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <p class="text-muted italic">Hiện tại chưa có phòng nào được đăng tải.</p>
            </div>
        }
    </div>
</section>
