## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## This .gitignore file is based on the Microsoft standard .gitignore
## for Visual Studio (https://github.com/github/gitignore/blob/main/VisualStudio.gitignore)

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
Log/
logs/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/

# Others
*.tmp
*.log
.DS_Store
node_modules/
dist/
build/

# Local AI provider secrets
key.md

# Agent workspace files
.claude/
.superpowers/
.kiro/

# Local helper apps and scratch outputs
artifacts/
CleanupApp/bin/
CleanupApp/obj/
TestGemini/bin/
TestGemini/obj/

# One-off local scratch files
admin_ai_diff.patch
clean_ui.py
patch_js.js
patch_mock_preview.js
patch_preview.js
patch_site_js.js
restore_auth.py
temp_fix.js
test-api.cs
test-chat.cs
